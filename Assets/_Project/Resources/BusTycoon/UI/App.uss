/*
 * Otobüs İmparatoru — yeni arayüz (UI Toolkit) stilleri. Birimler tasarım birimidir (IMGUI'nin "u"su; masaüstünde
 * ekran yüksekliği 1000 birim). Açık renkli kartlar sade, açık renkli haritayla uyumludur (Mini Motorways dili).
 * Renkler:
 *   mürekkep #1F2430 · soluk #6B7280 · çizgi #E6E8EC · zemin #FFFFFF · ikincil zemin #F4F5F7
 *   turuncu (marka) #FF8A00 · yeşil (para) #12A150 · kırmızı #E5484D · mavi #2F80ED · altın #F5B000
 * Yazı tipi Inter; kalınlık C#'tan verilir (UiText: Regular/Bold/Black).
 */

.bt-root {
    color: #1F2430;
    font-size: 14px;
    /* Varsayılan temanın yazı renkleri (etiket, düğme) koyu mürekkep olsun */
    --unity-colors-default-text: #1F2430;
    --unity-colors-label-text: #1F2430;
    --unity-colors-button-text: #1F2430;
}

/* ------------------------------------------------------------------ genel parçalar */

.bt-card {
    background-color: rgba(255, 255, 255, 0.97);
    border-width: 1px;
    border-color: rgba(31, 36, 48, 0.09);
    border-radius: 14px;
}

.bt-caps {
    font-size: 10.5px;
    color: #6B7280;
    letter-spacing: 0.6px;
}

.bt-dim {
    color: #6B7280;
}

.bt-row {
    flex-direction: row;
    align-items: center;
}

.bt-col {
    flex-direction: column;
}

.bt-grow {
    flex-grow: 1;
}

.bt-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-bar {
    height: 5px;
    border-radius: 3px;
    background-color: #ECEEF2;
    overflow: hidden;
    margin-top: 4px;
}

.bt-bar__fill {
    height: 100%;
    background-color: #FF8A00;
    border-radius: 3px;
    transform-origin: left;
}

.bt-badge {
    position: absolute;
    top: 2px;
    right: 14px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 9px;
    background-color: #E5484D;
    color: #FFFFFF;
    font-size: 10.5px;
    -unity-text-align: middle-center;
}

/* ------------------------------------------------------------------ üst çubuk */

.bt-topbar {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.97);
    border-bottom-width: 1px;
    border-color: #E6E8EC;
    padding-left: 18px;
    padding-right: 14px;
}

.bt-topbar__block {
    flex-direction: column;
    justify-content: center;
    margin-right: 22px;
}

.bt-company {
    font-size: 16px;
    color: #1F2430;
}

.bt-cash {
    font-size: 26px;
    color: #12A150;
}

.bt-cash.is-negative {
    color: #E5484D;
}

.bt-net {
    font-size: 12px;
    margin-left: 8px;
    margin-top: 8px;
}

.bt-net.is-up {
    color: #12A150;
}

.bt-net.is-down {
    color: #E5484D;
}

.bt-date {
    font-size: 15px;
    margin-left: 6px;
}

.bt-speed {
    flex-direction: row;
    background-color: #F1F2F5;
    border-radius: 10px;
    padding: 3px;
    margin-left: 14px;
}

.bt-speed__button {
    min-width: 40px;
    height: 30px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: #4B5262;
    font-size: 13px;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.bt-speed__button:hover {
    background-color: #E4E6EB;
}

.bt-speed__button.is-active {
    background-color: #FF8A00;
    color: #FFFFFF;
}

.bt-race {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
    padding: 4px 12px;
    border-radius: 10px;
    background-color: #FFF1DF;
    color: #B45F00;
}

.bt-stat {
    flex-direction: column;
    margin-left: 22px;
}

.bt-stat__value {
    font-size: 17px;
    color: #1F2430;
}

.bt-stat__extra {
    font-size: 12px;
    margin-left: 6px;
    margin-top: 4px;
    color: #6B7280;
}

.bt-stat__extra.is-warning {
    color: #D97706;
}

.bt-daybar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: #FF8A00;
    transform-origin: left;
    opacity: 0.85;
}

.bt-menu-button {
    width: 44px;
    height: 44px;
    margin: 0 0 0 10px;
    padding: 0;
    border-width: 0;
    border-radius: 12px;
    background-color: #F1F2F5;
    align-items: center;
    justify-content: center;
}

/* Sade üst çubuk (telefon, dar ekran): etiketler yok */
.compact-top .bt-caps {
    display: none;
}

.compact-top .bt-cash {
    font-size: 21px;
}

.compact-top .bt-topbar__block {
    margin-right: 12px;
}

/* ------------------------------------------------------------------ menü (masaüstünde solda, telefonda altta) */

.bt-rail {
    position: absolute;
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.97);
    border-right-width: 1px;
    border-color: #E6E8EC;
    padding: 10px 6px;
}

.bt-tabs {
    position: absolute;
    flex-direction: row;
    background-color: rgba(255, 255, 255, 0.98);
    border-top-width: 1px;
    border-color: #E6E8EC;
    padding: 4px 6px 0 6px;
}

.bt-nav {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 0 4px 0;
    padding: 4px 0 6px 0;
    border-width: 0;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    color: #4B5262;
    font-size: 11.5px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.bt-tabs .bt-nav {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
}

.bt-nav:hover {
    background-color: #F1F2F5;
}

.bt-nav.is-active {
    background-color: #FFF1DF;
    color: #C26400;
}

.bt-nav__icon {
    width: 26px;
    height: 26px;
    margin-bottom: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-nav__label {
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.bt-rail__spacer {
    flex-grow: 1;
}

/* ------------------------------------------------------------------ bildirimler */

.bt-toasts {
    position: absolute;
    flex-direction: column;
    align-items: center;
}

.bt-toast {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    max-width: 620px;
    margin-bottom: 8px;
    padding: 6px 18px 6px 14px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.98);
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(31, 36, 48, 0.1);
    border-left-color: #2F80ED;
}

.bt-toast__icon {
    width: 20px;
    height: 20px;
    margin-right: 10px;
}

.bt-toast__text {
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
}

.bt-toast.is-success {
    border-left-color: #12A150;
}

.bt-toast.is-error {
    border-left-color: #E5484D;
}

.bt-toast.is-warning {
    border-left-color: #F59E0B;
}

.bt-toast.is-gold {
    border-left-color: #F5B000;
}

.phone .bt-toast {
    min-height: 34px;
    max-width: 460px;
    margin-bottom: 6px;
}

.phone .bt-toast__text {
    font-size: 13px;
}
