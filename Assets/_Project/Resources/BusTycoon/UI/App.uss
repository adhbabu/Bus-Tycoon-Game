/*
 * Otobüs İmparatoru — arayüz (UI Toolkit) stilleri. Birimler tasarım birimidir (masaüstünde ekran yüksekliği 1000 birim;
 * telefonda 1 birim ≈ 0,78 pt). Koyu tema (Figma "Tema" değişkenleriyle aynı):
 *   zemin #0E1A21 · çubuk #0A151B · kart #1C363E→#132A31 · kenar #2A4A52 · düğme #16262D / #1E3640 · seçili #1A2B32
 *   yazı #F1F4F5 · soluk #8DA1A8 · altın #F5C451→#E5A23A (üstünde koyu yazı #1C1708)
 *   yeşil #3DDC84 · kırmızı #FF6464 · mavi #5AA9FF
 * Yazı tipi Inter; kalınlık C#'tan verilir (UiWeight: Regular=Medium, Bold, Black=ExtraBold). İkonlar Material
 * Symbols (beyaz; renk -unity-background-image-tint-color ile).
 */

.bt-root {
    color: #F1F4F5;
    font-size: 14px;
    /* Varsayılan temanın yazı renkleri (etiket, düğme) koyu mürekkep olsun */
    --unity-colors-default-text: #F1F4F5;
    --unity-colors-label-text: #F1F4F5;
    --unity-colors-button-text: #F1F4F5;
}

/* ------------------------------------------------------------------ sıfırlama
 * Varsayılan tema her yazıya kenar boşluğu ve iç boşluk verir (.unity-label); tasarım ölçüleri bunlarsız hesaplı.
 * Aynı belirginlikte olduğundan aşağıdaki sınıflar (margin-top vb.) bunu ezer. İçerik kutusu olan düğmelerde
 * (yazısız Button) yazılar sola dayanır: düğmenin ortalaması alt yazılara geçmesin. */

.bt-text {
    margin: 0;
    padding: 0;
}

.bt-box {
    -unity-text-align: middle-left;
}

/* ------------------------------------------------------------------ genel parçalar */

.bt-card {
    background-image: resource("BusTycoon/UI/Gradients/card");
    border-width: 1px;
    border-color: rgba(42, 74, 82, 0.75);
    border-radius: 18px;
}

.bt-caps {
    font-size: 10.5px;
    color: #8DA1A8;
    letter-spacing: 0.6px;
}

.bt-dim {
    color: #8DA1A8;
}

.bt-row {
    flex-direction: row;
    align-items: center;
}

.bt-col {
    flex-direction: column;
}

.bt-grow {
    flex-grow: 1;
}

.bt-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-bar {
    height: 5px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    margin-top: 4px;
}

.bt-bar__fill {
    height: 100%;
    background-color: #F5C451;
    border-radius: 3px;
    transform-origin: left;
}

.bt-badge {
    position: absolute;
    top: 2px;
    right: 14px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 9px;
    background-color: #FF6464;
    color: #FFFFFF;
    font-size: 10.5px;
    -unity-text-align: middle-center;
}

/* ------------------------------------------------------------------ ikonlar (Material Symbols, beyaz; renk tint ile) */

.bt-sym {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #F1F4F5;
}

.is-gold.bt-sym, .bt-sym.is-gold {
    -unity-background-image-tint-color: #F5C451;
}

.is-green {
    color: #3DDC84;
}

/* ------------------------------------------------------------------ üst çubuk */

.bt-topbar {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: #0E1A21;
    border-bottom-width: 1px;
    border-color: rgba(42, 74, 82, 0.45);
}

.bt-brand {
    flex-direction: column;
    justify-content: center;
    flex-shrink: 1;
    overflow: hidden;
}

.bt-brand__kicker {
    font-size: 11px;
    letter-spacing: 1.8px;
    color: #3DDC84;
    white-space: nowrap;
}

.bt-brand__title {
    font-size: 20px;
    color: #F1F4F5;
    white-space: nowrap;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

.bt-brand__sub {
    margin-top: 2px;
}

.bt-brand__dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: #3DDC84;
    margin-right: 6px;
}

.bt-brand__subtext {
    font-size: 12px;
    color: #3DDC84;
    white-space: nowrap;
}

.bt-kasa {
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.bt-kasa__caps {
    font-size: 11px;
    letter-spacing: 1.8px;
    color: #3DDC84;
    margin-right: 9px;
}

.bt-kasa__value {
    font-size: 20px;
    color: #F1F4F5;
    white-space: nowrap;
}

.bt-kasa__value.is-negative {
    color: #FF6464;
}

.bt-round {
    width: 36px;
    height: 36px;
    margin: 0 0 0 10px;
    padding: 0;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(42, 74, 82, 0.75);
    background-color: #16262D;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.bt-round:hover {
    background-color: #1E3640;
}

.bt-round.is-paused {
    background-image: resource("BusTycoon/UI/Gradients/gold");
    border-color: rgba(0, 0, 0, 0);
}

.bt-round.is-paused .bt-round__icon {
    -unity-background-image-tint-color: #1C1708;
}

.bt-round__icon {
    width: 20px;
    height: 20px;
}

.bt-race {
    margin-left: 10px;
    padding: 4px 12px;
    border-radius: 13px;
    background-color: rgba(245, 196, 81, 0.14);
}

.bt-race__icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    -unity-background-image-tint-color: #F5C451;
}

.bt-race__text {
    font-size: 13px;
    color: #F5C451;
}

.bt-date {
    height: 36px;
    margin-left: 10px;
    padding: 0 14px 0 12px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(42, 74, 82, 0.75);
    background-color: #16262D;
    flex-shrink: 0;
}

.bt-date__icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    -unity-background-image-tint-color: #F5C451;
}

.bt-date__text {
    font-size: 14px;
    color: #F1F4F5;
    white-space: nowrap;
}

.bt-date__track {
    position: absolute;
    left: 13px;
    right: 13px;
    bottom: -10px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(245, 196, 81, 0.2);
    overflow: hidden;
}

.bt-date__fill {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    background-color: #F5C451;
    transform-origin: left;
}

.narrow .bt-kasa__caps {
    display: none;
}

.narrow .bt-round {
    margin-left: 7px;
}

/* ------------------------------------------------------------------ alt sekmeler ve yuvarlak Harita düğmesi */

.bt-tabs {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: #0A151B;
    border-top-width: 1px;
    border-color: rgba(42, 74, 82, 0.45);
}

.bt-tabs__group {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
}

.bt-tabs__slot {
    width: 110px;
    flex-shrink: 0;
}

.bt-tab-item {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin: 0;
    padding: 0 14px;
    border-width: 0;
    border-radius: 13px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.bt-tab-item:hover {
    background-color: #142229;
}

.bt-tab-item__icon {
    width: 22px;
    height: 22px;
    margin-right: 9px;
    -unity-background-image-tint-color: #8FA3AB;
}

.bt-tab-item__label {
    font-size: 15px;
    color: #C7D2D6;
    white-space: nowrap;
}

.bt-tab-item__marker {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 38px;
    height: 4px;
    margin-left: -19px;
    border-radius: 2px;
    background-color: #F5C451;
    display: none;
}

.bt-tab-item.is-active {
    background-color: #1A2B32;
}

.bt-tab-item.is-active .bt-tab-item__icon {
    -unity-background-image-tint-color: #F5C451;
}

.bt-tab-item.is-active .bt-tab-item__label {
    color: #F5C451;
}

.bt-tab-item.is-active .bt-tab-item__marker {
    display: flex;
}

.narrow .bt-tab-item {
    flex-direction: column;
    justify-content: center;
    height: 56px;
    padding: 2px 6px;
}

.narrow .bt-tab-item__icon {
    margin-right: 0;
    margin-bottom: 2px;
}

.narrow .bt-tab-item__label {
    font-size: 11.5px;
}

.narrow .bt-tab-item__marker {
    top: -7px;
}

.bt-tab-item .bt-badge {
    top: 2px;
    right: 2px;
}

.bt-mapbutton {
    position: absolute;
    width: 90px;
    height: 91px;
}

.bt-mapbutton__ring {
    position: absolute;
    left: 6.5px;
    top: 0;
    width: 77px;
    height: 77px;
    border-radius: 38.5px;
    background-color: #0A151B;
}

.bt-mapbutton__disc {
    position: absolute;
    left: 11.5px;
    top: 5px;
    width: 67px;
    height: 67px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-radius: 33.5px;
    border-color: rgba(255, 231, 163, 0.55);
    background-image: resource("BusTycoon/UI/Gradients/goldbutton");
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.bt-mapbutton__disc:hover {
    scale: 1.04 1.04;
}

.bt-mapbutton__disc:active {
    scale: 0.96 0.96;
}

.bt-mapbutton__icon {
    width: 31px;
    height: 31px;
    -unity-background-image-tint-color: #1C1708;
}

.bt-mapbutton__label {
    position: absolute;
    left: 0;
    top: 73px;
    width: 90px;
    height: 18px;
    font-size: 13.5px;
    color: #F5C451;
    -unity-text-align: middle-center;
}

.bt-mapbutton.is-active .bt-mapbutton__disc {
    border-width: 3px;
    border-color: rgba(255, 231, 163, 0.85);
}

/* ------------------------------------------------------------------ bildirimler */

.bt-toasts {
    position: absolute;
    flex-direction: column;
    align-items: center;
}

.bt-toast {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    max-width: 620px;
    margin-bottom: 8px;
    padding: 6px 18px 6px 14px;
    border-radius: 20px;
    background-color: rgba(19, 40, 48, 0.98);
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(120, 200, 210, 0.12);
    border-left-color: #5AA9FF;
}

.bt-toast__icon {
    width: 20px;
    height: 20px;
    margin-right: 10px;
}

.bt-toast__text {
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
}

.bt-toast.is-success {
    border-left-color: #3DDC84;
}

.bt-toast.is-error {
    border-left-color: #FF6464;
}

.bt-toast.is-warning {
    border-left-color: #F5A524;
}

.bt-toast.is-gold {
    border-left-color: #F5C451;
}

.phone .bt-toast {
    min-height: 34px;
    max-width: 460px;
    margin-bottom: 6px;
}

.phone .bt-toast__text {
    font-size: 13px;
}

/* ------------------------------------------------------------------ sağ panel */

.bt-sheet {
    position: absolute;
    flex-direction: column;
    padding: 16px 16px 6px 18px;
    background-image: resource("BusTycoon/UI/Gradients/card");
    border-width: 1px;
    border-color: rgba(42, 74, 82, 0.75);
    border-radius: 18px;
    opacity: 0.3;
    translate: 36px 0px;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.bt-sheet.is-open {
    opacity: 1;
    translate: 0px 0px;
}

.bt-sheet__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.bt-sheet__title {
    font-size: 22px;
    color: #F1F4F5;
}

.bt-sheet__subtitle {
    font-size: 13px;
    color: #8DA1A8;
    margin-top: 2px;
    flex-shrink: 0;
}

.bt-sheet__close {
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 18px;
    background-color: #1E3640;
    color: #C7D2D6;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.bt-sheet__close:hover {
    background-color: #24414A;
}

.bt-sheet__scroll {
    flex-grow: 1;
    margin-top: 12px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    padding-top: 10px;
}

.phone .bt-sheet__close {
    width: 46px;
    height: 46px;
    border-radius: 23px;
}

/* Liste öğesi (görev, hat, otobüs...) */
.bt-item {
    padding: 12px 14px;
    margin: 0 4px 10px 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.bt-item.is-current {
    background-color: rgba(245, 196, 81, 0.10);
    border-color: rgba(245, 196, 81, 0.45);
}

.bt-item.is-done .bt-item__title {
    color: #7F949B;
}

.bt-item__icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-item__title {
    font-size: 15px;
    white-space: normal;
}

.bt-item__text {
    font-size: 13px;
    color: #A9B8BD;
    white-space: normal;
    margin-top: 4px;
}

.bt-item__reward {
    font-size: 12.5px;
    color: #F5C451;
    margin-top: 4px;
}

.bt-pill {
    font-size: 11.5px;
    padding: 2px 9px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    color: #C7D2D6;
    flex-shrink: 0;
}

.bt-pill.is-success {
    background-color: rgba(61, 220, 132, 0.12);
    color: #3DDC84;
}

.bt-pill.is-warning {
    background-color: rgba(245, 196, 81, 0.14);
    color: #F5C451;
}

.bt-pill.is-danger {
    background-color: rgba(255, 100, 100, 0.12);
    color: #FF8A8A;
}

.bt-empty {
    color: #8DA1A8;
    margin: 8px 0;
}

/* Günlük */
.bt-log {
    flex-direction: row;
    align-items: flex-start;
    padding: 6px 4px 6px 0;
    border-bottom-width: 1px;
    border-color: #1E3640;
}

.bt-log__icon {
    width: 16px;
    height: 16px;
    margin: 2px 8px 0 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-log__day {
    width: 62px;
    font-size: 12px;
    color: #7F949B;
    flex-shrink: 0;
    margin-top: 1px;
}

.bt-log__text {
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    font-size: 13.5px;
}

/* Yardım */
.bt-help__title {
    font-size: 16px;
    margin-top: 6px;
}

.bt-help__text {
    font-size: 13.5px;
    color: #D3DCDF;
    white-space: normal;
    margin: 4px 4px 12px 0;
}

/* Bölüm başlığı, anahtar–değer, çip, düğme */
.bt-section {
    font-size: 15px;
    margin: 6px 0 8px 2px;
}

.bt-kv {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
}

.bt-kv__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-kv__key {
    flex-grow: 1;
    flex-shrink: 1;
    color: #A9B8BD;
    font-size: 13.5px;
    white-space: normal;
}

.bt-kv__value {
    font-size: 14px;
    color: #F1F4F5;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.is-up {
    color: #3DDC84;
}

.is-down {
    color: #FF6464;
}

.is-gold {
    color: #F5C451;
}

.bt-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.bt-chip {
    flex-direction: row;
    align-items: center;
    padding: 3px 8px;
    margin: 0 6px 6px 0;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.bt-chip__icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-chip__text {
    font-size: 12px;
    color: #C7D2D6;
}

.bt-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.bt-actions__note {
    font-size: 12px;
    color: #A9B8BD;
    white-space: normal;
}

.bt-btn {
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background-color: #1E3640;
    color: #F1F4F5;
    font-size: 13px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.bt-btn:hover {
    background-color: #1E3640;
}

.bt-btn.is-primary {
    background-color: #F5C451;
    border-color: #F5C451;
    color: #1C1708;
}

.bt-btn.is-primary:hover {
    background-color: #E5A23A;
}

.bt-btn:disabled {
    opacity: 0.45;
}

.phone .bt-btn {
    height: 42px;
}

.bt-flag {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-pack {
    margin: 8px 4px 12px 0;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: rgba(245, 196, 81, 0.10);
}

.bt-pack__title {
    font-size: 16px;
    color: #F5C451;
}

.bt-chart {
    height: 120px;
    margin: 0 4px 12px 0;
    border-radius: 10px;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Hatlarım */
.bt-btn--wide {
    margin: 0 4px 12px 0;
    height: 40px;
}

.bt-route {
    border-left-width: 4px;
    padding: 12px 14px 10px 14px;
}

.bt-route__name {
    font-size: 15px;
    white-space: nowrap;
}

.bt-route__tag {
    font-size: 10px;
    letter-spacing: 1.4px;
    margin-left: 8px;
    margin-right: 8px;
    white-space: nowrap;
}

.bt-route__main {
    margin-top: 6px;
}

.bt-route__spark {
    width: 100px;
    height: 30px;
    margin: 0 14px;
}

.bt-route__value {
    align-items: flex-end;
}

.bt-route__profit {
    font-size: 16px;
    margin-bottom: 3px;
}

.bt-route__stats {
    margin-top: 6px;
}

.bt-route__detail {
    font-size: 12.5px;
    color: #A9B8BD;
}

.bt-route__load {
    width: 70px;
    margin: 0 0 0 8px;
}

.bt-bar__fill--blue {
    background-color: #5AA9FF;
}

.is-danger-text {
    color: #FF8A8A;
}

.is-warning-text {
    color: #F5C451;
}

.is-success-text {
    color: #3DDC84;
}

.bt-actions--start .bt-btn {
    margin: 0 8px 0 0;
}

/* Filo */
.bt-tabs-inline {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 12px 0;
}

.bt-tab {
    height: 34px;
    margin: 0 6px 0 0;
    padding: 0 12px;
    border-width: 0;
    border-radius: 17px;
    background-color: #1E3640;
    color: #C7D2D6;
    font-size: 13px;
}

.bt-tab.is-active {
    background-color: #F1F4F5;
    color: #1C1708;
}

.bt-btn--toggle {
    min-width: 84px;
    height: 38px;
}

.bt-btn--block {
    height: auto;
    min-height: 36px;
    margin: 10px 0 0 0;
    padding: 6px 14px;
    white-space: normal;
}

.bt-btn--choice {
    margin: 6px 0 0 0;
    border-left-width: 5px;
    -unity-text-align: middle-left;
}

.bt-btn.is-danger {
    color: #FF8A8A;
    border-color: rgba(255, 100, 100, 0.35);
}

.bt-actions--fill {
    margin-left: -4px;
    margin-right: -4px;
}

.bt-actions--fill .bt-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

.bt-bus__art {
    width: 60px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-detail {
    margin-top: 4px;
}

.bt-detail__icon {
    width: 15px;
    height: 15px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-detail__text {
    font-size: 12.5px;
    color: #A9B8BD;
    white-space: normal;
    flex-shrink: 1;
}

.is-warning-text .bt-detail__text {
    color: #F5C451;
}

.bt-bus__condition {
    width: 80px;
    margin: 0 0 0 8px;
}

.bt-bar__fill--green {
    background-color: #3DDC84;
}

.bt-bar__fill--yellow {
    background-color: #F5C451;
}

.bt-bar__fill--red {
    background-color: #FF6464;
}

/* Galeri */
.bt-note {
    background-color: rgba(90, 169, 255, 0.12);
    border-color: rgba(90, 169, 255, 0.35);
}

.bt-next {
    margin: 0 4px 10px 2px;
    white-space: normal;
}

.bt-model__art {
    width: 112px;
    height: 56px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-model.is-locked .bt-model__art {
    opacity: 0.4;
}

.bt-model.is-locked .bt-model__name {
    color: #7F949B;
}

.bt-model__name {
    font-size: 17px;
    color: #F1F4F5;
}

.bt-model__price {
    font-size: 19px;
    color: #F1F4F5;
}

.bt-spec {
    margin-right: 10px;
}

.bt-owned {
    font-size: 12.5px;
    color: #3DDC84;
    margin-top: 4px;
}

.bt-bar__fill--gold {
    background-color: #F5C451;
}

/* Hat paneli */
.bt-advice__text {
    margin: 0 8px;
}

.bt-chart--price {
    height: 150px;
    margin-bottom: 4px;
}

.bt-legend {
    margin: 0 4px 6px 0;
}

.bt-legend__text {
    font-size: 11.5px;
    color: #7F949B;
}

.bt-legend__center {
    -unity-text-align: middle-center;
}

.bt-slider {
    margin: 4px 6px 4px 2px;
    height: 30px;
}

.bt-slider .unity-base-slider__tracker {
    height: 6px;
    margin-top: -3px;
    border-radius: 3px;
    background-color: #24414A;
    border-width: 0;
}

.bt-slider .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: 11px;
    background-color: #F5C451;
    border-width: 2px;
    border-color: #0E1A21;
}

.phone .bt-slider .unity-base-slider__dragger {
    width: 30px;
    height: 30px;
    margin-top: -15px;
    border-radius: 15px;
}

.bt-stepper {
    margin: 4px 4px 2px 0;
}

.bt-stepper__center {
    align-items: center;
}

.bt-step {
    width: 46px;
    height: 42px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background-color: #1E3640;
    font-size: 22px;
    color: #F1F4F5;
    -unity-text-align: middle-center;
}

.bt-price {
    font-size: 28px;
    color: #F1F4F5;
}

.bt-zone {
    font-size: 15px;
    margin: 6px 4px 10px 2px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.bt-dim {
    color: #7F949B;
}

.bt-btn--ghost {
    margin: 12px 0 0 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #5AA9FF;
}

.bt-bus-row {
    align-items: center;
}

.bt-status {
    margin-left: 8px;
}

/* Tablo (hat geçmişi) */
.bt-table__head .bt-table__cell {
    color: #7F949B;
    font-size: 11.5px;
}

.bt-table__row {
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.bt-table__cell {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 12.5px;
    padding: 4px 0;
}

.bt-table__cell--day {
    flex-grow: 0.6;
}

.bt-table__cell--last {
    -unity-text-align: middle-right;
}

/* Planlayıcı */
.bt-step-title {
    font-size: 14.5px;
    margin: 2px 4px 10px 0;
    white-space: normal;
}

.bt-endpoint {
    margin: 0 4px 10px 0;
    padding: 8px 4px 8px 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
}

.bt-endpoint__dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 8px;
    border-width: 3px;
    border-color: #F1F4F5;
    background-color: #FFFFFF;
}

.bt-endpoint--origin .bt-endpoint__dot {
    background-color: #5AA9FF;
}

.bt-endpoint--destination .bt-endpoint__dot {
    background-color: #E5A23A;
}

.bt-endpoint__label {
    font-size: 16px;
}

.bt-endpoint__flag {
    width: 20px;
    height: 20px;
    margin-left: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-model-caption {
    margin: 4px 0 6px 2px;
}

.bt-model-picker {
    align-items: center;
}

.bt-model-picker .bt-step {
    width: 36px;
    height: 36px;
    font-size: 20px;
}

.bt-model-picker .bt-bus__art {
    margin-left: 8px;
}

.bt-suggestion {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 0 4px 6px 0;
    padding: 0 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.bt-suggestion:hover {
    background-color: rgba(245, 196, 81, 0.10);
    border-color: rgba(245, 196, 81, 0.45);
}

.bt-suggestion__flag {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-suggestion__city {
    font-size: 14px;
}

.bt-suggestion__km {
    font-size: 12.5px;
    color: #7F949B;
    margin-right: 10px;
}

.bt-suggestion__profit {
    font-size: 14px;
}

.is-blue {
    color: #5AA9FF;
}

.bt-check {
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin: 6px 0 0 0;
    padding: 0 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-check__box {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    border-radius: 6px;
    border-width: 2px;
    border-color: #6E848B;
    background-color: #0E1A21;
}

.bt-check.is-on .bt-check__box {
    background-color: #F5C451;
    border-color: #F5C451;
}

.bt-check__label {
    font-size: 13.5px;
}

.bt-btn--cta {
    height: 48px;
    margin: 12px 0 4px 0;
    font-size: 15px;
}

/* Görev kartı ve yakınlaştırma */
.bt-goal {
    position: absolute;
    flex-direction: row;
    align-items: flex-start;
    padding: 12px 12px 10px 14px;
    background-color: rgba(19, 40, 48, 0.98);
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.12);
    border-radius: 16px;
}

.bt-goal.is-chip {
    align-items: center;
    padding: 4px 12px;
    border-radius: 22px;
}

.bt-goal__icon {
    width: 30px;
    height: 30px;
    margin: 2px 12px 0 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-goal.is-chip .bt-goal__icon {
    width: 24px;
    height: 24px;
    margin: 0 10px 0 0;
}

.bt-goal__title {
    font-size: 15px;
    margin-top: 1px;
}

.bt-goal__hint {
    font-size: 12.5px;
    color: #A9B8BD;
    white-space: normal;
    margin-top: 2px;
}

.bt-goal__all {
    height: 28px;
    margin: 0 0 0 8px;
    flex-shrink: 0;
}

.bt-zoom {
    position: absolute;
    flex-direction: column;
}

.bt-zoom__button {
    width: 100%;
    flex-grow: 1;
    margin: 0 0 6px 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.14);
    border-radius: 14px;
    background-color: rgba(19, 40, 48, 0.98);
    color: #F1F4F5;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.bt-zoom__button:hover {
    background-color: #1E3640;
}

/* Pencereler */
.bt-modal-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 8, 12, 0.62);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.bt-modal-layer.is-open {
    opacity: 1;
}

.bt-modal {
    position: absolute;
    padding: 22px 22px 16px 22px;
    background-color: #132830;
    border-radius: 20px;
    translate: 0px 14px;
    transition-property: translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.bt-modal-layer.is-open .bt-modal {
    translate: 0px 0px;
}

.bt-modal__scroll {
    flex-grow: 1;
}

.bt-modal__scroll .unity-scroll-view__content-container {
    min-height: 100%;
}

.bt-modal__title {
    font-size: 24px;
    margin-bottom: 12px;
    white-space: normal;
}

.bt-modal__text {
    font-size: 14.5px;
    color: #D3DCDF;
    white-space: normal;
    margin-bottom: 12px;
}

.bt-modal__button {
    height: 42px;
    margin: 0 0 8px 0;
    font-size: 14px;
}

.bt-modal__button--main {
    height: 48px;
    font-size: 15px;
}

.bt-modal__caption {
    margin: 10px 0 6px 2px;
}

.bt-modal__spacer {
    flex-grow: 1;
    min-height: 12px;
}

.bt-actions--fill .bt-modal__button {
    margin-top: 0;
}

.bt-nowrap {
    white-space: nowrap;
    flex-shrink: 0;
}

.bt-tabs-inline {
    flex-wrap: wrap;
    margin-bottom: 6px;
}

/* Sekmeler alt satıra kayınca satırlar arasında boşluk */
.bt-tabs-inline .bt-tab {
    margin-bottom: 6px;
}

/* İnce kaydırma çubuğu (ok düğmeleri yok) */
.bt-sheet__scroll .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-sheet__scroll .unity-scroller__low-button,
.bt-sheet__scroll .unity-scroller__high-button {
    display: none;
}

.bt-sheet__scroll .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-sheet__scroll .unity-scroller .unity-base-slider__dragger {
    width: 6px;
    left: 1px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.16);
}

.bt-modal__scroll .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-modal__scroll .unity-scroller__low-button,
.bt-modal__scroll .unity-scroller__high-button {
    display: none;
}

/* Ana menü */
.bt-menu-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bt-menu {
    position: absolute;
    flex-direction: column;
    padding: 22px 26px 16px 26px;
    background-color: rgba(19, 40, 48, 0.98);
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.12);
    border-radius: 22px;
}

.bt-menu.is-wide {
    flex-direction: row;
}

.bt-menu__brand {
    width: 300px;
    margin-right: 18px;
    flex-shrink: 0;
}

.bt-menu__buttons {
    flex-grow: 1;
}

.bt-menu__mascot {
    flex-shrink: 0;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-menu__title {
    font-size: 34px;
    color: #F5C451;
    -unity-text-align: middle-center;
}

.bt-menu.is-wide .bt-menu__title {
    font-size: 28px;
    -unity-text-align: middle-left;
}

.bt-menu__subtitle {
    font-size: 14px;
    color: #8DA1A8;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.bt-menu.is-wide .bt-menu__subtitle {
    -unity-text-align: middle-left;
}

.bt-menu__credits {
    font-size: 11px;
    color: #8DA1A8;
    margin-top: 10px;
    white-space: normal;
}

.bt-menu__help {
    flex-grow: 1;
    margin-bottom: 10px;
}

/* Durak ekranı */
.bt-station {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bt-station__back {
    position: absolute;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 0 14px;
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.14);
    border-radius: 14px;
    background-color: rgba(19, 40, 48, 0.98);
}

.bt-station__back:hover {
    background-color: #1E3640;
}

.bt-station__back-icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-station__back-label {
    font-size: 14px;
}

.bt-station__card {
    padding-bottom: 14px;
}

.bt-station__scroll {
    flex-grow: 1;
}

.bt-station__city-icon {
    width: 46px;
    height: 46px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-station__hint {
    position: absolute;
    font-size: 13px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.bt-popularity {
    margin: 10px 0 4px 0;
}

.bt-star {
    width: 18px;
    height: 18px;
    margin-left: 2px;
}

.bt-star__empty {
    position: absolute;
    width: 18px;
    height: 18px;
    opacity: 0.22;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-star__clip {
    position: absolute;
    left: 0;
    top: 0;
    height: 18px;
    overflow: hidden;
}

.bt-star__full {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-popularity__score {
    font-size: 15px;
    margin-left: 8px;
}

.bt-popularity__label {
    width: 104px;
    flex-shrink: 0;
}

.bt-station__facts {
    margin-top: 10px;
}

.bt-upgrade.is-locked .bt-upgrade__icon {
    opacity: 0.45;
}

.bt-upgrade.is-locked .bt-item__title {
    color: #7F949B;
}

.bt-upgrade__icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Yeni oyun ve yazı alanı */
.bt-newgame {
    padding-bottom: 14px;
}

.bt-field {
    margin: 0 4px 10px 0;
}

.bt-field .unity-base-text-field__input {
    height: 40px;
    padding: 0 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background-color: #0E1A21;
    color: #F1F4F5;
    font-size: 15px;
}

.bt-field:focus .unity-base-text-field__input {
    border-color: #F5C451;
}

/* Dokunmatik yazı alanı: dokununca tarayıcının yazı penceresi açılır */
.bt-field--tap {
    height: 40px;
    padding: 0 12px;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background-color: #0E1A21;
}

.bt-field__text {
    font-size: 15px;
    color: #F1F4F5;
}

.bt-field__text.is-placeholder {
    color: #8DA1A8;
}

/* Çok oyunculu ekranı */
.bt-mp__header {
    margin-bottom: 10px;
}

.bt-mp__icon {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-mp__footer {
    flex-shrink: 0;
    margin-top: 10px;
}

.bt-mp__footer .bt-item__text {
    margin-bottom: 8px;
}

.bt-mp__modes {
    align-items: stretch;
    margin: 0 4px 10px 0;
}

.bt-mode {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: flex-start;
    margin: 0 8px 0 0;
    padding: 8px 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
}

.bt-mode:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.bt-mode.is-active {
    border-color: #F5C451;
    background-color: rgba(245, 196, 81, 0.10);
}

.bt-mode__title {
    font-size: 16px;
}

.bt-mode__text {
    font-size: 12px;
    color: #A9B8BD;
    white-space: normal;
}

.bt-mp__join {
    align-items: flex-start;
    margin-right: 4px;
}

.bt-mp__join .bt-field {
    margin-right: 0;
}

.bt-mp__join-button {
    width: 110px;
    height: 40px;
    margin: 0 0 0 8px;
}

.bt-mp__status {
    margin-top: 8px;
}

.bt-mp__code {
    font-size: 34px;
    letter-spacing: 4px;
}

.bt-mp__invite {
    margin-right: 0;
}

.bt-mp__target {
    margin: 10px 4px 6px 2px;
}

.bt-mp__player {
    padding: 8px 12px;
    margin-bottom: 6px;
}

/* Yarış: canlı sıralama kartı */
.bt-race-card {
    position: absolute;
    padding: 10px 14px 8px 14px;
    background-color: rgba(19, 40, 48, 0.98);
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.12);
    border-radius: 16px;
}

.bt-race-card .bt-row {
    min-height: 20px;
}

.bt-race-card__header {
    margin-bottom: 6px;
}

.bt-race-card__icon {
    margin-right: 6px;
}

.bt-race-card__row {
    height: 30px;
    justify-content: center;
}

.bt-race-card__rank {
    width: 22px;
    font-size: 13px;
}

.bt-race-card__name {
    font-size: 13.5px;
    overflow: hidden;
}

.bt-race-card__cash {
    font-size: 13.5px;
    -unity-text-align: middle-right;
}

.bt-race-card__bar {
    height: 4px;
    margin: 2px 0 0 22px;
}

/* Mini harita çerçevesi (harita içeriğini IMGUI çizer) */
.bt-minimap {
    position: absolute;
    background-color: rgba(19, 40, 48, 0.98);
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.12);
    border-radius: 14px;
}

.bt-minimap__header {
    padding: 0 8px 0 10px;
    flex-shrink: 0;
}

.bt-minimap__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.bt-minimap__toggle {
    width: 30px;
    height: 22px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: #1E3640;
    align-items: center;
    justify-content: center;
}

.bt-minimap__mark {
    position: absolute;
    width: 10px;
    height: 2px;
    border-radius: 1px;
    background-color: #C7D2D6;
}

.bt-minimap__mark--vertical {
    width: 2px;
    height: 10px;
}

.bt-minimap__toggle:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* Şehir ipucu (fare şehrin üstündeyken) */
.bt-tooltip {
    position: absolute;
    padding: 9px 12px 9px 10px;
    background-color: rgba(19, 40, 48, 0.98);
    border-width: 1px;
    border-color: rgba(120, 200, 210, 0.16);
    border-radius: 12px;
}

.bt-tooltip__row {
    align-items: flex-start;
}

.bt-tooltip__city-icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.bt-tooltip__title {
    font-size: 15px;
    margin-bottom: 1px;
}

.bt-tooltip__line {
    font-size: 12.5px;
    white-space: normal;
}

.bt-tooltip__flag {
    width: 22px;
    height: 22px;
    margin-left: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* İnce kaydırma çubuğu (durak kartı, menü yardımı, pencereler): ok düğmeleri yok */
.bt-thin-scroll .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-thin-scroll .unity-scroller__low-button,
.bt-thin-scroll .unity-scroller__high-button {
    display: none;
}

.bt-thin-scroll .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-thin-scroll .unity-scroller .unity-base-slider__dragger {
    width: 6px;
    left: 1px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.16);
}



/* ------------------------------------------------------------------ sekme sayfası (içerik alanını kaplar) */

.bt-sheet.is-page {
    padding: 0;
    background-image: none;
    border-width: 0;
    border-radius: 0;
}

.is-page .bt-sheet__header, .is-page .bt-sheet__subtitle {
    display: none;
}

.is-page .bt-sheet__scroll {
    margin-top: 0;
    border-top-width: 0;
    padding-top: 0;
}

.is-page .bt-item {
    background-image: resource("BusTycoon/UI/Gradients/card");
    border-color: rgba(42, 74, 82, 0.75);
    border-radius: 16px;
}

/* İki sütunlu ızgara: kartlar yan yana, başlık ve sekmeler tam genişlik */
.is-wide .bt-sheet__scroll .unity-scroll-view__content-container, .is-wide .bt-list {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.is-wide .bt-sheet__scroll .unity-scroll-view__content-container > * {
    width: 100%;
}

.is-wide .bt-sheet__scroll .unity-scroll-view__content-container > .bt-item, .is-wide .bt-sheet__scroll .unity-scroll-view__content-container > .bt-route, .is-wide .bt-list > * {
    width: 49.4%;
    margin-right: 0;
}

.is-wide .bt-company-card {
    width: 100%;
}

/* Izgarada tam genişlik kalan kart (ör. Filo'daki bakım asistanı şeridi) */
.is-wide .bt-sheet__scroll .unity-scroll-view__content-container > .bt-full {
    width: 100%;
}

.bt-section--full {
    width: 100%;
    margin-top: 10px;
}

/* Şirketim */
.bt-company-card__logo {
    width: 54px;
    height: 54px;
    border-radius: 15px;
    margin-right: 14px;
    background-image: resource("BusTycoon/UI/Gradients/gold");
    align-items: center;
    justify-content: center;
}

.bt-company-card__logo-icon {
    width: 32px;
    height: 32px;
    -unity-background-image-tint-color: #1C1708;
}

.bt-company-card__name {
    font-size: 20px;
}

/* ------------------------------------------------------------------ ortak: rozet, çip, bağlantı, değişim, çağrı */

.bt-status-badge {
    margin-left: 10px;
    padding: 2px 9px 2px 7px;
    border-radius: 9px;
    background-color: rgba(61, 220, 132, 0.13);
}

.bt-status-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 6px;
    background-color: #3DDC84;
}

.bt-status-badge__text {
    font-size: 11px;
    color: #3DDC84;
}

.bt-status-badge.is-down {
    background-color: rgba(255, 100, 100, 0.13);
}

.bt-status-badge.is-down .bt-status-badge__dot {
    background-color: #FF6464;
}

.bt-status-badge.is-down .bt-status-badge__text {
    color: #FF6464;
}

.bt-chip-gold {
    margin-left: 10px;
    padding: 3px 10px;
    border-width: 1.5px;
    border-radius: 11px;
    border-color: rgba(245, 196, 81, 0.6);
    font-size: 11px;
    letter-spacing: 1px;
    color: #F5C451;
}

.bt-link {
    margin: 0;
    padding: 2px 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 14px;
    color: #F5C451;
}

.bt-change {
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 11.5px;
}

.bt-change.is-up {
    background-color: rgba(61, 220, 132, 0.14);
}

.bt-change.is-down {
    background-color: rgba(255, 100, 100, 0.14);
}

.bt-cta {
    flex-direction: row;
    align-items: center;
    height: 58px;
    margin: 0;
    padding: 0 10px 0 16px;
    border-width: 0;
    border-radius: 15px;
    background-image: resource("BusTycoon/UI/Gradients/gold");
    flex-shrink: 0;
}

.bt-cta__kicker {
    font-size: 10px;
    letter-spacing: 1.8px;
    color: rgba(28, 23, 8, 0.65);
}

.bt-cta__title {
    font-size: 17px;
    color: #1C1708;
}

.bt-cta--big .bt-cta__title {
    font-size: 20px;
}

.bt-cta__sub {
    font-size: 12px;
    color: rgba(28, 23, 8, 0.75);
}

.bt-cta__go {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0.13);
    align-items: center;
    justify-content: center;
}

.bt-cta__go-icon {
    width: 22px;
    height: 22px;
    -unity-background-image-tint-color: #1C1708;
}

/* ------------------------------------------------------------------ ana ekran */

.bt-home {
    position: absolute;
    flex-direction: row;
    justify-content: space-between;
}

.bt-home__left {
    width: 61%;
    flex-direction: column;
}

.bt-home__right {
    width: 37.4%;
    flex-direction: column;
}

.bt-home-cash {
    padding: 16px 20px 14px 20px;
    flex-shrink: 0;
}

.bt-home-cash__top {
    flex-direction: row;
    align-items: flex-start;
}

.bt-home-cash__amount {
    font-size: 38px;
    color: #F1F4F5;
    margin-top: 6px;
    letter-spacing: -0.5px;
    white-space: nowrap;
}

.bt-home-cash__amount.is-negative {
    color: #FF6464;
}

.bt-home-cash__worth {
    font-size: 13px;
    color: #8DA1A8;
    margin-top: 2px;
}

.bt-home-cash__chart {
    width: 34%;
    height: 74px;
    margin-left: 16px;
    flex-shrink: 0;
}

.bt-home-cash__divider {
    height: 1px;
    margin: 12px 0 10px 0;
    background-color: rgba(42, 74, 82, 0.6);
}

.bt-home-cash__stats {
    flex-direction: row;
}

.bt-home-stat {
    width: 25%;
}

.bt-home-stat__value {
    font-size: 16px;
    color: #F1F4F5;
    margin-top: 3px;
    white-space: nowrap;
}

.bt-home-section {
    margin-top: 12px;
    height: 26px;
    flex-shrink: 0;
}

.bt-home-section__title {
    font-size: 17px;
    color: #F1F4F5;
}

.bt-home-routes {
    flex-shrink: 1;
}

.bt-home-route {
    min-height: 58px;
    margin: 8px 0 0 0;
    padding: 8px 16px 8px 0;
    border-radius: 15px;
    flex-shrink: 0;
}

.bt-home-route__bar {
    width: 4px;
    height: 34px;
    border-radius: 2px;
    margin: 0 12px 0 12px;
}

.bt-home-route__name {
    font-size: 15px;
    white-space: nowrap;
}

.bt-home-route__info {
    font-size: 12px;
    color: #8DA1A8;
    margin-top: 2px;
}

.bt-home-route__spark {
    width: 108px;
    height: 30px;
    margin-right: 16px;
}

.bt-home-route__value {
    align-items: flex-end;
}

.bt-home-route__money {
    font-size: 16px;
    color: #F1F4F5;
    margin-bottom: 3px;
}

.bt-home-empty {
    height: 150px;
    margin: 8px 0 0 0;
    border-width: 1px;
    border-radius: 15px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.02);
    align-items: center;
    justify-content: center;
}

.bt-home-empty__plus {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.07);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.bt-home-empty__icon {
    width: 28px;
    height: 28px;
    -unity-background-image-tint-color: #F5C451;
}

.bt-home-empty__title {
    font-size: 16px;
    color: #F1F4F5;
}

.bt-home-empty__sub {
    font-size: 12px;
    color: #8DA1A8;
}

.bt-home-today {
    padding: 12px 14px;
    flex-shrink: 0;
}

.bt-reward {
    height: 26px;
    margin: 0;
    padding: 0 10px 0 4px;
    border-width: 0;
    border-radius: 13px;
    background-image: resource("BusTycoon/UI/Gradients/gold");
    flex-shrink: 1;
    overflow: hidden;
}

.bt-reward__dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #1C1708;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
}

.bt-reward__icon {
    width: 12px;
    height: 12px;
    -unity-background-image-tint-color: #F5C451;
}

.bt-reward__text {
    font-size: 11.5px;
    color: #1C1708;
    white-space: nowrap;
}

.bt-home-minis {
    margin-top: 10px;
}

.bt-mini {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 50px;
    margin: 0 4px;
    padding: 6px 8px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(42, 74, 82, 0.6);
    background-color: rgba(255, 255, 255, 0.04);
}

.bt-mini.is-accent {
    border-color: rgba(123, 97, 255, 0.55);
}

.bt-mini.is-accent .bt-tile__sub {
    color: #B9A2FF;
}

.bt-home-tiles {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 10px;
    flex-shrink: 0;
}

.bt-tile {
    width: 48.6%;
    min-height: 52px;
    margin: 0 0 9px 0;
    padding: 7px 10px 7px 7px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(42, 74, 82, 0.75);
    background-image: resource("BusTycoon/UI/Gradients/card");
    flex-shrink: 0;
}

.bt-tile--wide {
    width: 100%;
}

.bt-tile__box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    margin-right: 10px;
    background-color: rgba(255, 255, 255, 0.07);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.bt-tile__icon {
    width: 20px;
    height: 20px;
}

.bt-tile__title {
    font-size: 15px;
    color: #F1F4F5;
    white-space: nowrap;
}

.bt-tile__sub {
    font-size: 12px;
    color: #8DA1A8;
    white-space: nowrap;
    margin-top: 1px;
}

.bt-tile.is-highlight {
    border-width: 0;
    background-image: resource("BusTycoon/UI/Gradients/gold");
}

.bt-tile.is-highlight .bt-tile__box {
    background-color: rgba(0, 0, 0, 0.13);
}

.bt-tile.is-highlight .bt-tile__icon {
    -unity-background-image-tint-color: #1C1708;
}

.bt-tile.is-highlight .bt-tile__title {
    color: #1C1708;
}

.bt-tile.is-highlight .bt-tile__sub {
    color: #3D3214;
}

.bt-tile__box.is-amber { background-color: #3A3020; }
.bt-tile__box.is-amber .bt-tile__icon { -unity-background-image-tint-color: #F5C451; }
.bt-tile__box.is-blue { background-color: #1C3350; }
.bt-tile__box.is-blue .bt-tile__icon { -unity-background-image-tint-color: #6FB1FF; }
.bt-tile__box.is-teal { background-color: #163A36; }
.bt-tile__box.is-teal .bt-tile__icon { -unity-background-image-tint-color: #3DD6B5; }
.bt-tile__box.is-slate { background-color: #24323A; }
.bt-tile__box.is-slate .bt-tile__icon { -unity-background-image-tint-color: #A9BCC4; }
.bt-tile__box.is-red { background-color: #3D2326; }
.bt-tile__box.is-red .bt-tile__icon { -unity-background-image-tint-color: #FF7A7A; }
.bt-tile__box.is-purple { background-color: #2E2648; }
.bt-tile__box.is-purple .bt-tile__icon { -unity-background-image-tint-color: #B39BFF; }

.phone .bt-home-cash__amount {
    font-size: 34px;
}

/* ------------------------------------------------------------------ harita kartı */

.bt-mapframe {
    position: absolute;
    border-width: 40px;
    border-color: #0E1A21;
    border-radius: 58px;
}

.bt-mapedge {
    position: absolute;
    border-width: 1px;
    border-color: rgba(42, 74, 82, 0.75);
    border-radius: 18px;
}

.bt-mapcontrols {
    position: absolute;
    flex-direction: row;
    align-items: flex-start;
}

.bt-maploc {
    height: 36px;
    margin: 0;
    padding: 0 14px 0 10px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(245, 196, 81, 0.55);
    background-color: rgba(14, 26, 33, 0.9);
}

.bt-maploc__icon {
    width: 19px;
    height: 19px;
    margin-right: 6px;
    -unity-background-image-tint-color: #F5C451;
}

.bt-maploc__text {
    font-size: 14.5px;
    color: #F1F4F5;
}

.bt-mapzoom {
    flex-direction: column;
}

.bt-mapzoom__button {
    width: 42px;
    height: 42px;
    margin: 0 0 10px 0;
    padding: 0;
    border-width: 1px;
    border-radius: 21px;
    border-color: rgba(42, 74, 82, 0.75);
    background-color: rgba(14, 26, 33, 0.92);
    align-items: center;
    justify-content: center;
}

.bt-mapzoom__icon {
    width: 22px;
    height: 22px;
}

.bt-mapside {
    position: absolute;
    flex-direction: column;
    padding: 14px;
}

.bt-mapside__list {
    margin-top: 8px;
    margin-bottom: 10px;
}

.bt-mapside__caption {
    margin-top: 4px;
    margin-bottom: 4px;
}

.bt-mapside__route {
    height: 30px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bt-mapside__swatch {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    margin-right: 10px;
}

.bt-mapside__name {
    font-size: 14px;
    color: #F1F4F5;
    white-space: nowrap;
    overflow: hidden;
}

.bt-mapside__value {
    font-size: 12.5px;
    margin-left: 6px;
}

.bt-mapside__empty {
    font-size: 13px;
    color: #8DA1A8;
    white-space: normal;
}

.bt-mapside__marker {
    height: 26px;
}

.bt-mapside__dot {
    width: 19px;
    height: 19px;
    margin-right: 10px;
}

.bt-mapside__dot.is-gold-bg {
    -unity-background-image-tint-color: #F5C451;
}

.bt-mapside__dot.is-green-bg {
    -unity-background-image-tint-color: #3DDC84;
}

.bt-mapside__marker-text {
    font-size: 14px;
    color: #F1F4F5;
}

/* ------------------------------------------------------------------ şirket logosu ve "Şirketini kur" */

.bt-logo {
    border-radius: 11px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.bt-logo__icon {
    width: 62%;
    height: 62%;
    -unity-background-image-tint-color: #FFFFFF;
}

.bt-logo__icon.is-dark {
    -unity-background-image-tint-color: #1C1708;
}

.bt-logo--top {
    width: 40px;
    height: 40px;
    margin-right: 12px;
}

.bt-logo--large {
    width: 56px;
    height: 56px;
    border-radius: 15px;
    margin-right: 14px;
}

.bt-logo--pick {
    width: 46px;
    height: 46px;
    border-radius: 13px;
}

.bt-newgame__header {
    flex-shrink: 0;
}

.bt-logo-picker {
    flex-direction: row;
    flex-wrap: wrap;
}

.bt-logo-pick {
    margin: 0 8px 8px 0;
    padding: 3px;
    border-width: 2px;
    border-radius: 16px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.bt-logo-pick.is-active {
    border-color: #F5C451;
}

.bt-city-picker {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.bt-city-pick {
    width: 49%;
    height: 50px;
    margin: 0 0 8px 0;
    padding: 0 10px 0 8px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(42, 74, 82, 0.75);
    background-color: rgba(255, 255, 255, 0.04);
}

.bt-city-pick.is-active {
    border-color: #F5C451;
    background-color: rgba(245, 196, 81, 0.12);
}

.bt-city-pick__icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.bt-city-pick__name {
    font-size: 15px;
    color: #F1F4F5;
}

.bt-city-pick__sub {
    font-size: 12px;
    color: #8DA1A8;
}


/* ------------------------------------------------------------------ Hatlarım: süzgeç, sıralama, uyarı şeridi */

.bt-route-controls {
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.bt-segment {
    padding: 3px;
    margin: 0 10px 6px 0;
    border-width: 1px;
    border-radius: 15px;
    border-color: rgba(42, 74, 82, 0.75);
    background-color: #16262D;
}

.bt-segment__item {
    height: 32px;
    margin: 0;
    padding: 0 14px;
    border-width: 0;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.bt-segment__label {
    font-size: 14px;
    color: #D3DCDF;
}

.bt-segment__count {
    font-size: 11px;
    margin-left: 7px;
    padding: 1px 7px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    color: #F5C451;
}

.bt-segment__item.is-active {
    background-image: resource("BusTycoon/UI/Gradients/gold");
}

.bt-segment__item.is-active .bt-segment__label {
    color: #1C1708;
}

.bt-segment__item.is-active .bt-segment__count {
    background-color: rgba(0, 0, 0, 0.15);
    color: #1C1708;
}

.bt-segment.is-plain .bt-segment__label {
    color: #8DA1A8;
}

.bt-segment.is-plain .bt-segment__item.is-active {
    background-image: none;
    background-color: rgba(255, 255, 255, 0.08);
}

.bt-segment.is-plain .bt-segment__item.is-active .bt-segment__label {
    color: #F1F4F5;
}

.bt-alert {
    height: 40px;
    margin: 0 0 10px 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(255, 100, 100, 0.25);
    background-color: rgba(255, 100, 100, 0.07);
    overflow: hidden;
}

.bt-alert__tag {
    font-size: 11px;
    letter-spacing: 1.4px;
    color: #FF8F8F;
    margin-right: 10px;
}

.bt-alert__text {
    font-size: 13px;
    color: #E7D6D6;
    white-space: nowrap;
}
