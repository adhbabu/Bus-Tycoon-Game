      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Oyun ayarları
-- Sayıların hepsi buradan değiştirilebilir. Oyunu dengelemek için bu dosyayla oyna.

local Config = {}

----------------------------------------------------------------------
-- SES: "huss huss huss"
-- 1) roblox/BurgerImparatoru/sesler/huss.mp3 dosyasını Roblox'a yükle
--    (Creator Hub > Creations > Development Items > Audio > Import).
-- 2) Yüklenen sesin numarasını (Asset ID) aşağıya yaz, örnek:
--    Config.HussSesId = "rbxassetid://1234567890"
-- Boş bırakırsan oyun yine çalışır, sadece ses yerine ekranda HUSS! yazıları çıkar.
----------------------------------------------------------------------
Config.HussSesId = ""
Config.HussSesSeviyesi = 0.9 -- kendi katlaman (0 ile 1 arası)
Config.BaskasininSesSeviyesi = 0.35 -- başka oyuncuların katlaması (yakındaysan duyarsın)
-- Seste her "huss" kaçıncı saniyede başlıyor? Ekrandaki HUSS! yazıları bu anlarda fırlar.
Config.HussZamanlari = { 0.04, 0.24, 0.44 }

----------------------------------------------------------------------
-- KATLAMA VE PAKETLEME
-- Her burger açık bir burger kağıdının ortasında gelir. Her katlamada kağıdın bir kanadı
-- burgerin üstüne katlanır: 1) sol, 2) sağ, 3) ön ve arka -> burger kağıda sarılır, paketlenir.
----------------------------------------------------------------------
Config.KatlamaSayisi = 3 -- bir burger kaç katlamada paketlenir
Config.KatlamaBeklemesi = 0.08 -- iki tıklama arası en az kaç saniye (hile koruması)
Config.PaketTabanDegeri = 4 -- her paket en az bu kadar para eder (+ içindeki malzemeler)

-- Malzemeler: Deger = paketin değerine eklediği para.
-- Sekil: "disk" (yuvarlak), "kare" (peynir gibi), "dalga" (marul gibi)
Config.Malzemeler = {
	Kofte = { Ad = "Köfte", Deger = 3, Renk = Color3.fromRGB(110, 62, 38), Kalinlik = 0.55, Cap = 4.3, Sekil = "disk", Malzeme = "Slate" },
	Peynir = { Ad = "Peynir", Deger = 2, Renk = Color3.fromRGB(255, 196, 40), Kalinlik = 0.16, Cap = 4.7, Sekil = "kare", Malzeme = "SmoothPlastic" },
	Marul = { Ad = "Marul", Deger = 1, Renk = Color3.fromRGB(110, 200, 70), Kalinlik = 0.22, Cap = 4.9, Sekil = "dalga", Malzeme = "Grass" },
	Domates = { Ad = "Domates", Deger = 1, Renk = Color3.fromRGB(225, 45, 40), Kalinlik = 0.26, Cap = 3.9, Sekil = "disk", Malzeme = "SmoothPlastic" },
	Sogan = { Ad = "Soğan", Deger = 1, Renk = Color3.fromRGB(235, 215, 235), Kalinlik = 0.14, Cap = 3.7, Sekil = "disk", Malzeme = "SmoothPlastic" },
	Tursu = { Ad = "Turşu", Deger = 2, Renk = Color3.fromRGB(120, 140, 40), Kalinlik = 0.12, Cap = 3.4, Sekil = "disk", Malzeme = "SmoothPlastic" },
	AltinKofte = { Ad = "ALTIN KÖFTE", Deger = 30, Renk = Color3.fromRGB(255, 205, 50), Kalinlik = 0.6, Cap = 4.4, Sekil = "disk", Malzeme = "Foil", Altin = true },
}

-- Burger tarifi, alttan üste. Sans = o malzemenin burgerde olma ihtimali (1 = hep var).
-- İlk köfte bazen ALTIN KÖFTE olur (bkz. AltinTabanSansi).
Config.Tarif = {
	{ Malzeme = "Kofte", Sans = 1 },
	{ Malzeme = "Peynir", Sans = 0.75 },
	{ Malzeme = "Kofte", Sans = 0.2 },
	{ Malzeme = "Marul", Sans = 0.6 },
	{ Malzeme = "Domates", Sans = 0.5 },
	{ Malzeme = "Sogan", Sans = 0.3 },
	{ Malzeme = "Tursu", Sans = 0.3 },
}

Config.AltinTabanSansi = 0.03 -- %3 ihtimalle ALTIN BURGER
Config.AltinSansArtisi = 0.02 -- "Altın Şans" geliştirmesinin her seviyesi +%2

Config.AltEkmek = { Ad = "Alt Ekmek", Renk = Color3.fromRGB(222, 160, 80), Kalinlik = 0.7, Cap = 4.5 }
Config.UstEkmek = { Ad = "Üst Ekmek", Renk = Color3.fromRGB(222, 160, 80), Kalinlik = 1.8, Cap = 4.6 }

-- Burger kağıdı
Config.KagitRengi = Color3.fromRGB(250, 242, 226)
Config.KagitBaskiRengi = Color3.fromRGB(215, 45, 45) -- kağıdın üstündeki kırmızı baskı
Config.AltinKagitRengi = Color3.fromRGB(255, 205, 60) -- ALTIN BURGER altın kağıda sarılır
Config.YiginEnFazla = 6 -- tezgahın yanındaki paket kulesi en fazla kaç paket olur

----------------------------------------------------------------------
-- GELİŞTİRMELER (Dükkan)
-- Fiyat = TabanFiyat * Carpan ^ seviye
----------------------------------------------------------------------
Config.Gelistirmeler = {
	{
		Anahtar = "HizliEller",
		Ad = "Hızlı Eller",
		Ikon = "✋",
		Aciklama = "Her tıkta daha çok katlama",
		TabanFiyat = 75,
		Carpan = 4,
		MaxSeviye = 2,
	},
	{
		Anahtar = "Lezzet",
		Ad = "Lezzet Ustası",
		Ikon = "🧂",
		Aciklama = "Her paket daha çok para eder",
		TabanFiyat = 40,
		Carpan = 1.9,
		MaxSeviye = 25,
	},
	{
		Anahtar = "OtoAsci",
		Ad = "Çırak Aşçı",
		Ikon = "👨‍🍳",
		Aciklama = "Sen dururken o katlar",
		TabanFiyat = 120,
		Carpan = 2.3,
		MaxSeviye = 10,
	},
	{
		Anahtar = "AltinSans",
		Ad = "Altın Şans",
		Ikon = "✨",
		Aciklama = "ALTIN BURGER daha sık çıkar",
		TabanFiyat = 100,
		Carpan = 2.2,
		MaxSeviye = 10,
	},
}

Config.OtoAsciIlkAralik = 3.0 -- Çırak Aşçı 1. seviyede kaç saniyede bir katlar
Config.OtoAsciHizlanma = 0.78 -- her seviyede aralık bu sayıyla çarpılır

----------------------------------------------------------------------
-- UNVANLAR (toplam paketlenen burgere göre)
----------------------------------------------------------------------
Config.Unvanlar = {
	{ Esik = 0, Ad = "Çırak", Renk = Color3.fromRGB(200, 200, 200) },
	{ Esik = 20, Ad = "Aşçı", Renk = Color3.fromRGB(120, 220, 120) },
	{ Esik = 100, Ad = "Şef", Renk = Color3.fromRGB(90, 170, 255) },
	{ Esik = 400, Ad = "Usta Şef", Renk = Color3.fromRGB(190, 110, 255) },
	{ Esik = 1500, Ad = "Burger Lordu", Renk = Color3.fromRGB(255, 140, 50) },
	{ Esik = 5000, Ad = "Burger Sultanı", Renk = Color3.fromRGB(255, 70, 90) },
	{ Esik = 20000, Ad = "BURGER İMPARATORU", Renk = Color3.fromRGB(255, 215, 0) },
}

----------------------------------------------------------------------
-- DÜNYA
----------------------------------------------------------------------
Config.TezgahSayisi = 12 -- aynı sunucuda en fazla kaç oyuncu burger yapabilir
Config.TezgahYaricapi = 46 -- tezgahlar ortadaki heykelin etrafında bu uzaklıkta dizilir

Config.KayitAnahtari = "BurgerImparatoru_v2" -- DataStore adı (değiştirirsen herkesin kaydı sıfırlanır)

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Ekonomi</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Ekonomi hesapları
-- Hem sunucu hem oyuncu (client) aynı hesapları buradan yapar, böylece ekrandaki fiyatlar
-- ile sunucunun kabul ettiği fiyatlar hep aynı olur.

local Config = require(script.Parent.Config)

local Ekonomi = {}

local gelistirmeTablosu = {}
for _, g in ipairs(Config.Gelistirmeler) do
	gelistirmeTablosu[g.Anahtar] = g
end

function Ekonomi.GelistirmeBul(anahtar)
	return gelistirmeTablosu[anahtar]
end

function Ekonomi.BosGelistirmeler()
	local t = {}
	for _, g in ipairs(Config.Gelistirmeler) do
		t[g.Anahtar] = 0
	end
	return t
end

function Ekonomi.Seviye(gelistirmeler, anahtar)
	return (gelistirmeler and gelistirmeler[anahtar]) or 0
end

-- Bu seviyedeki bir geliştirmeyi almak kaç para? (MAX ise nil)
function Ekonomi.Fiyat(anahtar, mevcutSeviye)
	local g = gelistirmeTablosu[anahtar]
	if not g or mevcutSeviye >= g.MaxSeviye then
		return nil
	end
	return math.floor(g.TabanFiyat * g.Carpan ^ mevcutSeviye)
end

-- Bir tıklama kaç katlama yapar? (en fazla bir burgeri bitirecek kadar)
function Ekonomi.TikBasinaKatlama(gelistirmeler)
	return math.min(Config.KatlamaSayisi, 1 + Ekonomi.Seviye(gelistirmeler, "HizliEller"))
end

function Ekonomi.LezzetCarpani(gelistirmeler)
	return 1 + Ekonomi.Seviye(gelistirmeler, "Lezzet")
end

function Ekonomi.AltinSansi(gelistirmeler)
	return Config.AltinTabanSansi + Ekonomi.Seviye(gelistirmeler, "AltinSans") * Config.AltinSansArtisi
end

-- Çırak Aşçı kaç saniyede bir katlar? (hiç alınmadıysa nil)
function Ekonomi.OtoAralik(gelistirmeler)
	local sv = Ekonomi.Seviye(gelistirmeler, "OtoAsci")
	if sv <= 0 then
		return nil
	end
	return Config.OtoAsciIlkAralik * Config.OtoAsciHizlanma ^ (sv - 1)
end

-- Geliştirmenin şu anki etkisini oyuncuya yazı olarak anlatır.
function Ekonomi.EtkiYazisi(anahtar, seviye)
	if anahtar == "HizliEller" then
		return string.format("Tık başına %d katlama", math.min(Config.KatlamaSayisi, 1 + seviye))
	elseif anahtar == "Lezzet" then
		return string.format("Paket değeri x%d", 1 + seviye)
	elseif anahtar == "OtoAsci" then
		if seviye <= 0 then
			return "Henüz yok"
		end
		return string.format("%.1f saniyede 1 katlama", Config.OtoAsciIlkAralik * Config.OtoAsciHizlanma ^ (seviye - 1))
	elseif anahtar == "AltinSans" then
		return string.format("Altın burger ihtimali %%%d", math.floor((Config.AltinTabanSansi + seviye * Config.AltinSansArtisi) * 100 + 0.5))
	end
	return ""
end

--[[
	Yeni bir burgerin içinde ne olacağına karar verir.
	rastgele: 0 ile 1 arası sayı veren fonksiyon
	Döndürür: malzeme listesi (alttan üste, ekmekler hariç), taban değer, altın mı
]]
function Ekonomi.BurgerTarifi(rastgele, gelistirmeler)
	local altin = rastgele() < Ekonomi.AltinSansi(gelistirmeler)
	local liste = {}
	local deger = Config.PaketTabanDegeri
	for i, adim in ipairs(Config.Tarif) do
		if rastgele() < adim.Sans then
			local m = Config.Malzemeler[adim.Malzeme]
			if i == 1 and altin then
				m = Config.Malzemeler.AltinKofte
			end
			table.insert(liste, m)
			deger += m.Deger
		end
	end
	return liste, deger, altin
end

-- Paketlenince kazanılacak para
function Ekonomi.PaketDegeri(tabanDeger, gelistirmeler)
	return math.floor(tabanDeger * Ekonomi.LezzetCarpani(gelistirmeler))
end

function Ekonomi.UnvanIndex(toplamPaket)
	local idx = 1
	for i, u in ipairs(Config.Unvanlar) do
		if toplamPaket >= u.Esik then
			idx = i
		end
	end
	return idx
end

-- 1234 -> "1.2K", 5600000 -> "5.6M"
function Ekonomi.Kisalt(n)
	n = math.floor(n)
	local eksi = n < 0
	n = math.abs(n)
	local yazi
	if n < 1000 then
		yazi = tostring(n)
	else
		local ekler = { "K", "M", "B", "T", "Qa", "Qi" }
		local i = 0
		local x = n
		while x >= 1000 and i < #ekler do
			x /= 1000
			i += 1
		end
		if x >= 100 then
			yazi = string.format("%d%s", math.floor(x), ekler[i])
		else
			yazi = string.format("%.1f%s", math.floor(x * 10) / 10, ekler[i]):gsub("%.0", "")
		end
	end
	return (eksi and "-" or "") .. yazi
end

return Ekonomi
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Sunucu</string>
      </Properties>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">BurgerSunucu</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Sunucu
-- Katlama, paketleme, dükkan, unvanlar ve kayıt burada. Oyuncunun ekranı (client) sadece
-- "katla" ve "satın al" ister; her şeyi sunucu kontrol eder, böylece hile yapılamaz.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ortak = ReplicatedStorage:WaitForChild("Ortak")
local Config = require(Ortak:WaitForChild("Config"))
local Ekonomi = require(Ortak:WaitForChild("Ekonomi"))
local Dunya = require(script.Parent:WaitForChild("Dunya"))

----------------------------------------------------------------------
-- Uzak olaylar (RemoteEvent)
----------------------------------------------------------------------
local uzaklar = Instance.new("Folder")
uzaklar.Name = "Uzaklar"
local function olay(ad)
	local e = Instance.new("RemoteEvent")
	e.Name = ad
	e.Parent = uzaklar
	return e
end
local KatlaOlay = olay("Katla") -- oyuncu -> sunucu
local SatinAlOlay = olay("SatinAl") -- oyuncu -> sunucu (anahtar)
local DurumIsteOlay = olay("DurumIste") -- oyuncu -> sunucu (ekran açılınca durumu ister)
local DurumOlay = olay("Durum") -- sunucu -> oyuncu (durum tablosu)
-- sunucu -> herkes: kim, tezgah, kaç katlama, paketlendi mi, kazanç, altın mı, otomatik mi
local KatlandiOlay = olay("Katlandi")
local UnvanOlay = olay("YeniUnvan") -- sunucu -> herkes (kim, unvan sırası)
uzaklar.Parent = ReplicatedStorage

----------------------------------------------------------------------
-- Dünya
----------------------------------------------------------------------
local tezgahlar, ucanKlasor = Dunya.Kur()
local rastgele = Random.new()
local function zar()
	return rastgele:NextNumber()
end

----------------------------------------------------------------------
-- Kayıt (DataStore)
----------------------------------------------------------------------
local kayitDeposu = nil
do
	local ok, sonuc = pcall(function()
		return DataStoreService:GetDataStore(Config.KayitAnahtari)
	end)
	if ok then
		kayitDeposu = sonuc
	else
		warn("[Burger İmparatoru] Kayıt sistemi açılamadı: " .. tostring(sonuc))
	end
end

local function kayitAnahtari(oyuncu)
	return "oyuncu_" .. oyuncu.UserId
end

local function kayitYukle(oyuncu)
	if not kayitDeposu then
		return nil, false
	end
	for deneme = 1, 3 do
		local ok, sonuc = pcall(function()
			return kayitDeposu:GetAsync(kayitAnahtari(oyuncu))
		end)
		if ok then
			return sonuc, true
		end
		local mesaj = tostring(sonuc)
		warn("[Burger İmparatoru] Kayıt yüklenemedi (" .. deneme .. "): " .. mesaj)
		-- Studio'da API erişimi kapalıysa tekrar denemenin anlamı yok
		if string.find(mesaj, "StudioAccessToApisNotAllowed") or string.find(mesaj, "publish") then
			break
		end
		task.wait(1.5)
	end
	return nil, false
end

----------------------------------------------------------------------
-- Oyuncu verileri
----------------------------------------------------------------------
local veriler = {} -- [Player] = veri tablosu

local function sayiYap(x, varsayilan)
	if type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge then
		return x
	end
	return varsayilan
end

local function veriHazirla(ham)
	local gelistirme = Ekonomi.BosGelistirmeler()
	if type(ham) == "table" and type(ham.Gelistirme) == "table" then
		for _, g in ipairs(Config.Gelistirmeler) do
			local sv = math.floor(sayiYap(ham.Gelistirme[g.Anahtar], 0))
			gelistirme[g.Anahtar] = math.clamp(sv, 0, g.MaxSeviye)
		end
	end
	ham = type(ham) == "table" and ham or {}
	return {
		Para = math.max(0, math.floor(sayiYap(ham.Para, 0))),
		ToplamPaket = math.max(0, math.floor(sayiYap(ham.ToplamPaket, 0))),
		Gelistirme = gelistirme,
	}
end

local function kaydet(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.KayitAcik or not kayitDeposu then
		return
	end
	local paket = {
		Surum = 2,
		Para = v.Para,
		ToplamPaket = v.ToplamPaket,
		Gelistirme = v.Gelistirme,
	}
	for deneme = 1, 3 do
		local ok, hata = pcall(function()
			kayitDeposu:SetAsync(kayitAnahtari(oyuncu), paket, { oyuncu.UserId })
		end)
		if ok then
			return
		end
		warn("[Burger İmparatoru] Kayıt yapılamadı (" .. deneme .. "): " .. tostring(hata))
		task.wait(1)
	end
end

----------------------------------------------------------------------
-- Ekran güncellemeleri
----------------------------------------------------------------------
local function unvan(v)
	return Config.Unvanlar[Ekonomi.UnvanIndex(v.ToplamPaket)]
end

local function durumGonder(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir then
		return
	end
	local b = v.Burger
	DurumOlay:FireClient(oyuncu, {
		Para = v.Para,
		ToplamPaket = v.ToplamPaket,
		UnvanIndex = Ekonomi.UnvanIndex(v.ToplamPaket),
		Asama = b and b.Asama or 0,
		BurgerDegeri = b and Ekonomi.PaketDegeri(b.Deger, v.Gelistirme) or 0,
		Altin = b ~= nil and b.Altin,
		Gelistirme = v.Gelistirme,
		TezgahVar = v.Tezgah ~= nil,
		KayitAcik = v.KayitAcik,
	})
end

local function tabelaGuncelle(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Tezgah then
		return
	end
	local t = v.Tezgah
	t.TabelaBaslik.Text = "🍔 " .. oyuncu.DisplayName
	t.TabelaAlt.Text = string.format("%s paket • %s", Ekonomi.Kisalt(v.ToplamPaket), unvan(v).Ad)
end

local function skorGuncelle(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Skor then
		return
	end
	v.Skor.Paket.Value = v.ToplamPaket
	v.Skor.Para.Value = v.Para
	v.Skor.Unvan.Value = unvan(v).Ad
end

local function kafaYazisiGuncelle(oyuncu)
	local v = veriler[oyuncu]
	local karakter = oyuncu.Character
	if not v or not karakter then
		return
	end
	local kafa = karakter:FindFirstChild("Head")
	if not kafa then
		return
	end
	local bb = kafa:FindFirstChild("UnvanYazisi")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "UnvanYazisi"
		bb.Size = UDim2.new(6, 0, 1.1, 0)
		bb.StudsOffset = Vector3.new(0, 2.4, 0)
		bb.MaxDistance = 70
		bb.LightInfluence = 0
		local yazi = Instance.new("TextLabel")
		yazi.Name = "Yazi"
		yazi.BackgroundTransparency = 1
		yazi.Size = UDim2.fromScale(1, 1)
		yazi.Font = Enum.Font.FredokaOne
		yazi.TextScaled = true
		yazi.TextStrokeTransparency = 0.2
		yazi.Parent = bb
		bb.Parent = kafa
	end
	local u = unvan(v)
	bb.Yazi.Text = "👑 " .. u.Ad
	bb.Yazi.TextColor3 = u.Renk
end

----------------------------------------------------------------------
-- Burger ve kağıt
----------------------------------------------------------------------
local KATLAMA = TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PATLAMA = TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local UCUS = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local SARMA_SURESI = 0.17 -- son kanatlar katlanınca bu kadar sonra burger pakete dönüşür
local BEKLEME = 0.2 -- paket tezgahta bu kadar durup kuleye uçar
local KAGIT_PARCALARI = { "Orta", "Sol", "Sag", "On", "Arka" }

-- gecikme: önceki paket tezgahtan kalkana kadar yeni burger yukarıda bekler
local function yeniBurger(oyuncu, gecikme)
	local v = veriler[oyuncu]
	if not v or not v.Tezgah then
		return
	end
	local t = v.Tezgah
	local liste, deger, altin = Ekonomi.BurgerTarifi(zar, v.Gelistirme)

	local klasor = Instance.new("Folder")
	klasor.Name = "Burger"
	local parcalar = {}

	-- Burger, kağıdın ortasında
	local taban = t.KagitCFrame * CFrame.new(0, Dunya.KagitKalinligi(), 0)
	local cf = taban
	local katlar = { Config.AltEkmek }
	for _, m in ipairs(liste) do
		table.insert(katlar, m)
	end
	table.insert(katlar, Config.UstEkmek)
	local yukseklik = 0
	for _, m in ipairs(katlar) do
		local yeni, k = Dunya.KatYap(m, cf, 1, rastgele)
		for _, p in ipairs(yeni) do
			table.insert(parcalar, p)
		end
		cf = cf * CFrame.new(0, k, 0)
		yukseklik += k
	end

	local kagit = Dunya.KagitYap(t.KagitCFrame, altin, yukseklik)
	for _, ad in ipairs(KAGIT_PARCALARI) do
		table.insert(parcalar, kagit[ad])
	end

	-- Yukarıdan düşerek gelsin
	local dusme = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, gecikme or 0)
	for _, p in ipairs(parcalar) do
		local hedef = p.CFrame
		p.CFrame = hedef + Vector3.new(0, 6, 0)
		p.Parent = klasor
		TweenService:Create(p, dusme, { CFrame = hedef }):Play()
	end
	klasor.Parent = t.PaketKlasoru

	v.Burger = { Asama = 0, Deger = deger, Altin = altin, Kagit = kagit, Klasor = klasor, Yukseklik = yukseklik }
end

local function modelParcalari(model)
	local liste = {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			table.insert(liste, p)
		end
	end
	return liste
end

local function kuleyiBosalt(t)
	t.Yigin.Nesil += 1
	for _, paket in pairs(t.Yigin.Paketler) do
		for _, p in ipairs(modelParcalari(paket)) do
			TweenService:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = p.CFrame + Vector3.new(0, 25, 0),
			}):Play()
		end
		task.delay(0.62, function()
			paket:Destroy()
		end)
	end
	t.Yigin.Paketler = {}
end

-- Kağıda sarılan burgeri pakete çevirir, kuleye uçurur, yeni burger getirir
local function paketle(oyuncu)
	local v = veriler[oyuncu]
	local t = v.Tezgah
	local b = v.Burger

	-- Kuledeki yerini şimdiden ayır
	local y = t.Yigin
	if y.Sayac >= Config.YiginEnFazla then
		kuleyiBosalt(t)
		y.Sayac = 0
	end
	y.Sayac += 1
	local sira = y.Sayac
	local nesil = y.Nesil
	local boy = Dunya.PaketBoyu()
	local hedef = t.YiginCFrame
		* CFrame.new(0, (sira - 1) * Dunya.YiginAdimi() + boy.Y / 2, 0)
		* CFrame.Angles(0, math.rad(rastgele:NextNumber(-25, 25)), 0)

	local klasor = b.Klasor
	local altin = b.Altin
	local merkez = t.KagitCFrame * CFrame.new(0, boy.Y / 2, 0)
	klasor.Parent = ucanKlasor

	task.delay(SARMA_SURESI, function()
		-- Kanatlar kapandı: kağıt + burger yerine sarılmış paket "pof" diye belirir
		klasor:Destroy()
		local paket = Dunya.PaketliBurger(merkez, altin)
		local govde = paket.PrimaryPart
		local tamBoy = govde.Size
		govde.Size = tamBoy * 0.75
		paket.Parent = ucanKlasor
		TweenService:Create(govde, PATLAMA, { Size = tamBoy }):Play()

		task.delay(BEKLEME, function()
			if not paket.Parent then
				return
			end
			for _, p in ipairs(modelParcalari(paket)) do
				local goreli = merkez:ToObjectSpace(p.CFrame)
				TweenService:Create(p, UCUS, { CFrame = hedef * goreli }):Play()
			end
			task.delay(UCUS.Time + 0.02, function()
				if t.Yigin.Nesil ~= nesil or not paket.Parent then
					paket:Destroy() -- bu arada kule boşaltıldı ya da oyuncu çıktı
					return
				end
				paket.Parent = t.YiginKlasoru
				t.Yigin.Paketler[sira] = paket
			end)
		end)
	end)

	yeniBurger(oyuncu, SARMA_SURESI + BEKLEME + 0.05)
end

local function unvanKontrol(oyuncu, eskiIndex)
	local v = veriler[oyuncu]
	local yeniIndex = Ekonomi.UnvanIndex(v.ToplamPaket)
	if yeniIndex > eskiIndex then
		UnvanOlay:FireAllClients(oyuncu, yeniIndex)
		kafaYazisiGuncelle(oyuncu)
	end
end

-- adet kadar katlama yapar (burger paketlenince durur)
local function katla(oyuncu, adet, otomatik)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or not v.Tezgah or not v.Burger then
		return
	end
	local b = v.Burger
	local eklenen = 0
	for _ = 1, adet do
		if b.Asama >= Config.KatlamaSayisi then
			break
		end
		b.Asama += 1
		eklenen += 1
	end
	if eklenen == 0 then
		return
	end

	-- Kağıdın kanatlarını burgerin üstüne katla
	local poz = Dunya.KagitPozu(v.Tezgah.KagitCFrame, b.Asama, b.Yukseklik)
	for _, ad in ipairs(KAGIT_PARCALARI) do
		local p = b.Kagit[ad]
		if p.CFrame ~= poz[ad] then
			TweenService:Create(p, KATLAMA, { CFrame = poz[ad] }):Play()
		end
	end

	local paketlendi = b.Asama >= Config.KatlamaSayisi
	local kazanc = 0
	local altin = b.Altin
	if paketlendi then
		local eskiUnvan = Ekonomi.UnvanIndex(v.ToplamPaket)
		kazanc = Ekonomi.PaketDegeri(b.Deger, v.Gelistirme)
		v.Para += kazanc
		v.ToplamPaket += 1
		paketle(oyuncu)
		tabelaGuncelle(oyuncu)
		skorGuncelle(oyuncu)
		unvanKontrol(oyuncu, eskiUnvan)
	end

	KatlandiOlay:FireAllClients(oyuncu, v.Tezgah.Index, eklenen, paketlendi, kazanc, altin, otomatik)
	durumGonder(oyuncu)
end

----------------------------------------------------------------------
-- Tezgah dağıtımı
----------------------------------------------------------------------
local function bosTezgahAl(oyuncu)
	for _, t in ipairs(tezgahlar) do
		if t.Sahip == nil then
			t.Sahip = oyuncu
			return t
		end
	end
	return nil
end

local function tezgahiBirak(t)
	t.Sahip = nil
	t.PaketKlasoru:ClearAllChildren()
	t.YiginKlasoru:ClearAllChildren()
	t.Yigin = { Paketler = {}, Nesil = t.Yigin.Nesil + 1, Sayac = 0 }
	t.TabelaBaslik.Text = "🍔 Boş Tezgah"
	t.TabelaAlt.Text = "Gel burger katla!"
end

local function tezgahaIsinla(oyuncu)
	local v = veriler[oyuncu]
	local karakter = oyuncu.Character
	if not v or not v.Tezgah or not karakter then
		return
	end
	local kok = karakter:WaitForChild("HumanoidRootPart", 5)
	if kok then
		task.wait(0.1)
		karakter:PivotTo(v.Tezgah.OyuncuCFrame)
	end
end

----------------------------------------------------------------------
-- Oyuncu girişi / çıkışı
----------------------------------------------------------------------
local function karakterGeldi(oyuncu, karakter)
	task.spawn(tezgahaIsinla, oyuncu)
	karakter:WaitForChild("Head", 5)
	kafaYazisiGuncelle(oyuncu)
end

local function oyuncuGeldi(oyuncu)
	if veriler[oyuncu] then
		return
	end
	local v = {
		Hazir = false,
		KayitAcik = false,
		Para = 0,
		ToplamPaket = 0,
		Gelistirme = Ekonomi.BosGelistirmeler(),
		Burger = nil,
		Jeton = 4,
		SonJeton = os.clock(),
		OtoBirikim = 0,
	}
	veriler[oyuncu] = v

	-- Skor tablosu (sağ üstteki liste)
	local skorlar = Instance.new("Folder")
	skorlar.Name = "leaderstats"
	local paketDeger = Instance.new("IntValue")
	paketDeger.Name = "Paket"
	paketDeger.Parent = skorlar
	local paraDeger = Instance.new("IntValue")
	paraDeger.Name = "Para"
	paraDeger.Parent = skorlar
	local unvanDeger = Instance.new("StringValue")
	unvanDeger.Name = "Unvan"
	unvanDeger.Value = Config.Unvanlar[1].Ad
	unvanDeger.Parent = skorlar
	skorlar.Parent = oyuncu
	v.Skor = { Paket = paketDeger, Para = paraDeger, Unvan = unvanDeger }

	v.Tezgah = bosTezgahAl(oyuncu)

	oyuncu.CharacterAdded:Connect(function(karakter)
		karakterGeldi(oyuncu, karakter)
	end)
	if oyuncu.Character then
		task.spawn(karakterGeldi, oyuncu, oyuncu.Character)
	end

	local ham, basarili = kayitYukle(oyuncu)
	if oyuncu.Parent == nil or veriler[oyuncu] ~= v then
		return -- yüklenirken çıktı
	end
	local hazir = veriHazirla(ham)
	v.Para = hazir.Para
	v.ToplamPaket = hazir.ToplamPaket
	v.Gelistirme = hazir.Gelistirme
	v.KayitAcik = basarili
	v.Hazir = true

	yeniBurger(oyuncu)
	tabelaGuncelle(oyuncu)
	skorGuncelle(oyuncu)
	kafaYazisiGuncelle(oyuncu)
	durumGonder(oyuncu)
end

local function oyuncuGitti(oyuncu)
	local v = veriler[oyuncu]
	if not v then
		return
	end
	if v.Hazir then
		kaydet(oyuncu)
	end
	if v.Tezgah then
		tezgahiBirak(v.Tezgah)
	end
	veriler[oyuncu] = nil

	-- Tezgahsız bekleyen biri varsa ona ver
	for bekleyen, bv in pairs(veriler) do
		if bv.Tezgah == nil then
			local t = bosTezgahAl(bekleyen)
			if not t then
				break
			end
			bv.Tezgah = t
			if bv.Hazir then
				yeniBurger(bekleyen)
				tabelaGuncelle(bekleyen)
				durumGonder(bekleyen)
			end
			task.spawn(tezgahaIsinla, bekleyen)
		end
	end
end

Players.PlayerAdded:Connect(oyuncuGeldi)
Players.PlayerRemoving:Connect(oyuncuGitti)
for _, oyuncu in ipairs(Players:GetPlayers()) do
	task.spawn(oyuncuGeldi, oyuncu)
end

----------------------------------------------------------------------
-- Oyuncu istekleri
----------------------------------------------------------------------
-- Hile koruması: saniyede en fazla (1 / KatlamaBeklemesi) tıklama, küçük patlamalara izin var
local JETON_KAPASITE = 4
local function jetonHarca(v)
	local simdi = os.clock()
	local dolum = (simdi - v.SonJeton) / Config.KatlamaBeklemesi
	v.SonJeton = simdi
	v.Jeton = math.min(JETON_KAPASITE, v.Jeton + dolum)
	if v.Jeton < 1 then
		return false
	end
	v.Jeton -= 1
	return true
end

KatlaOlay.OnServerEvent:Connect(function(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or not v.Tezgah then
		return
	end
	if not jetonHarca(v) then
		durumGonder(oyuncu) -- ekran fazladan saydıysa düzelsin
		return
	end
	katla(oyuncu, Ekonomi.TikBasinaKatlama(v.Gelistirme), false)
end)

DurumIsteOlay.OnServerEvent:Connect(function(oyuncu)
	durumGonder(oyuncu)
end)

SatinAlOlay.OnServerEvent:Connect(function(oyuncu, anahtar)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or type(anahtar) ~= "string" then
		return
	end
	local g = Ekonomi.GelistirmeBul(anahtar)
	if not g then
		return
	end
	local seviye = v.Gelistirme[anahtar] or 0
	local fiyat = Ekonomi.Fiyat(anahtar, seviye)
	if not fiyat or v.Para < fiyat then
		durumGonder(oyuncu)
		return
	end
	v.Para -= fiyat
	v.Gelistirme[anahtar] = seviye + 1
	skorGuncelle(oyuncu)
	durumGonder(oyuncu)
end)

----------------------------------------------------------------------
-- Çırak Aşçı (otomatik katlama)
----------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	for oyuncu, v in pairs(veriler) do
		if v.Hazir and v.Tezgah and v.Burger then
			local aralik = Ekonomi.OtoAralik(v.Gelistirme)
			if aralik then
				v.OtoBirikim += dt
				if v.OtoBirikim >= aralik then
					v.OtoBirikim -= aralik
					katla(oyuncu, 1, true)
				end
			end
		end
	end
end)

----------------------------------------------------------------------
-- Otomatik kayıt
----------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(60)
		for oyuncu in pairs(veriler) do
			task.spawn(kaydet, oyuncu)
		end
	end
end)

game:BindToClose(function()
	local bekleyen = 0
	for oyuncu, v in pairs(veriler) do
		if v.Hazir and v.KayitAcik then
			bekleyen += 1
			task.spawn(function()
				kaydet(oyuncu)
				bekleyen -= 1
			end)
		end
	end
	local baslangic = os.clock()
	while bekleyen > 0 and os.clock() - baslangic < 25 do
		task.wait(0.1)
	end
end)

print("[Burger İmparatoru] Sunucu hazır! Tezgah sayısı: " .. #tezgahlar)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Dunya</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Dünyayı (mutfak, tezgahlar, dev burger heykeli) kodla kurar
-- ve burger katlarını (köfte, peynir, marul...) parça parça yapar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Ortak"):WaitForChild("Config"))

local Dunya = {}

local ZEMIN_Y = 0.2 -- karo zeminin üstü
local TEZGAH_YUKSEKLIK = 3.4
local YUKARI = Vector3.new(0, 1, 0)

local TEZGAH_RENKLERI = {
	Color3.fromRGB(255, 99, 99),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(255, 220, 70),
	Color3.fromRGB(120, 210, 110),
	Color3.fromRGB(80, 200, 200),
	Color3.fromRGB(90, 150, 255),
	Color3.fromRGB(170, 120, 255),
	Color3.fromRGB(255, 120, 200),
}

local function parca(ozellikler)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(ozellikler) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	if ozellikler.Parent then
		p.Parent = ozellikler.Parent
	end
	return p
end

local function malzemeEnum(ad)
	local ok, deger = pcall(function()
		return Enum.Material[ad]
	end)
	if ok and deger then
		return deger
	end
	return Enum.Material.SmoothPlastic
end

-- Dik duran yuvarlak disk. Roblox'ta silindirin ekseni X yönündedir, o yüzden 90 derece çeviriyoruz.
local function disk(merkez, kalinlik, cap, renk, malzeme)
	return parca({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(kalinlik, cap, cap),
		CFrame = merkez * CFrame.Angles(0, 0, math.rad(90)),
		Color = renk,
		Material = malzeme or Enum.Material.SmoothPlastic,
	})
end

local function burgerParcasiAyarla(p)
	p.CanCollide = false
	p.CanTouch = false
	p.CastShadow = true
end

--[[
	Bir burger katı yapar.
	tur: Config.Malzemeler içinden bir malzeme, Config.AltEkmek ya da Config.UstEkmek
	altCFrame: katın ALT yüzünün ortası (yukarı bakan)
	olcek: büyütme (heykel için 3 gibi)
	Döndürür: parçalar listesi (yerlerine konmuş), katın yüksekliği
]]
function Dunya.KatYap(tur, altCFrame, olcek, rastgele)
	olcek = olcek or 1
	rastgele = rastgele or Random.new()
	local parcalar = {}
	local k = tur.Kalinlik * olcek
	local cap = tur.Cap * olcek
	local donus = CFrame.Angles(0, rastgele:NextNumber(0, math.pi * 2), 0)

	if tur == Config.UstEkmek then
		-- Altta yan yüzü düz bir silindir, üstünde kubbe. Kubbenin alt yarısı silindirin içinde saklı.
		local tabanK = k * 0.45
		local kubbeK = k - tabanK
		table.insert(parcalar, disk(altCFrame * CFrame.new(0, tabanK / 2, 0), tabanK, cap, tur.Renk))
		local kubbe = parca({
			Size = Vector3.new(cap, kubbeK * 2, cap),
			CFrame = altCFrame * CFrame.new(0, tabanK, 0),
			Color = tur.Renk,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = kubbe
		table.insert(parcalar, kubbe)
		-- Susamlar
		for i = 1, 9 do
			local aci = rastgele:NextNumber(0, math.pi * 2)
			local f = rastgele:NextNumber(0.15, 0.75)
			local yukseklik = kubbeK * math.sqrt(1 - f * f)
			local x = math.cos(aci) * f * cap / 2
			local z = math.sin(aci) * f * cap / 2
			table.insert(
				parcalar,
				parca({
					Size = Vector3.new(0.32, 0.12, 0.18) * olcek,
					CFrame = altCFrame * CFrame.new(x, tabanK + yukseklik, z) * CFrame.Angles(0, aci, 0),
					Color = Color3.fromRGB(255, 248, 225),
				})
			)
		end
	elseif tur.Sekil == "kare" then
		-- Peynir: köşeleri taşan ince kare dilim
		table.insert(
			parcalar,
			parca({
				Size = Vector3.new(cap * 0.78, k, cap * 0.78),
				CFrame = altCFrame * donus * CFrame.new(0, k / 2, 0),
				Color = tur.Renk,
				Material = malzemeEnum(tur.Malzeme),
			})
		)
	elseif tur.Sekil == "dalga" then
		-- Marul: disk + kenardan sarkan yapraklar
		table.insert(parcalar, disk(altCFrame * CFrame.new(0, k / 2, 0), k, cap * 0.92, tur.Renk, malzemeEnum(tur.Malzeme)))
		local yaprakSayisi = 5
		for i = 1, yaprakSayisi do
			local aci = (i / yaprakSayisi) * math.pi * 2 + rastgele:NextNumber(-0.3, 0.3)
			local yaprak = parca({
				Size = Vector3.new(1.3, k * 0.7, 1.1) * Vector3.new(olcek, 1, olcek),
				CFrame = altCFrame
					* CFrame.Angles(0, aci, 0)
					* CFrame.new(cap * 0.42, k * 0.35, 0)
					* CFrame.Angles(0, 0, math.rad(-18)),
				Color = tur.Renk:Lerp(Color3.new(1, 1, 1), 0.12),
				Material = malzemeEnum(tur.Malzeme),
			})
			table.insert(parcalar, yaprak)
		end
	else
		local p = disk(altCFrame * CFrame.new(0, k / 2, 0), k, cap, tur.Renk, malzemeEnum(tur.Malzeme or "SmoothPlastic"))
		if tur.Altin then
			p.Reflectance = 0.25
			local parilti = Instance.new("Sparkles")
			parilti.SparkleColor = Color3.fromRGB(255, 230, 120)
			parilti.Parent = p
		end
		table.insert(parcalar, p)
	end

	for _, p in ipairs(parcalar) do
		burgerParcasiAyarla(p)
	end
	return parcalar, k
end

local function konfetiYap(tabak)
	local ek = Instance.new("Attachment")
	ek.Name = "KonfetiNoktasi"
	ek.Position = Vector3.new(0, 0, 0)
	ek.Parent = tabak

	local e = Instance.new("ParticleEmitter")
	e.Name = "Konfeti"
	e.Enabled = false
	e.Rate = 0
	e.Lifetime = NumberRange.new(1.4, 2.4)
	e.Speed = NumberRange.new(22, 34)
	e.SpreadAngle = Vector2.new(35, 35)
	e.Acceleration = Vector3.new(0, -35, 0)
	e.Drag = 1.5
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-300, 300)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 0.25),
	})
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 220, 110)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 110, 255)),
	})
	e.LightEmission = 0.3
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = ek
	return e
end

local function tabelaYap(model, cf, renk)
	local tutucu = parca({
		Name = "TabelaNoktasi",
		Size = Vector3.new(1, 1, 1),
		CFrame = cf,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = model,
	})
	local bb = Instance.new("BillboardGui")
	bb.Name = "Tabela"
	bb.Size = UDim2.new(9, 0, 2.6, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = tutucu

	local cerceve = Instance.new("Frame")
	cerceve.Size = UDim2.fromScale(1, 1)
	cerceve.BackgroundColor3 = Color3.fromRGB(35, 25, 20)
	cerceve.BackgroundTransparency = 0.15
	cerceve.Parent = bb
	local kose = Instance.new("UICorner")
	kose.CornerRadius = UDim.new(0.25, 0)
	kose.Parent = cerceve
	local kenar = Instance.new("UIStroke")
	kenar.Color = renk
	kenar.Thickness = 3
	kenar.Parent = cerceve

	local baslik = Instance.new("TextLabel")
	baslik.Name = "Baslik"
	baslik.BackgroundTransparency = 1
	baslik.Size = UDim2.fromScale(1, 0.55)
	baslik.Font = Enum.Font.FredokaOne
	baslik.TextScaled = true
	baslik.TextColor3 = Color3.new(1, 1, 1)
	baslik.Text = "🍔 Boş Tezgah"
	baslik.Parent = cerceve

	local alt = Instance.new("TextLabel")
	alt.Name = "Alt"
	alt.BackgroundTransparency = 1
	alt.Position = UDim2.fromScale(0, 0.55)
	alt.Size = UDim2.fromScale(1, 0.4)
	alt.Font = Enum.Font.FredokaOne
	alt.TextScaled = true
	alt.TextColor3 = renk
	alt.Text = "Gel burger katla!"
	alt.Parent = cerceve

	return baslik, alt
end

local TEZGAH_EN = 14
local TEZGAH_DERIN = 11
local KAGIT_K = 0.06 -- kağıt kalınlığı
local KAGIT_ORTA = 5.4 -- burgerin oturduğu orta kare
local KAGIT_KANAT = 2.8 -- dört yandaki katlanan kanatlar
local PAKET_BOYU = Vector3.new(5.8, 3.4, 5.8) -- kağıda sarılmış burger
local YIGIN_ADIM = 3.15 -- kulede paketler biraz iç içe dursun

local function tezgahYap(i, adet, klasor)
	local aci = (i - 1) / adet * math.pi * 2
	local disari = Vector3.new(math.cos(aci), 0, math.sin(aci))
	local merkez = disari * Config.TezgahYaricapi
	local renk = TEZGAH_RENKLERI[(i - 1) % #TEZGAH_RENKLERI + 1]

	local model = Instance.new("Model")
	model.Name = "Tezgah" .. i

	-- Tezgahın ön yüzü (LookVector) oyuncunun durduğu yere, yani dışarı bakar
	local ortaY = ZEMIN_Y + TEZGAH_YUKSEKLIK / 2
	local tezgahCF = CFrame.lookAt(merkez + YUKARI * ortaY, merkez + disari * 10 + YUKARI * ortaY)
	local donus = tezgahCF - tezgahCF.Position

	parca({
		Name = "Govde",
		Size = Vector3.new(TEZGAH_EN, TEZGAH_YUKSEKLIK, TEZGAH_DERIN),
		CFrame = tezgahCF,
		Color = Color3.fromRGB(150, 95, 55),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	-- Önde renkli şerit
	parca({
		Name = "Serit",
		Size = Vector3.new(TEZGAH_EN + 0.05, 0.7, 0.2),
		CFrame = tezgahCF * CFrame.new(0, 0.6, -TEZGAH_DERIN / 2 - 0.05),
		Color = renk,
		Parent = model,
	})
	parca({
		Name = "Ust",
		Size = Vector3.new(TEZGAH_EN + 0.6, 0.3, TEZGAH_DERIN + 0.6),
		CFrame = tezgahCF * CFrame.new(0, TEZGAH_YUKSEKLIK / 2 + 0.15, 0),
		Color = Color3.fromRGB(245, 245, 240),
		Material = Enum.Material.Marble,
		Parent = model,
	})

	-- Burger kağıdının durduğu renkli tepsi
	local tezgahUstY = ZEMIN_Y + TEZGAH_YUKSEKLIK + 0.3
	local tepsiK = 0.12
	local tabak = parca({
		Name = "Tabak",
		Size = Vector3.new(7.4, tepsiK, 7.4),
		CFrame = CFrame.new(merkez + YUKARI * (tezgahUstY + tepsiK / 2)) * donus,
		Color = renk,
		Parent = model,
	})
	local konfeti = konfetiYap(tabak)

	-- Oyuncunun durduğu renkli yuvarlak
	local oyuncuNokta = merkez + disari * (TEZGAH_DERIN / 2 + 5)
	local yer = disk(CFrame.new(oyuncuNokta + YUKARI * (ZEMIN_Y + 0.05)), 0.1, 5, renk, Enum.Material.Neon)
	yer.Name = "OyuncuYeri"
	yer.CanCollide = false
	yer.Transparency = 0.35
	yer.Parent = model

	-- Paket kulesinin duracağı yer (oyuncunun sağında, yerde)
	local yiginCF = CFrame.new(merkez + YUKARI * ZEMIN_Y) * donus * CFrame.new(-(TEZGAH_EN / 2 + 3.6), 0, 0)
	local yiginYeri = parca({
		Name = "YiginYeri",
		Size = Vector3.new(PAKET_BOYU.X + 0.8, 0.1, PAKET_BOYU.Z + 0.8),
		CFrame = yiginCF * CFrame.new(0, 0.05, 0),
		Color = renk:Lerp(Color3.new(1, 1, 1), 0.4),
		CanCollide = false,
		Parent = model,
	})

	local baslik, alt = tabelaYap(model, tezgahCF * CFrame.new(0, -0.1, -TEZGAH_DERIN / 2 - 0.2), renk)

	local paket = Instance.new("Folder")
	paket.Name = "Paket"
	paket.Parent = model
	local yigin = Instance.new("Folder")
	yigin.Name = "Yigin"
	yigin.Parent = model

	model.PrimaryPart = model:FindFirstChild("Govde")
	model.Parent = klasor

	return {
		Index = i,
		Model = model,
		Tabak = tabak,
		PaketKlasoru = paket,
		YiginKlasoru = yigin,
		Konfeti = konfeti,
		Renk = renk,
		-- Kağıdın ortası: tepsinin üstü, ön yüzü oyuncuya bakar
		KagitCFrame = CFrame.new(merkez + YUKARI * (tezgahUstY + tepsiK)) * donus,
		YiginCFrame = yiginCF,
		OyuncuCFrame = CFrame.lookAt(oyuncuNokta + YUKARI * (ZEMIN_Y + 3), merkez + YUKARI * (ZEMIN_Y + 3)),
		TabelaBaslik = baslik,
		TabelaAlt = alt,
		Yigin = { Paketler = {}, Nesil = 0, Sayac = 0 },
		Sahip = nil,
	}
end

----------------------------------------------------------------------
-- Burger kağıdı ve paket
----------------------------------------------------------------------

local function etiketYap(parcaNesnesi, yuz, altin)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Etiket"
	sg.Face = yuz
	sg.LightInfluence = 0.3
	sg.CanvasSize = Vector2.new(200, 200)
	sg.Parent = parcaNesnesi
	local daire = Instance.new("Frame")
	daire.AnchorPoint = Vector2.new(0.5, 0.5)
	daire.Position = UDim2.fromScale(0.5, 0.5)
	daire.Size = UDim2.fromScale(0.9, 0.9)
	daire.BackgroundColor3 = altin and Color3.fromRGB(255, 240, 150) or Config.KagitBaskiRengi
	daire.Parent = sg
	local kose = Instance.new("UICorner")
	kose.CornerRadius = UDim.new(1, 0)
	kose.Parent = daire
	local yazi = Instance.new("TextLabel")
	yazi.BackgroundTransparency = 1
	yazi.Size = UDim2.fromScale(1, 1)
	yazi.TextScaled = true
	yazi.Font = Enum.Font.FredokaOne
	yazi.Text = altin and "👑" or "🍔"
	yazi.Parent = daire
	return sg
end

-- Kağıdın üstündeki kırmızı çerçeve ve altındaki (katlanınca görünen) baskı
local function kagitBaskisi(p, altin, ust, alt)
	local baski = altin and Color3.fromRGB(190, 120, 0) or Config.KagitBaskiRengi
	if ust then
		local sg = Instance.new("SurfaceGui")
		sg.Name = "Cerceve"
		sg.Face = Enum.NormalId.Top
		sg.LightInfluence = 0.5
		sg.PixelsPerStud = 30
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.Parent = p
		local f = Instance.new("Frame")
		f.BackgroundTransparency = 1
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.new(1, -16, 1, -16)
		f.Parent = sg
		local c = Instance.new("UIStroke")
		c.Color = baski
		c.Thickness = 5
		c.Parent = f
	end
	if alt then
		local sg = Instance.new("SurfaceGui")
		sg.Name = "Baski"
		sg.Face = Enum.NormalId.Bottom
		sg.LightInfluence = 0.5
		sg.PixelsPerStud = 30
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.Parent = p
		local yazi = Instance.new("TextLabel")
		yazi.BackgroundTransparency = 1
		yazi.Size = UDim2.fromScale(1, 1)
		yazi.TextScaled = true
		yazi.Font = Enum.Font.FredokaOne
		yazi.TextColor3 = baski
		yazi.Text = "👑"
		yazi.Parent = sg
	end
end

-- Kağıdın her parçasının, verilen aşamadaki yeri.
-- 0 = kağıt açık, 1 = sol kanat burgerin üstünde, 2 = sağ da, 3 = ön ve arka da (paket!)
-- yukseklik: burgerin kağıttan tepesine kadar boyu
function Dunya.KagitPozu(taban, asama, yukseklik)
	local yari = KAGIT_ORTA / 2
	local kenar = yari + KAGIT_KANAT / 2
	local y = KAGIT_K / 2
	local h = KAGIT_K + yukseklik
	local sark = math.rad(14) -- üstteki kanatlar kenara doğru biraz sarksın
	local poz = {
		Orta = taban * CFrame.new(0, y, 0),
		Sol = taban * CFrame.new(-kenar, y, 0),
		Sag = taban * CFrame.new(kenar, y, 0),
		On = taban * CFrame.new(0, y, -kenar),
		Arka = taban * CFrame.new(0, y, kenar),
	}
	if asama >= 1 then
		poz.Sol = taban * CFrame.new(-yari / 2 + 0.1, h + 0.05, 0) * CFrame.Angles(0, 0, math.pi + sark)
	end
	if asama >= 2 then
		poz.Sag = taban * CFrame.new(yari / 2 - 0.1, h + 0.11, 0) * CFrame.Angles(0, 0, math.pi - sark)
	end
	if asama >= 3 then
		poz.On = taban * CFrame.new(0, h + 0.17, -yari / 2 + 0.1) * CFrame.Angles(math.pi - sark, 0, 0)
		poz.Arka = taban * CFrame.new(0, h + 0.23, yari / 2 - 0.1) * CFrame.Angles(math.pi + sark, 0, 0)
	end
	return poz
end

-- Açık bir burger kağıdı yapar (parçalar yerinde ama Parent'ı yok)
function Dunya.KagitYap(taban, altin, yukseklik)
	local poz = Dunya.KagitPozu(taban, 0, yukseklik)
	local boyut = {
		Orta = Vector3.new(KAGIT_ORTA, KAGIT_K, KAGIT_ORTA),
		Sol = Vector3.new(KAGIT_KANAT, KAGIT_K, KAGIT_ORTA),
		Sag = Vector3.new(KAGIT_KANAT, KAGIT_K, KAGIT_ORTA),
		On = Vector3.new(KAGIT_ORTA, KAGIT_K, KAGIT_KANAT),
		Arka = Vector3.new(KAGIT_ORTA, KAGIT_K, KAGIT_KANAT),
	}
	local kagit = {}
	for ad, cf in pairs(poz) do
		local p = parca({
			Name = "Kagit" .. ad,
			Size = boyut[ad],
			CFrame = cf,
			Color = altin and Config.AltinKagitRengi or Config.KagitRengi,
			Material = altin and Enum.Material.Foil or Enum.Material.Fabric,
			CanCollide = false,
			CanTouch = false,
		})
		kagitBaskisi(p, altin, true, ad ~= "Orta")
		kagit[ad] = p
	end
	return kagit
end

function Dunya.KagitKalinligi()
	return KAGIT_K
end

-- Kağıda sarılmış burger (kulede durur). cf: paketin ortası
function Dunya.PaketliBurger(cf, altin)
	local model = Instance.new("Model")
	model.Name = "PaketliBurger"
	local govde = parca({
		Name = "Govde",
		Size = PAKET_BOYU,
		CFrame = cf,
		Color = altin and Config.AltinKagitRengi or Config.KagitRengi,
		Material = altin and Enum.Material.Foil or Enum.Material.Fabric,
		CanCollide = false,
		CanTouch = false,
		Parent = model,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = govde
	-- Kağıdın katlandığı yerler: üstte çapraz iki kırmızı şerit
	local baski = altin and Color3.fromRGB(190, 120, 0) or Config.KagitBaskiRengi
	for i = 0, 1 do
		parca({
			Name = "Serit" .. i,
			Size = Vector3.new(PAKET_BOYU.X * 0.42, 0.08, 0.35),
			CFrame = cf * CFrame.new(0, PAKET_BOYU.Y / 2 - 0.12, 0) * CFrame.Angles(0, math.rad(45 + 90 * i), 0),
			Color = baski,
			CanCollide = false,
			CanTouch = false,
			Parent = model,
		})
	end
	local etiket = parca({
		Name = "Etiket",
		Size = Vector3.new(1.8, 0.05, 1.8),
		CFrame = cf * CFrame.new(0, PAKET_BOYU.Y / 2 + 0.01, 0),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Parent = model,
	})
	etiketYap(etiket, Enum.NormalId.Top, altin)
	model.PrimaryPart = govde
	return model
end

function Dunya.PaketBoyu()
	return PAKET_BOYU
end

function Dunya.YiginAdimi()
	return YIGIN_ADIM
end

local function zeminYap(klasor)
	local karo = 8
	local adet = 17
	local bas = -(adet * karo) / 2 + karo / 2
	for x = 0, adet - 1 do
		for z = 0, adet - 1 do
			local kirmizi = (x + z) % 2 == 0
			parca({
				Name = "Karo",
				Size = Vector3.new(karo, ZEMIN_Y, karo),
				CFrame = CFrame.new(bas + x * karo, ZEMIN_Y / 2, bas + z * karo),
				Color = kirmizi and Color3.fromRGB(215, 60, 55) or Color3.fromRGB(250, 242, 225),
				Parent = klasor,
			})
		end
	end
end

local function heykelYap(klasor)
	local model = Instance.new("Model")
	model.Name = "DevBurgerHeykeli"

	local kaideK = 3
	local kaide = disk(CFrame.new(0, ZEMIN_Y + kaideK / 2, 0), kaideK, 18, Color3.fromRGB(245, 240, 235), Enum.Material.Marble)
	kaide.Name = "Kaide"
	kaide.Parent = model
	local serit = disk(CFrame.new(0, ZEMIN_Y + kaideK - 0.3, 0), 0.5, 18.4, Color3.fromRGB(255, 200, 40), Enum.Material.Foil)
	serit.Parent = model

	local olcek = 3
	local rastgele = Random.new(42)
	local cf = CFrame.new(0, ZEMIN_Y + kaideK, 0)
	local function ekle(tur)
		local parcalar, k = Dunya.KatYap(tur, cf, olcek, rastgele)
		for _, p in ipairs(parcalar) do
			p.CanCollide = true
			p.Parent = model
		end
		cf = cf * CFrame.new(0, k, 0)
	end
	local M = Config.Malzemeler
	ekle(Config.AltEkmek)
	for _, anahtar in ipairs({ "Kofte", "Peynir", "Marul", "Domates", "Kofte", "Peynir", "Tursu" }) do
		ekle(M[anahtar])
	end
	ekle(Config.UstEkmek)
	local tepeY = cf.Position.Y

	-- Taç
	local altin = Color3.fromRGB(255, 200, 40)
	local tacY = tepeY - 0.6
	disk(CFrame.new(0, tacY + 0.9, 0), 1.8, 7, altin, Enum.Material.Foil).Parent = model
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local pos = Vector3.new(math.cos(a) * 3.1, tacY + 2.6, math.sin(a) * 3.1)
		parca({
			Size = Vector3.new(1.1, 2.4, 1.1),
			CFrame = CFrame.new(pos) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, math.rad(45), 0),
			Color = altin,
			Material = Enum.Material.Foil,
			Parent = model,
		})
		parca({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9),
			CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)),
			Color = i % 2 == 0 and Color3.fromRGB(255, 40, 70) or Color3.fromRGB(40, 140, 255),
			Material = Enum.Material.Neon,
			Parent = model,
		})
	end

	-- Dev yazı
	local tutucu = parca({
		Name = "BaslikNoktasi",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(0, tacY + 10, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = model,
	})
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(46, 0, 9, 0)
	bb.MaxDistance = 500
	bb.LightInfluence = 0
	bb.Parent = tutucu
	local yazi = Instance.new("TextLabel")
	yazi.BackgroundTransparency = 1
	yazi.Size = UDim2.fromScale(1, 1)
	yazi.Font = Enum.Font.FredokaOne
	yazi.TextScaled = true
	yazi.Text = "🍔 BURGER İMPARATORU 👑"
	yazi.TextColor3 = Color3.new(1, 1, 1)
	yazi.Parent = bb
	local gradyan = Instance.new("UIGradient")
	gradyan.Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 120, 40))
	gradyan.Rotation = 90
	gradyan.Parent = yazi
	local kenar = Instance.new("UIStroke")
	kenar.Color = Color3.fromRGB(90, 30, 10)
	kenar.Thickness = 4
	kenar.Parent = yazi

	model.Parent = klasor
end

-- Bütün dünyayı kurar ve tezgah listesini döndürür
function Dunya.Kur()
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 135)

	local ana = Instance.new("Folder")
	ana.Name = "BurgerDunyasi"

	local zemin = Instance.new("Folder")
	zemin.Name = "Zemin"
	zeminYap(zemin)
	zemin.Parent = ana

	heykelYap(ana)
	ana.Parent = workspace

	local tezgahKlasoru = Instance.new("Folder")
	tezgahKlasoru.Name = "Tezgahlar"
	local tezgahlar = {}
	for i = 1, Config.TezgahSayisi do
		tezgahlar[i] = tezgahYap(i, Config.TezgahSayisi, tezgahKlasoru)
	end
	tezgahKlasoru.Parent = workspace

	local ucanlar = Instance.new("Folder")
	ucanlar.Name = "UcanPaketler"
	ucanlar.Parent = workspace

	return tezgahlar, ucanlar
end

return Dunya
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="9">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">150</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Ekran</string>
        </Properties>
        <Item class="LocalScript" referent="12">
          <Properties>
            <string name="Name">BurgerEkran</string>
            <string name="Source"><![CDATA[-- BURGER İMPARATORU - Oyuncunun ekranı
-- KATLA butonu, "huss huss huss" sesi, HUSS! yazıları, para/paket/unvan göstergeleri ve dükkan.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local Debris = game:GetService("Debris")

local ben = Players.LocalPlayer
local Ortak = ReplicatedStorage:WaitForChild("Ortak")
local Config = require(Ortak:WaitForChild("Config"))
local Ekonomi = require(Ortak:WaitForChild("Ekonomi"))
local Uzaklar = ReplicatedStorage:WaitForChild("Uzaklar")
local KatlaOlay = Uzaklar:WaitForChild("Katla")
local SatinAlOlay = Uzaklar:WaitForChild("SatinAl")
local DurumIsteOlay = Uzaklar:WaitForChild("DurumIste")
local DurumOlay = Uzaklar:WaitForChild("Durum")
local KatlandiOlay = Uzaklar:WaitForChild("Katlandi")
local UnvanOlay = Uzaklar:WaitForChild("YeniUnvan")

local FONT = Enum.Font.FredokaOne
local rastgele = Random.new()
local K = Ekonomi.Kisalt

local durum = nil -- sunucudan gelen son durum
local sesAcik = true
local kombo = 0
local sonKatlama = 0
local KATLAMA_ARALIGI = math.max(0.09, Config.KatlamaBeklemesi + 0.01)

----------------------------------------------------------------------
-- Ses: huss huss huss
----------------------------------------------------------------------
local sesVar = Config.HussSesId ~= nil and Config.HussSesId ~= ""
local sesHavuzu = {}
local sesSirasi = 0
if sesVar then
	for i = 1, 4 do
		local s = Instance.new("Sound")
		s.Name = "Huss" .. i
		s.SoundId = Config.HussSesId
		s.Volume = Config.HussSesSeviyesi
		s.Parent = SoundService
		sesHavuzu[i] = s
	end
elseif RunService:IsStudio() then
	warn("[Burger İmparatoru] Huss sesi yok: Config.HussSesId boş. README'deki 'Sesi ekle' adımlarına bak.")
end

local function hussCal(hiz, seviye)
	if not sesAcik or not sesVar then
		return
	end
	sesSirasi = sesSirasi % #sesHavuzu + 1
	local s = sesHavuzu[sesSirasi]
	s.PlaybackSpeed = hiz or 1
	s.Volume = Config.HussSesSeviyesi * (seviye or 1)
	s.TimePosition = 0
	s:Play()
end

local sonUzakSes = {}
local function tezgahTabagi(index)
	local klasor = workspace:FindFirstChild("Tezgahlar")
	local model = klasor and klasor:FindFirstChild("Tezgah" .. tostring(index))
	return model and model:FindFirstChild("Tabak")
end

-- Başka oyuncunun tezgahından gelen 3 boyutlu huss sesi (yakındaysan duyarsın)
local function uzakHuss(tezgahIndex)
	if not sesAcik or not sesVar then
		return
	end
	local simdi = os.clock()
	if sonUzakSes[tezgahIndex] and simdi - sonUzakSes[tezgahIndex] < 0.25 then
		return
	end
	sonUzakSes[tezgahIndex] = simdi
	local tabak = tezgahTabagi(tezgahIndex)
	if not tabak then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = Config.HussSesId
	s.Volume = Config.BaskasininSesSeviyesi
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 90
	s.PlaybackSpeed = rastgele:NextNumber(0.95, 1.1)
	s.Parent = tabak
	s:Play()
	Debris:AddItem(s, 3)
end

local function konfetiPatlat(tezgahIndex, adet)
	local tabak = tezgahTabagi(tezgahIndex)
	local nokta = tabak and tabak:FindFirstChild("KonfetiNoktasi")
	local konfeti = nokta and nokta:FindFirstChild("Konfeti")
	if konfeti then
		konfeti:Emit(adet)
	end
end

----------------------------------------------------------------------
-- Arayüz yardımcıları
----------------------------------------------------------------------
local function yap(sinif, ozellikler, cocuklar)
	local o = Instance.new(sinif)
	local ebeveyn = nil
	for k, v in pairs(ozellikler or {}) do
		if k == "Parent" then
			ebeveyn = v
		else
			o[k] = v
		end
	end
	for _, c in ipairs(cocuklar or {}) do
		c.Parent = o
	end
	if ebeveyn then
		o.Parent = ebeveyn
	end
	return o
end

local function kose(yaricap)
	return yap("UICorner", { CornerRadius = yaricap })
end

local function cizgi(renk, kalinlik)
	return yap("UIStroke", { Color = renk, Thickness = kalinlik, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function yaziCizgisi(renk, kalinlik)
	return yap("UIStroke", { Color = renk, Thickness = kalinlik, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

local function yazi(ozellikler)
	local o = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	}
	for k, v in pairs(ozellikler) do
		o[k] = v
	end
	return yap("TextLabel", o)
end

local function gecis(nesne, sure, hedef, stil, yon)
	local t = TweenService:Create(nesne, TweenInfo.new(sure, stil or Enum.EasingStyle.Quad, yon or Enum.EasingDirection.Out), hedef)
	t:Play()
	return t
end

local KOYU = Color3.fromRGB(45, 28, 18)
local PANEL = Color3.fromRGB(38, 26, 20)
local HUSS_SARI = Color3.fromRGB(255, 214, 20) -- videodaki HUSS! yazısının rengi

