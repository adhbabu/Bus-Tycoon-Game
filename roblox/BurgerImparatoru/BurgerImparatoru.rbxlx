}
Dil.EN = EN

-- "tr-tr", "TR", "en-us" gibi bir dil kodundan dili seçer
function Dil.Ayarla(kod)
	local k = string.lower(string.sub(tostring(kod or ""), 1, 2))
	Dil.Kod = (k == "tr") and "tr" or "en"
end

local function karsilik(metin)
	if Dil.Kod == "en" and type(metin) == "string" then
		return EN[metin] or metin
	end
	return metin
end

-- T("Türkçe yazı") ya da T("biçim %s %d", ...): seçili dildeki yazıyı verir.
-- Argümanlar da sözlükte varsa (ör. bir unvan adı) onlar da çevrilir.
function Dil.T(metin, ...)
	local s = karsilik(metin)
	local n = select("#", ...)
	if n == 0 then
		return s
	end
	local args = { ... }
	for i = 1, n do
		args[i] = karsilik(args[i])
	end
	return string.format(s, table.unpack(args, 1, n))
end

----------------------------------------------------------------------
-- Hazır yazıları çevirme (haritadaki tabelalar, sunucunun yazdığı isimler)
-- Tam eşleşme yoksa "%s", "%d" içeren kalıplara bakılır: "Sahibi: Ali" -> "Owner: Ali"
----------------------------------------------------------------------
local kaliplar = nil
local onbellek = {}
local onbellekSayisi = 0

local function kacir(s)
	return (string.gsub(s, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0"))
end

local function kaliplariHazirla()
	kaliplar = {}
	for tr, en in pairs(EN) do
		if string.find(tr, "%%[%-%d%.]*[sdf]") then
			local desen, i = "^", 1
			while true do
				local a, b, _, tur = string.find(tr, "%%([%-%d%.]*)([sdf%%])", i)
				if not a then
					break
				end
				desen ..= kacir(string.sub(tr, i, a - 1))
				if tur == "s" then
					desen ..= "(.-)"
				elseif tur == "d" then
					desen ..= "(%-?%d+)"
				elseif tur == "f" then
					desen ..= "(%-?%d+%.?%d*)"
				else
					desen ..= "%%"
				end
				i = b + 1
			end
			desen ..= kacir(string.sub(tr, i)) .. "$"
			local sablon = string.gsub(en, "%%([%-%d%.]*)([sdf%%])", function(_, tur)
				return tur == "%" and "%%" or "%s"
			end)
			table.insert(kaliplar, { Desen = desen, Sablon = sablon, Uzunluk = #tr })
		end
	end
	-- uzun (daha belirgin) kalıplar önce denenir
	table.sort(kaliplar, function(x, y)
		return x.Uzunluk > y.Uzunluk
	end)
end

-- Hazır bir yazının İngilizcesi; çevrilecek bir şey yoksa nil
function Dil.Cevir(metin)
	if Dil.Kod ~= "en" or type(metin) ~= "string" or metin == "" then
		return nil
	end
	local d = EN[metin]
	if d then
		return d
	end
	local o = onbellek[metin]
	if o ~= nil then
		return o or nil
	end
	if not kaliplar then
		kaliplariHazirla()
	end
	local sonuc = false
	for _, k in ipairs(kaliplar) do
		local yakalar = { string.match(metin, k.Desen) }
		if #yakalar > 0 then
			for j, y in ipairs(yakalar) do
				yakalar[j] = EN[y] or y
			end
			local ok, s = pcall(string.format, k.Sablon, table.unpack(yakalar))
			if ok then
				sonuc = s
				break
			end
		end
	end
	if onbellekSayisi > 400 then
		onbellek = {}
		onbellekSayisi = 0
	end
	onbellek[metin] = sonuc
	onbellekSayisi += 1
	return sonuc or nil
end

-- Bir klasördeki (ör. Workspace) bütün yazıları çevirir ve sonradan eklenenleri/değişenleri izler.
-- Sadece oyuncunun ekranında çalışır; sunucudaki asıl yazılar Türkçe kalır.
-- Türkçe modda Roblox'un kendi otomatik çevirisi Türkçe yazılara karışmasın diye kapatılır
-- (İngilizce modda açık kalır: Roblox İngilizce yazıları başka dillere de çevirebilir).
function Dil.DunyayiCevir(kok)
	if Dil.Kod ~= "en" then
		local function kapat(o)
			if o:IsA("LayerCollector") then
				o.AutoLocalize = false
			end
		end
		for _, o in ipairs(kok:GetDescendants()) do
			kapat(o)
		end
		kok.DescendantAdded:Connect(kapat)
		return
	end
	local function ozellik(o, ad)
		local function uygula()
			local y = Dil.Cevir(o[ad])
			if y and y ~= o[ad] then
				o[ad] = y
			end
		end
		uygula()
		o:GetPropertyChangedSignal(ad):Connect(uygula)
	end
	local function bagla(o)
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			ozellik(o, "Text")
		elseif o:IsA("ProximityPrompt") then
			ozellik(o, "ActionText")
			ozellik(o, "ObjectText")
		end
	end
	for _, o in ipairs(kok:GetDescendants()) do
		bagla(o)
	end
	kok.DescendantAdded:Connect(bagla)
end

return Dil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Ekonomi</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Ekonomi hesapları
-- Hem sunucu hem oyuncu ekranı aynı hesapları buradan yapar, böylece ekrandaki fiyatlar
-- ile sunucunun kabul ettiği fiyatlar hep aynı olur.

local Config = require(script.Parent.Config)
local Dil = require(script.Parent.Dil)
local T = Dil.T

local Ekonomi = {}

local tablo = {}
for _, g in ipairs(Config.Gelistirmeler) do
	tablo[g.Anahtar] = g
end

function Ekonomi.GelistirmeBul(anahtar)
	return tablo[anahtar]
end

function Ekonomi.BosGelistirmeler()
	local t = {}
	for _, g in ipairs(Config.Gelistirmeler) do
		t[g.Anahtar] = 0
	end
	return t
end

function Ekonomi.Seviye(gelistirmeler, anahtar)
	return (gelistirmeler and gelistirmeler[anahtar]) or 0
end

-- Bu geliştirmenin kilidi açık mı? (Gerekli olan alınmış mı)
function Ekonomi.KilidiAcik(gelistirmeler, anahtar)
	local g = tablo[anahtar]
	if not g then
		return false
	end
	return g.Gerekli == nil or Ekonomi.Seviye(gelistirmeler, g.Gerekli) > 0
end

-- Bir sonraki seviyenin fiyatı (MAX ise nil)
function Ekonomi.Fiyat(anahtar, mevcutSeviye)
	local g = tablo[anahtar]
	if not g or mevcutSeviye >= g.MaxSeviye then
		return nil
	end
	return math.floor(g.TabanFiyat * g.Carpan ^ mevcutSeviye)
end

function Ekonomi.TikBasinaKatlama(gelistirmeler)
	return math.min(Config.KatlamaSayisi, 1 + Ekonomi.Seviye(gelistirmeler, "HizliEller"))
end

function Ekonomi.TarifCarpani(gelistirmeler)
	return 1 + 0.5 * Ekonomi.Seviye(gelistirmeler, "Tarif")
end

-- Dükkanın ünü: alınan bina geliştirmelerinin toplamı
function Ekonomi.UnCarpani(gelistirmeler)
	local un = 1
	for _, g in ipairs(Config.Gelistirmeler) do
		if g.Un and Ekonomi.Seviye(gelistirmeler, g.Anahtar) > 0 then
			un += g.Un
		end
	end
	return un
end

function Ekonomi.SubeCarpani(sube)
	return 1 + (sube or 0) * Config.SubeBonusu
end

function Ekonomi.AltinSansi(gelistirmeler)
	return Config.AltinTabanSansi + Ekonomi.Seviye(gelistirmeler, "AltinSans") * Config.AltinSansArtisi
end

-- Bir paketin parası. ekstra: Altın Saat, hediye gibi geçici çarpanlar (yoksa 1)
function Ekonomi.PaketDegeri(altin, gelistirmeler, sube, ekstra)
	local d = Config.PaketTabanDegeri
		* (altin and Config.AltinCarpani or 1)
		* Ekonomi.TarifCarpani(gelistirmeler)
		* Ekonomi.UnCarpani(gelistirmeler)
		* Ekonomi.SubeCarpani(sube)
		* (ekstra or 1)
	return math.floor(d)
end

-- n. görevin tipi ve hedefi (n 1'den başlar)
function Ekonomi.Gorev(n)
	local g = Config.Gorev
	local tip = g.Sira[(n - 1) % #g.Sira + 1]
	local tur = math.floor((n - 1) / #g.Sira)
	local hedef = math.max(1, math.floor(g.IlkHedef[tip] * g.Buyume ^ (n - 1) + 0.5))
	if tip == "Altin" then
		hedef = 1 + tur
	end
	return tip, hedef
end

function Ekonomi.GorevYazisi(tip, hedef)
	if tip == "Katla" then
		return T("KATLA'ya %s kez bas", Ekonomi.Kisalt(hedef))
	elseif tip == "Paket" then
		return T("Elle %s paket yap", Ekonomi.Kisalt(hedef))
	elseif tip == "Altin" then
		return T("%d altın burger bul ✨", hedef)
	elseif tip == "Para" then
		return T("%s para kazan", Ekonomi.Kisalt(hedef))
	end
	return "?"
end

-- Bir makine kaç saniyede bir paket yapar
function Ekonomi.MakineSuresi(gelistirmeler)
	local s = Config.MakineIlkSure * Config.MakineHizlanma ^ Ekonomi.Seviye(gelistirmeler, "MakineHizi")
	s = math.max(Config.MakineEnKisaSure, s)
	if Ekonomi.Seviye(gelistirmeler, "Teknisyen") > 0 then
		s *= Config.TeknisyenCarpani
	end
	return s
end

-- Aşçı kaç saniyede bir katlar (aşçı yoksa nil)
function Ekonomi.AsciAraligi(gelistirmeler)
	local sv = Ekonomi.Seviye(gelistirmeler, "Asci")
	if sv <= 0 then
		return nil
	end
	return Config.AsciIlkSure * Config.AsciHizlanma ^ (sv - 1)
end

-- Makinelerin ve aşçının saniyede getirdiği ortalama para (sen hiç tıklamasan da)
function Ekonomi.MakineGeliri(gelistirmeler, sube)
	local paketSaniye = 0
	local adet = Ekonomi.Seviye(gelistirmeler, "Makine")
	if adet > 0 then
		paketSaniye += adet / Ekonomi.MakineSuresi(gelistirmeler)
	end
	local asci = Ekonomi.AsciAraligi(gelistirmeler)
	if asci then
		paketSaniye += 1 / (asci * Config.KatlamaSayisi)
	end
	if paketSaniye <= 0 then
		return 0
	end
	local sans = Ekonomi.AltinSansi(gelistirmeler)
	local ortalama = (1 - sans) * Ekonomi.PaketDegeri(false, gelistirmeler, sube)
		+ sans * Ekonomi.PaketDegeri(true, gelistirmeler, sube)
	return paketSaniye * ortalama
end

function Ekonomi.SubeFiyati(sube)
	return math.floor(Config.SubeTabanFiyat * Config.SubeCarpan ^ (sube or 0))
end

-- Geliştirmenin şu anki etkisini yazıyla anlatır
function Ekonomi.EtkiYazisi(anahtar, seviye)
	local g = tablo[anahtar]
	if anahtar == "HizliEller" then
		return T("Tık başına %d katlama", math.min(Config.KatlamaSayisi, 1 + seviye))
	elseif anahtar == "Tarif" then
		return T("Paket parası x%.1f", 1 + 0.5 * seviye)
	elseif anahtar == "AltinSans" then
		return T("Altın burger %%%d", math.floor((Config.AltinTabanSansi + seviye * Config.AltinSansArtisi) * 100 + 0.5))
	elseif anahtar == "Makine" then
		return T("%d / %d makine", seviye, g.MaxSeviye)
	elseif anahtar == "MakineHizi" then
		local s = math.max(Config.MakineEnKisaSure, Config.MakineIlkSure * Config.MakineHizlanma ^ seviye)
		return T("%.1f sn'de 1 paket", s)
	elseif anahtar == "Asci" then
		if seviye <= 0 then
			return T("Henüz yok")
		end
		return T("%.1f sn'de 1 katlama", Config.AsciIlkSure * Config.AsciHizlanma ^ (seviye - 1))
	elseif anahtar == "Teknisyen" then
		return seviye > 0 and T("Alındı ✓") or T("Makine süresi -%25")
	elseif g and g.Un then
		return seviye > 0 and T("Alındı ✓") or T("Ün +%%%d", math.floor(g.Un * 100 + 0.5))
	end
	return ""
end

function Ekonomi.UnvanIndex(toplamPaket)
	local idx = 1
	for i, u in ipairs(Config.Unvanlar) do
		if toplamPaket >= u.Esik then
			idx = i
		end
	end
	return idx
end

-- 1234 -> "1.2K", 5600000 -> "5.6M"
function Ekonomi.Kisalt(n)
	n = math.floor(n)
	local eksi = n < 0
	n = math.abs(n)
	local yazi
	if n < 1000 then
		yazi = tostring(n)
	else
		local ekler = { "K", "M", "B", "T", "Qa", "Qi" }
		local i = 0
		local x = n
		while x >= 1000 and i < #ekler do
			x /= 1000
			i += 1
		end
		if x >= 100 then
			yazi = string.format("%d%s", math.floor(x), ekler[i])
		else
			yazi = string.format("%.1f%s", math.floor(x * 10) / 10, ekler[i]):gsub("%.0", "")
		end
	end
	return (eksi and "-" or "") .. yazi
end

return Ekonomi
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Gorsel</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Burger ve kutu modelleri
-- İmparator Burger: iki köfte, üç ekmek (alt, orta, susamlı üst), özel sos, marul, peynir, turşu.
-- Karton kutu: tepsi + kapak. 3 katlamada kapanır.
-- Bu modül hiçbir şey "require" etmez; hem oyunda hem harita üreticisinde (Lune) çalışır.

local Gorsel = {}

local EKMEK = Color3.fromRGB(222, 158, 78)
local KOFTE = Color3.fromRGB(98, 56, 34)
local ALTIN = Color3.fromRGB(255, 205, 50)
local KARTON = Color3.fromRGB(236, 220, 186)

local function parca(oz)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(oz) do
		p[k] = v
	end
	return p
end
Gorsel.Parca = parca

-- Dik duran yuvarlak disk (Roblox silindiri X ekseninde yatar, 90 derece çeviriyoruz)
local function disk(cf, kalinlik, cap, renk, malzeme)
	return parca({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(kalinlik, cap, cap),
		CFrame = cf * CFrame.Angles(0, 0, math.rad(90)),
		Color = renk,
		Material = malzeme or Enum.Material.SmoothPlastic,
	})
end
Gorsel.Disk = disk

----------------------------------------------------------------------
-- İmparator Burger
----------------------------------------------------------------------
--[[
	cf: burgerin alt yüzünün ortası
	olcek: büyütme (1 = kutuya sığan boy)
	altin: köfteler altın olsun mu
	basit: az parçalı sürüm (makineler ve uzak şeyler için)
	Döndürür: parçalar listesi, toplam yükseklik
]]
function Gorsel.Burger(cf, olcek, altin, basit)
	olcek = olcek or 1
	local parcalar = {}
	local y = 0
	local function ekle(p)
		table.insert(parcalar, p)
		return p
	end
	local function kat(kalinlik, cap, renk, malzeme)
		local k = kalinlik * olcek
		local p = ekle(disk(cf * CFrame.new(0, y + k / 2, 0), k, cap * olcek, renk, malzeme))
		y += k
		return p
	end
	local kofteRenk = altin and ALTIN or KOFTE
	local kofteMalzeme = altin and Enum.Material.Foil or Enum.Material.Slate

	local function marul()
		local k = 0.2 * olcek
		ekle(disk(cf * CFrame.new(0, y + k / 2, 0), k, 4.5 * olcek, Color3.fromRGB(95, 190, 60), Enum.Material.Grass))
		if not basit then
			-- kenardan taşan kıvırcık yapraklar
			for i = 1, 7 do
				local a = i / 7 * math.pi * 2
				ekle(parca({
					Size = Vector3.new(0.9, k * 0.8, 0.7) * Vector3.new(olcek, 1, olcek),
					CFrame = cf * CFrame.new(0, y + k / 2, 0) * CFrame.Angles(0, a, 0) * CFrame.new(2.2 * olcek, 0, 0) * CFrame.Angles(0, 0, math.rad(-15)),
					Color = Color3.fromRGB(115, 205, 75),
					Material = Enum.Material.Grass,
				}))
			end
		end
		y += k
	end
	local function sosVeSogan()
		kat(0.06, 4.1, Color3.fromRGB(242, 168, 118))
		if not basit then
			kat(0.05, 3.8, Color3.fromRGB(246, 240, 226))
		else
			y += 0.05 * olcek
		end
	end
	local function kofte()
		local p = kat(0.42, 4.4, kofteRenk, kofteMalzeme)
		if altin then
			p.Reflectance = 0.2
		end
	end
	local function ekmek(kalinlik)
		kat(kalinlik, 4.5, EKMEK)
	end

	ekmek(0.6) -- alt ekmek
	sosVeSogan()
	marul()
	-- peynir: köşeleri taşan kare dilim
	local pk = 0.1 * olcek
	ekle(parca({
		Size = Vector3.new(3.6 * olcek, pk, 3.6 * olcek),
		CFrame = cf * CFrame.new(0, y + pk / 2, 0) * CFrame.Angles(0, math.rad(45), 0),
		Color = Color3.fromRGB(255, 186, 40),
	}))
	y += pk
	kofte()
	ekmek(0.42) -- orta ekmek
	sosVeSogan()
	marul()
	-- turşular
	local tk = 0.08 * olcek
	if not basit then
		for _, x in ipairs({ -0.9, 0.9 }) do
			ekle(disk(cf * CFrame.new(x * olcek, y + tk / 2, 0.4 * olcek * x), tk, 1.3 * olcek, Color3.fromRGB(120, 150, 45)))
		end
	end
	y += tk
	kofte()

	-- üst ekmek: yan yüzü düz bir taban + kubbe, üstünde susamlar
	local ustK = 1.5 * olcek
	local tabanK = ustK * 0.4
	local kubbeK = ustK - tabanK
	local cap = 4.6 * olcek
	ekle(disk(cf * CFrame.new(0, y + tabanK / 2, 0), tabanK, cap, EKMEK))
	local kubbe = ekle(parca({
		Size = Vector3.new(cap, kubbeK * 2, cap),
		CFrame = cf * CFrame.new(0, y + tabanK, 0),
		Color = EKMEK,
	}))
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = kubbe
	if not basit then
		local tohum = {
			{ 0.2, 0.3 }, { 0.45, 1.2 }, { 0.5, 2.6 }, { 0.42, 3.9 }, { 0.55, 5.1 }, { 0.7, 0.6 },
			{ 0.72, 1.9 }, { 0.68, 3.3 }, { 0.75, 4.5 }, { 0.3, 2.2 }, { 0.25, 4.4 }, { 0.65, 5.8 },
		}
		for _, t in ipairs(tohum) do
			local f, a = t[1], t[2]
			local h = kubbeK * math.sqrt(1 - f * f)
			ekle(parca({
				Size = Vector3.new(0.34, 0.12, 0.2) * olcek,
				CFrame = cf * CFrame.new(math.cos(a) * f * cap / 2, y + tabanK + h, math.sin(a) * f * cap / 2) * CFrame.Angles(0, a, 0),
				Color = Color3.fromRGB(255, 249, 228),
			}))
		end
	end
	y += ustK
	return parcalar, y
end

----------------------------------------------------------------------
-- Logo etiketi (kutuların, tabelaların üstünde)
----------------------------------------------------------------------
function Gorsel.LogoEtiketi(p, yuz, logo, renk, buyukluk)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Logo"
	sg.Face = yuz
	sg.LightInfluence = 0.4
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = p
	local daire = Instance.new("Frame")
	daire.AnchorPoint = Vector2.new(0.5, 0.5)
	daire.Position = UDim2.fromScale(0.5, 0.5)
	daire.Size = UDim2.fromScale(buyukluk or 0.7, buyukluk or 0.7)
	daire.BackgroundColor3 = Color3.new(1, 1, 1)
	daire.Parent = sg
	local oran = Instance.new("UIAspectRatioConstraint")
	oran.Parent = daire
	local kose = Instance.new("UICorner")
	kose.CornerRadius = UDim.new(1, 0)
	kose.Parent = daire
	local cizgi = Instance.new("UIStroke")
	cizgi.Color = renk
	cizgi.Thickness = 4
	cizgi.Parent = daire
	local yazi = Instance.new("TextLabel")
	yazi.BackgroundTransparency = 1
	yazi.Size = UDim2.fromScale(0.86, 0.86)
	yazi.Position = UDim2.fromScale(0.07, 0.07)
	yazi.TextScaled = true
	yazi.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	yazi.Text = logo
	yazi.Parent = daire
	return sg
end

----------------------------------------------------------------------
-- Karton kutu (tepsi + kapak). "o" = ölçek (1 = tam boy)
----------------------------------------------------------------------
local S = 5.8 -- kutunun eni ve derinliği
local T = 0.12 -- karton kalınlığı
local TH = 1.6 -- tepsi yüksekliği
local LH = 3.2 -- kapak yüksekliği
Gorsel.KutuEni = S
Gorsel.KutuYuksekligi = TH + LH
Gorsel.KartonKalinligi = T

local DUZ = math.rad(90)
local KAPAK_ACIK = math.rad(110)

-- Kutunun her parçasının, verilen aşamadaki yeri.
-- 0 = karton açık, 1 = tepsinin kenarları kalktı, 2 = kapağın kenarları kalktı, 3 = kapak kapandı
-- taban: kutunun alt yüzünün ortası; -Z yönü kutunun önü (oyuncuya bakar)
function Gorsel.KutuPozu(taban, asama, o)
	o = o or 1
	local s, t, th, lh = S * o, T * o, TH * o, LH * o
	local fi = asama >= 1 and 0 or DUZ
	local beta = asama >= 2 and 0 or DUZ
	local alfa = asama >= 3 and 0 or KAPAK_ACIK
	local K = taban * CFrame.new(0, th, s / 2) * CFrame.Angles(alfa, 0, 0) -- kapağın menteşesi
	return {
		Taban = taban * CFrame.new(0, t / 2, 0),
		TArka = taban * CFrame.new(0, th / 2, s / 2 - t / 2),
		TOn = taban * CFrame.new(0, 0, -s / 2) * CFrame.Angles(-fi, 0, 0) * CFrame.new(0, th / 2, t / 2),
		TSol = taban * CFrame.new(-s / 2, 0, 0) * CFrame.Angles(0, 0, fi) * CFrame.new(t / 2, th / 2, 0),
		TSag = taban * CFrame.new(s / 2, 0, 0) * CFrame.Angles(0, 0, -fi) * CFrame.new(-t / 2, th / 2, 0),
		KUst = K * CFrame.new(0, lh - t / 2, -s / 2),
		KArka = K * CFrame.new(0, lh / 2, -t / 2),
		KOn = K * CFrame.new(0, lh, -s) * CFrame.Angles(beta, 0, 0) * CFrame.new(0, -lh / 2, t / 2),
		KSol = K * CFrame.new(-s / 2, lh, -s / 2) * CFrame.Angles(0, 0, -beta) * CFrame.new(t / 2, -lh / 2, 0),
		KSag = K * CFrame.new(s / 2, lh, -s / 2) * CFrame.Angles(0, 0, beta) * CFrame.new(-t / 2, -lh / 2, 0),
	}
end

Gorsel.KutuParcalari = { "Taban", "TArka", "TOn", "TSol", "TSag", "KUst", "KArka", "KOn", "KSol", "KSag" }

-- Açık bir karton kutu yapar (Parent'ı yok). stil = { Renk, Logo, Altin }
function Gorsel.KutuYap(taban, stil, o)
	o = o or 1
	local s, t, th, lh = S * o, T * o, TH * o, LH * o
	local poz = Gorsel.KutuPozu(taban, 0, o)
	local kapakRengi = stil.Altin and ALTIN or stil.Renk
	local boyut = {
		Taban = Vector3.new(s, t, s),
		TArka = Vector3.new(s, th, t),
		TOn = Vector3.new(s, th, t),
		TSol = Vector3.new(t, th, s - 2 * t),
		TSag = Vector3.new(t, th, s - 2 * t),
		KUst = Vector3.new(s, t, s),
		KArka = Vector3.new(s, lh, t),
		KOn = Vector3.new(s, lh, t),
		KSol = Vector3.new(t, lh, s - 2 * t),
		KSag = Vector3.new(t, lh, s - 2 * t),
	}
	local kutu = {}
	for _, ad in ipairs(Gorsel.KutuParcalari) do
		local kapak = string.sub(ad, 1, 1) == "K"
		kutu[ad] = parca({
			Name = "Kutu" .. ad,
			Size = boyut[ad],
			CFrame = poz[ad],
			Color = kapak and kapakRengi or KARTON,
			Material = (kapak and stil.Altin) and Enum.Material.Foil or Enum.Material.Cardboard,
		})
	end
	Gorsel.LogoEtiketi(kutu.KUst, Enum.NormalId.Top, stil.Logo, kapakRengi, 0.75)
	Gorsel.LogoEtiketi(kutu.KOn, Enum.NormalId.Front, stil.Logo, kapakRengi, 0.8)
	return kutu
end

-- Kapalı paket (bantta giden kutu). cf: alt yüzünün ortası. Döndürür: parçalar listesi
function Gorsel.KapaliKutu(cf, stil, olcek)
	olcek = olcek or 1
	local kapakRengi = stil.Altin and ALTIN or stil.Renk
	local tepsi = parca({
		Name = "PaketTepsi",
		Size = Vector3.new(S, TH, S) * olcek,
		CFrame = cf * CFrame.new(0, TH * olcek / 2, 0),
		Color = KARTON,
		Material = Enum.Material.Cardboard,
	})
	local kapak = parca({
		Name = "PaketKapak",
		Size = Vector3.new(S, LH, S) * olcek,
		CFrame = cf * CFrame.new(0, (TH + LH / 2) * olcek, 0),
		Color = kapakRengi,
		Material = stil.Altin and Enum.Material.Foil or Enum.Material.Cardboard,
	})
	Gorsel.LogoEtiketi(kapak, Enum.NormalId.Top, stil.Logo, kapakRengi, 0.75)
	if olcek >= 0.4 then
		Gorsel.LogoEtiketi(kapak, Enum.NormalId.Front, stil.Logo, kapakRengi, 0.8)
	end
	return { tepsi, kapak }
end

----------------------------------------------------------------------
-- İnsan (müşteriler ve çalışanlar). Klasik Roblox karakteri gibi bloklardan.
----------------------------------------------------------------------
-- cf: ayaklarının ortası, yüzü -Z'ye (LookVector) bakar
-- oz = { Gomlek, Pantolon, Ten, Yuz, Sapka = "kep" | "sef" | nil, SapkaRenk, Onluk }
-- salinim: kol/bacak sallanma açısı (radyan), oturuyor: true ise bacaklar öne,
-- kolAci: verilirse iki kol da bu açıyla öne uzanır (paket taşırken)
function Gorsel.InsanPozu(cf, salinim, oturuyor, kolAci)
	salinim = salinim or 0
	local kalca = cf * CFrame.new(0, 2, 0)
	local omuz = cf * CFrame.new(0, 3.8, 0)
	local bacakAci = oturuyor and math.rad(-90) or 0
	local dus = oturuyor and -1 or 0
	local govde = cf * CFrame.new(0, 3 + dus, 0)
	return {
		Govde = govde,
		Bas = cf * CFrame.new(0, 4.65 + dus, 0),
		SolKol = omuz * CFrame.new(-1.5, dus, 0) * CFrame.Angles(kolAci or salinim, 0, 0) * CFrame.new(0, -0.8, 0),
		SagKol = omuz * CFrame.new(1.5, dus, 0) * CFrame.Angles(kolAci or -salinim, 0, 0) * CFrame.new(0, -0.8, 0),
		SolBacak = kalca * CFrame.new(-0.5, dus, 0) * CFrame.Angles(-salinim * 0.8 - bacakAci, 0, 0) * CFrame.new(0, -1, 0),
		SagBacak = kalca * CFrame.new(0.5, dus, 0) * CFrame.Angles(salinim * 0.8 - bacakAci, 0, 0) * CFrame.new(0, -1, 0),
	}
end

local TENLER = {
	Color3.fromRGB(255, 220, 185), Color3.fromRGB(240, 195, 150), Color3.fromRGB(205, 150, 105),
	Color3.fromRGB(160, 110, 75), Color3.fromRGB(110, 75, 50),
}
Gorsel.Tenler = TENLER

function Gorsel.Insan(cf, oz)
	local poz = Gorsel.InsanPozu(cf, 0, false)
	local ten = oz.Ten or TENLER[1]
	local p = {}
	p.Govde = parca({ Name = "Govde", Size = Vector3.new(2, 2, 1), CFrame = poz.Govde, Color = oz.Gomlek })
	p.Bas = parca({ Name = "Bas", Size = Vector3.new(1.25, 1.25, 1.25), CFrame = poz.Bas, Color = ten })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = p.Bas
	p.SolKol = parca({ Name = "SolKol", Size = Vector3.new(1, 2, 1), CFrame = poz.SolKol, Color = ten })
	p.SagKol = parca({ Name = "SagKol", Size = Vector3.new(1, 2, 1), CFrame = poz.SagKol, Color = ten })
	p.SolBacak = parca({ Name = "SolBacak", Size = Vector3.new(1, 2, 1), CFrame = poz.SolBacak, Color = oz.Pantolon })
	p.SagBacak = parca({ Name = "SagBacak", Size = Vector3.new(1, 2, 1), CFrame = poz.SagBacak, Color = oz.Pantolon })
	-- kısa kollu gömlek: kolun üst yarısı gömlek renginde
	-- yüz
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.LightInfluence = 0.6
	sg.CanvasSize = Vector2.new(100, 100)
	sg.Parent = p.Bas
	local yuz = Instance.new("TextLabel")
	yuz.BackgroundTransparency = 1
	yuz.Size = UDim2.fromScale(1, 1)
	yuz.TextScaled = true
	yuz.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	yuz.Text = oz.Yuz or "🙂"
	yuz.Parent = sg
	local ekler = {}
	if oz.Onluk then
		table.insert(ekler, { "Onluk", Vector3.new(1.6, 1.8, 0.1), CFrame.new(0, -0.1, -0.55), Color3.new(1, 1, 1) })
	end
	if oz.Sapka == "kep" then
		table.insert(ekler, { "Sapka", Vector3.new(1.35, 0.45, 1.35), CFrame.new(0, 0.62, 0), oz.SapkaRenk or oz.Gomlek, "Bas" })
		table.insert(ekler, { "Siper", Vector3.new(1.2, 0.12, 0.7), CFrame.new(0, 0.45, -0.85), oz.SapkaRenk or oz.Gomlek, "Bas" })
	elseif oz.Sapka == "sef" then
		table.insert(ekler, { "Sapka", Vector3.new(1.3, 1.1, 1.3), CFrame.new(0, 1.05, 0), Color3.new(1, 1, 1), "Bas" })
	end
	p.Ekler = {}
	for _, e in ipairs(ekler) do
		local bagli = e[5] or "Govde"
		local ek = parca({ Name = e[1], Size = e[2], CFrame = p[bagli].CFrame * e[3], Color = e[4] })
		table.insert(p.Ekler, { Parca = ek, Bagli = bagli, Goreli = e[3] })
	end
	p.Liste = { p.Govde, p.Bas, p.SolKol, p.SagKol, p.SolBacak, p.SagBacak }
	for _, e in ipairs(p.Ekler) do
		table.insert(p.Liste, e.Parca)
	end
	return p
end

-- Daha önce yapılmış bir insanı yeni yerine ve duruşuna taşır
function Gorsel.InsanTasi(p, cf, salinim, oturuyor, kolAci)
	local poz = Gorsel.InsanPozu(cf, salinim, oturuyor, kolAci)
	for ad, c in pairs(poz) do
		p[ad].CFrame = c
	end
	for _, e in ipairs(p.Ekler) do
		e.Parca.CFrame = p[e.Bagli].CFrame * e.Goreli
	end
end

return Gorsel
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Sunucu</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">BurgerSunucu</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Sunucu
-- Arsalar, katlama, paketleme makineleri, dükkan geliştirmeleri, yeni şube, dükkan stili ve kayıt.
-- Oyuncunun ekranı sadece istekte bulunur; parayı ve her kararı sunucu verir (hile yapılamaz).
-- Kutuların katlanması ve bantta gitmesi gibi görüntüleri her oyuncunun ekranı kendisi çizer.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local TextService = game:GetService("TextService")

local Ortak = ReplicatedStorage:WaitForChild("Ortak")
local Config = require(Ortak:WaitForChild("Config"))
local Ekonomi = require(Ortak:WaitForChild("Ekonomi"))
local Gorsel = require(Ortak:WaitForChild("Gorsel"))
local Dukkan = require(script.Parent:WaitForChild("Dukkan"))
local HaritaUretici = require(script.Parent:WaitForChild("HaritaUretici"))

----------------------------------------------------------------------
-- Uzak olaylar (RemoteEvent)
----------------------------------------------------------------------
local uzaklar = Instance.new("Folder")
uzaklar.Name = "Uzaklar"
local function olay(ad)
	local e = Instance.new("RemoteEvent")
	e.Name = ad
	e.Parent = uzaklar
	return e
end
local KatlaOlay = olay("Katla") -- oyuncu -> sunucu
local SatinAlOlay = olay("SatinAl") -- oyuncu -> sunucu (anahtar)
local SubeAcOlay = olay("SubeAc") -- oyuncu -> sunucu
local StilSecOlay = olay("StilSec") -- oyuncu -> sunucu ({Logo, Renk, Ad})
local DurumIsteOlay = olay("DurumIste") -- oyuncu -> sunucu
local EvimeGitOlay = olay("EvimeGit") -- oyuncu -> sunucu (dükkanına ışınlan)
local DurumOlay = olay("Durum") -- sunucu -> oyuncu (durum tablosu)
-- sunucu -> herkes: kim, arsa, aşama, paketlendi mi, kazanç, bu burger altın mı, sıradaki altın mı, aşçı mı katladı
local KatlandiOlay = olay("Katlandi")
local UretimOlay = olay("Uretim") -- sunucu -> herkes: { {arsa, makine, altin}, ... }
local UnvanOlay = olay("YeniUnvan") -- sunucu -> herkes (kim, unvan sırası)
local DuyuruOlay = olay("Duyuru") -- sunucu -> herkes ya da bir oyuncu (Türkçe yazı ya da biçim + argümanlar; ekran kendi dilinde gösterir)
local GorevAlOlay = olay("GorevAl") -- oyuncu -> sunucu (görev ödülünü al)
local NPCOlay = olay("NPC") -- sunucu -> oyuncu (NPC ile konuştu: hangi pencere açılsın)
local YarismaOlay = olay("Yarisma") -- sunucu -> oyuncu (yarışma başladı / bitti)
uzaklar.Parent = ReplicatedStorage

local rastgele = Random.new()

----------------------------------------------------------------------
-- Harita ve arsalar
----------------------------------------------------------------------
local harita = workspace:FindFirstChild("Harita")
if not harita then
	-- Harita dosyası yoksa (örneğin Rojo ile sadece kod aktarıldıysa) aynısını kodla kur
	harita = HaritaUretici.Uret(Config, Gorsel)
	harita.Parent = workspace
end
local arsaKlasoru = harita:WaitForChild("Arsalar")

-- Oyun başlayınca tepeler, kasabanın dışındaki çayırlar ve göl gerçek araziye (Terrain) dönüşür:
-- rüzgârda sallanan çimenler, yumuşak tepeler, dalgalı su.
-- (Studio'da düzenlerken bloklar olarak görünürler.)
task.spawn(function()
	local arazi = workspace:FindFirstChildOfClass("Terrain")
	if not arazi then
		return
	end
	local ok, hata = pcall(function()
		local cayirlar = harita:FindFirstChild("Cayirlar")
		if cayirlar then
			for _, c in ipairs(cayirlar:GetChildren()) do
				if c:IsA("BasePart") then
					arazi:FillBlock(c.CFrame, c.Size, Enum.Material.Grass)
					c:Destroy()
				end
			end
		end
		local tepeler = harita:FindFirstChild("Tepeler")
		if tepeler then
			for _, t in ipairs(tepeler:GetChildren()) do
				if t:IsA("BasePart") then
					arazi:FillBall(t.CFrame.Position, t.Size.X / 2, Enum.Material.Grass)
					t:Destroy()
				end
			end
		end
		for _, gol in ipairs(harita:GetDescendants()) do
			if gol:IsA("BasePart") and gol.Name == "Gol" then
				local r = gol.Size.Y / 2
				arazi:FillCylinder(CFrame.new(gol.CFrame.Position.X, -0.6, gol.CFrame.Position.Z), 2, r, Enum.Material.Water)
				gol.Transparency = 1
			end
		end
	end)
	if not ok then
		warn("[Burger İmparatoru] Arazi kurulamadı: " .. tostring(hata))
	end
end)

-- Gün ve gece: gün dörtte üç sürer, gece kısa; gece neon tabelalar ve lambalar parlar
task.spawn(function()
	local baslangic = os.clock()
	while true do
		local p = ((os.clock() - baslangic) / Config.GunSuresi) % 1
		local saat
		if p < 0.75 then
			saat = 7 + p / 0.75 * 12 -- 07:00 -> 19:00
		else
			saat = 19 + (p - 0.75) / 0.25 * 12 -- 19:00 -> 07:00
		end
		Lighting.ClockTime = saat % 24
		task.wait(0.5)
	end
end)
local arsalar = {}
for i = 1, Config.ArsaSayisi do
	local m = arsaKlasoru:FindFirstChild("Arsa" .. i)
	if m then
		arsalar[i] = { Index = i, Model = m, Sahip = nil }
		Dukkan.Kur(m, nil)
	end
end

----------------------------------------------------------------------
-- Kayıt (DataStore)
----------------------------------------------------------------------
local kayitDeposu = nil
do
	local ok, sonuc = pcall(function()
		return DataStoreService:GetDataStore(Config.KayitAnahtari)
	end)
	if ok then
		kayitDeposu = sonuc
	else
		warn("[Burger İmparatoru] Kayıt sistemi açılamadı: " .. tostring(sonuc))
	end
end

local function kayitAnahtari(oyuncu)
	return "oyuncu_" .. oyuncu.UserId
end

local function kayitYukle(oyuncu)
	if not kayitDeposu then
		return nil, false
	end
	for deneme = 1, 3 do
		local ok, sonuc = pcall(function()
			return kayitDeposu:GetAsync(kayitAnahtari(oyuncu))
		end)
		if ok then
			return sonuc, true
		end
		local mesaj = tostring(sonuc)
		warn("[Burger İmparatoru] Kayıt yüklenemedi (" .. deneme .. "): " .. mesaj)
		if string.find(mesaj, "StudioAccessToApisNotAllowed") or string.find(mesaj, "publish") then
			break -- Studio'da API erişimi kapalı, tekrar denemeye gerek yok
		end
		task.wait(1.5)
	end
	return nil, false
end

local veriler = {} -- [Player] = veri

local function sayi(x, varsayilan)
	if type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge then
		return x
	end
	return varsayilan
end

local function tamSayi(x, enAz, enCok, varsayilan)
	return math.clamp(math.floor(sayi(x, varsayilan)), enAz, enCok)
end

local function veriHazirla(ham)
	ham = type(ham) == "table" and ham or {}
	local gelistirme = Ekonomi.BosGelistirmeler()
	if type(ham.Gelistirme) == "table" then
		for _, g in ipairs(Config.Gelistirmeler) do
			gelistirme[g.Anahtar] = tamSayi(ham.Gelistirme[g.Anahtar], 0, g.MaxSeviye, 0)
		end
	end
	local stil = nil
	if type(ham.Stil) == "table" and type(ham.Stil.Ad) == "string" then
		stil = {
			Logo = tamSayi(ham.Stil.Logo, 1, #Config.Logolar, 1),
			Renk = tamSayi(ham.Stil.Renk, 1, #Config.Renkler, 1),
			Ad = string.sub(ham.Stil.Ad, 1, 80),
		}
	end
	return {
		Para = math.max(0, math.floor(sayi(ham.Para, 0))),
		ToplamPaket = math.max(0, math.floor(sayi(ham.ToplamPaket, 0))),
		Sube = tamSayi(ham.Sube, 0, 1000, 0),
		Gelistirme = gelistirme,
		Stil = stil,
		GorevN = tamSayi(ham.GorevN, 1, 1000000, 1),
		GorevIlerleme = math.max(0, math.floor(sayi(ham.GorevIlerleme, 0))),
		YarismaRekor = tamSayi(ham.YarismaRekor, 0, 100000, 0),
		SonHediye = math.floor(sayi(ham.SonHediye, 0)),
	}
end

local function kaydet(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.KayitAcik or not kayitDeposu then
		return
	end
	local paket = {
		Surum = 3,
		Para = v.Para,
		ToplamPaket = v.ToplamPaket,
		Sube = v.Sube,
		Gelistirme = v.Gelistirme,
		Stil = v.Stil,
		GorevN = v.GorevN,
		GorevIlerleme = v.GorevIlerleme,
		YarismaRekor = v.YarismaRekor,
		SonHediye = v.SonHediye,
	}
	for deneme = 1, 3 do
		local ok, hata = pcall(function()
			kayitDeposu:SetAsync(kayitAnahtari(oyuncu), paket, { oyuncu.UserId })
		end)
		if ok then
			return
		end
		warn("[Burger İmparatoru] Kayıt yapılamadı (" .. deneme .. "): " .. tostring(hata))
		task.wait(1)
	end
end

----------------------------------------------------------------------
-- Yardımcılar
----------------------------------------------------------------------
local function varsayilanAd(oyuncu)
	return string.sub(oyuncu.DisplayName, 1, Config.AdEnUzun - 7) .. " Burger"
end

local function stilCoz(oyuncu, v)
	local s = v.Stil or { Logo = 1, Renk = 1, Ad = varsayilanAd(oyuncu) }
	return {
		Logo = Config.Logolar[s.Logo] or Config.Logolar[1],
		Renk = (Config.Renkler[s.Renk] or Config.Renkler[1]).Renk,
		Ad = s.Ad,
	}
end

local function unvan(v)
	return Config.Unvanlar[Ekonomi.UnvanIndex(v.ToplamPaket)]
end

local function yeniBurger(v)
	v.Burger = { Asama = 0, Altin = rastgele:NextNumber() < Ekonomi.AltinSansi(v.Gelistirme) }
end

-- Geçici çarpanlar: Altın Saat (herkes) ve hediyeden gelen 2 kat para (tek oyuncu)
local altinSaatBitis = 0
local function ekstraCarpan(v)
	local c = 1
	if os.clock() < altinSaatBitis then
		c *= Config.AltinSaat.Carpan
	end
	if v.IkiKatBitis and os.clock() < v.IkiKatBitis then
		c *= 2
	end
	return c
end

local function gorevOdulu(v)
	local gelir = Ekonomi.MakineGeliri(v.Gelistirme, v.Sube)
	local paket = Ekonomi.PaketDegeri(false, v.Gelistirme, v.Sube)
	return math.max(Config.Gorev.EnAzOdul, math.floor(gelir * Config.Gorev.OdulSaniye), paket * 12)
end

local function gorevIlerle(v, tip, miktar)
	local gTip, hedef = Ekonomi.Gorev(v.GorevN)
	if gTip == tip and v.GorevIlerleme < hedef then
		v.GorevIlerleme = math.min(hedef, v.GorevIlerleme + miktar)
	end
end

local function durumGonder(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir then
		return
	end
	local gTip, gHedef = Ekonomi.Gorev(v.GorevN)
	DurumOlay:FireClient(oyuncu, {
		Gorev = { N = v.GorevN, Tip = gTip, Hedef = gHedef, Ilerleme = v.GorevIlerleme, Odul = gorevOdulu(v) },
		YarismaRekor = v.YarismaRekor,
		HediyeKalan = math.max(0, v.SonHediye + Config.Hediye.Bekleme - os.time()),
		Ekstra = ekstraCarpan(v),
		Para = v.Para,
		ToplamPaket = v.ToplamPaket,
		Sube = v.Sube,
		UnvanIndex = Ekonomi.UnvanIndex(v.ToplamPaket),
		Asama = v.Burger.Asama,
		Altin = v.Burger.Altin,
		Gelistirme = v.Gelistirme,
		ArsaIndex = v.Arsa and v.Arsa.Index or 0,
		KayitAcik = v.KayitAcik,
		StilVar = v.Stil ~= nil,
		Stil = v.Stil or { Logo = 1, Renk = 1, Ad = varsayilanAd(oyuncu) },
	})
end

local function skorGuncelle(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Skor then
		return
	end
	v.Skor.Paket.Value = v.ToplamPaket
	v.Skor.Para.Value = v.Para
	v.Skor.Unvan.Value = unvan(v).Ikon
end

local function kafaYazisiGuncelle(oyuncu)
	local v = veriler[oyuncu]
	local karakter = oyuncu.Character
	if not v or not karakter then
		return
	end
	local kafa = karakter:FindFirstChild("Head")
	if not kafa then
		return
	end
	local bb = kafa:FindFirstChild("UnvanYazisi")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "UnvanYazisi"
		bb.Size = UDim2.new(5, 0, 0.9, 0)
		bb.StudsOffset = Vector3.new(0, 2.2, 0)
		bb.MaxDistance = 60
		bb.LightInfluence = 0
		local yazi = Instance.new("TextLabel")
		yazi.Name = "Yazi"
		yazi.BackgroundTransparency = 1
		yazi.Size = UDim2.fromScale(1, 1)
		yazi.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
		yazi.TextScaled = true
		yazi.TextStrokeTransparency = 0.2
		yazi.Parent = bb
		bb.Parent = kafa
	end
	local u = unvan(v)
	bb.Yazi.Text = "👑 " .. u.Ad .. (v.Sube > 0 and ("  🏙️" .. v.Sube) or "")
	bb.Yazi.TextColor3 = u.Renk
end

local function unvanKontrol(oyuncu, eskiIndex)
	local v = veriler[oyuncu]
	local yeniIndex = Ekonomi.UnvanIndex(v.ToplamPaket)
	if yeniIndex > eskiIndex then
		UnvanOlay:FireAllClients(oyuncu, yeniIndex)
		kafaYazisiGuncelle(oyuncu)
	end
end

local function dukkaniKur(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Arsa then
		return
	end
	Dukkan.Kur(v.Arsa.Model, {
		Stil = stilCoz(oyuncu, v),
		Gelistirme = v.Gelistirme,
		UserId = oyuncu.UserId,
		SahipAdi = oyuncu.DisplayName,
	})
end

local function evineIsinla(oyuncu)
	local v = veriler[oyuncu]
	local karakter = oyuncu.Character
	if not v or not v.Arsa or not karakter then
		return
	end
	local kok = karakter:WaitForChild("HumanoidRootPart", 5)
	if kok then
		karakter:PivotTo(Dukkan.OyuncuCFrame(v.Arsa.Model))
	end
end

----------------------------------------------------------------------
-- Katlama (KATLA butonu)
----------------------------------------------------------------------
local function katla(oyuncu, adet, otomatik)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or not v.Arsa then
		return
	end
	local b = v.Burger
	local eklenen = 0
	for _ = 1, adet do
		if b.Asama >= Config.KatlamaSayisi then
			break
		end
		b.Asama += 1
		eklenen += 1
	end
	if eklenen == 0 then
		return
	end
	local paketlendi = b.Asama >= Config.KatlamaSayisi
	local kazanc = 0
	if not otomatik then
		gorevIlerle(v, "Katla", 1)
	end
	if paketlendi then
		local eskiUnvan = Ekonomi.UnvanIndex(v.ToplamPaket)
		kazanc = Ekonomi.PaketDegeri(b.Altin, v.Gelistirme, v.Sube, ekstraCarpan(v))
		v.Para += kazanc
		v.ToplamPaket += 1
		if not otomatik then
			gorevIlerle(v, "Paket", 1)
		end
		if b.Altin then
			gorevIlerle(v, "Altin", 1)
		end
		gorevIlerle(v, "Para", kazanc)
		yeniBurger(v)
		skorGuncelle(oyuncu)
		unvanKontrol(oyuncu, eskiUnvan)
	end
	KatlandiOlay:FireAllClients(oyuncu, v.Arsa.Index, b.Asama, paketlendi, kazanc, b.Altin, v.Burger.Altin, otomatik == true)
	durumGonder(oyuncu)
end

----------------------------------------------------------------------
-- Arsa dağıtımı
----------------------------------------------------------------------
local function bosArsaAl(oyuncu)
	for i = 1, Config.ArsaSayisi do
		local a = arsalar[i]
		if a and a.Sahip == nil then
			a.Sahip = oyuncu
			return a
		end
	end
	return nil
end

local function arsayiBirak(a)
	a.Sahip = nil
	Dukkan.Kur(a.Model, nil)
end

----------------------------------------------------------------------
-- Oyuncu girişi / çıkışı
----------------------------------------------------------------------
local function karakterGeldi(oyuncu, karakter)
	task.spawn(function()
		task.wait(0.1)
		evineIsinla(oyuncu)
	end)
	karakter:WaitForChild("Head", 5)
	kafaYazisiGuncelle(oyuncu)
end

local function oyuncuGeldi(oyuncu)
	if veriler[oyuncu] then
		return
	end
	local v = {
		Hazir = false,
		KayitAcik = false,
		Para = 0,
		ToplamPaket = 0,
		Sube = 0,
		Gelistirme = Ekonomi.BosGelistirmeler(),
		Stil = nil,
		Burger = { Asama = 0, Altin = false },
		Jeton = 4,
		SonJeton = os.clock(),
		MakineBirikim = {},
		AsciBirikim = 0,
		GorevN = 1,
		GorevIlerleme = 0,
		YarismaRekor = 0,
		SonHediye = 0,
		Son = {},
	}
	veriler[oyuncu] = v

	local skorlar = Instance.new("Folder")
	skorlar.Name = "leaderstats"
	local paketDeger = Instance.new("IntValue")
	paketDeger.Name = "📦"
	paketDeger.Parent = skorlar
	local paraDeger = Instance.new("IntValue")
	paraDeger.Name = "💰"
	paraDeger.Parent = skorlar
	local unvanDeger = Instance.new("StringValue")
	unvanDeger.Name = "👑"
	unvanDeger.Value = Config.Unvanlar[1].Ikon
	unvanDeger.Parent = skorlar
	skorlar.Parent = oyuncu
	v.Skor = { Paket = paketDeger, Para = paraDeger, Unvan = unvanDeger }

	v.Arsa = bosArsaAl(oyuncu)

	oyuncu.CharacterAdded:Connect(function(karakter)
		karakterGeldi(oyuncu, karakter)
	end)
	if oyuncu.Character then
		task.spawn(karakterGeldi, oyuncu, oyuncu.Character)
	end

	local ham, basarili = kayitYukle(oyuncu)
	if oyuncu.Parent == nil or veriler[oyuncu] ~= v then
		return -- yüklenirken çıktı
	end
	local hazir = veriHazirla(ham)
	v.Para = hazir.Para
	v.ToplamPaket = hazir.ToplamPaket
	v.Sube = hazir.Sube
	v.Gelistirme = hazir.Gelistirme
	v.Stil = hazir.Stil
	v.GorevN = hazir.GorevN
	v.GorevIlerleme = hazir.GorevIlerleme
	v.YarismaRekor = hazir.YarismaRekor
	v.SonHediye = hazir.SonHediye
	v.KayitAcik = basarili
	yeniBurger(v)
	v.Hazir = true

	dukkaniKur(oyuncu)
	skorGuncelle(oyuncu)
	kafaYazisiGuncelle(oyuncu)
	durumGonder(oyuncu)
	if not v.Arsa then
		DuyuruOlay:FireClient(oyuncu, "Bütün arsalar dolu! Biri çıkınca dükkanın açılacak.")
	end
end

local function oyuncuGitti(oyuncu)
	local v = veriler[oyuncu]
	if not v then
		return
	end
	if v.Hazir then
		kaydet(oyuncu)
	end
	if v.Arsa then
		arsayiBirak(v.Arsa)
	end
	veriler[oyuncu] = nil

	-- Arsası olmayan bekleyen biri varsa ona ver
	for bekleyen, bv in pairs(veriler) do
		if bv.Arsa == nil then
			local a = bosArsaAl(bekleyen)
			if not a then
				break
			end
			bv.Arsa = a
			if bv.Hazir then
				dukkaniKur(bekleyen)
				durumGonder(bekleyen)
			end
			task.spawn(evineIsinla, bekleyen)
		end
	end
end

Players.PlayerAdded:Connect(oyuncuGeldi)
Players.PlayerRemoving:Connect(oyuncuGitti)
for _, oyuncu in ipairs(Players:GetPlayers()) do
	task.spawn(oyuncuGeldi, oyuncu)
end

----------------------------------------------------------------------
-- Oyuncu istekleri
----------------------------------------------------------------------
-- saniyede en fazla (1 / KatlamaBeklemesi) tıklama, küçük patlamalara izin var
local JETON_KAPASITE = 4
local function jetonHarca(v)
	local simdi = os.clock()
	v.Jeton = math.min(JETON_KAPASITE, v.Jeton + (simdi - v.SonJeton) / Config.KatlamaBeklemesi)
	v.SonJeton = simdi
	if v.Jeton < 1 then
		return false
	end
	v.Jeton -= 1
	return true
end

-- Aynı isteği çok sık yapmasın
local function cokSik(v, ad, sure)
	local simdi = os.clock()
	if v.Son[ad] and simdi - v.Son[ad] < sure then
		return true
	end
	v.Son[ad] = simdi
	return false
end

KatlaOlay.OnServerEvent:Connect(function(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or not v.Arsa then
		return
	end
	if not jetonHarca(v) then
		durumGonder(oyuncu) -- ekran fazladan saydıysa düzelsin
		return
	end
	local y = v.Yarisma
	if y and os.clock() >= y.Baslangic and os.clock() < y.Bitis then
		y.Sayac += 1
	end
	katla(oyuncu, Ekonomi.TikBasinaKatlama(v.Gelistirme))
end)

DurumIsteOlay.OnServerEvent:Connect(function(oyuncu)
	local v = veriler[oyuncu]
	if v and not cokSik(v, "Durum", 0.5) then
		durumGonder(oyuncu)
	end
end)

EvimeGitOlay.OnServerEvent:Connect(function(oyuncu)
	local v = veriler[oyuncu]
	if v and not cokSik(v, "Ev", 1) then
		evineIsinla(oyuncu)
	end
end)

local BINA_PARCASI = {
	Makine = true, Duvar = true, Cati = true, Oturma = true, Dekor = true, DevTabela = true,
	Asci = true, Kasiyer = true, Teknisyen = true, Temizlikci = true,
}

SatinAlOlay.OnServerEvent:Connect(function(oyuncu, anahtar)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or type(anahtar) ~= "string" then
		return
	end
	local g = Ekonomi.GelistirmeBul(anahtar)
	if not g or not Ekonomi.KilidiAcik(v.Gelistirme, anahtar) then
		return
	end
	local seviye = v.Gelistirme[anahtar] or 0
	local fiyat = Ekonomi.Fiyat(anahtar, seviye)
	if not fiyat or v.Para < fiyat then
		durumGonder(oyuncu)
		return
	end
	v.Para -= fiyat
	v.Gelistirme[anahtar] = seviye + 1
	if BINA_PARCASI[anahtar] then
		dukkaniKur(oyuncu)
	end
	skorGuncelle(oyuncu)
	durumGonder(oyuncu)
end)

SubeAcOlay.OnServerEvent:Connect(function(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or cokSik(v, "Sube", 2) then
		return
	end
	local fiyat = Ekonomi.SubeFiyati(v.Sube)
	if v.Para < fiyat then
		durumGonder(oyuncu)
		return
	end
	v.Sube += 1
	v.Para = 0
	v.Gelistirme = Ekonomi.BosGelistirmeler()
	v.MakineBirikim = {}
	v.AsciBirikim = 0
	yeniBurger(v)
	dukkaniKur(oyuncu)
	skorGuncelle(oyuncu)
	kafaYazisiGuncelle(oyuncu)
	durumGonder(oyuncu)
	DuyuruOlay:FireAllClients("🏙️ %s %d. şubesini açtı!", oyuncu.DisplayName, v.Sube + 1)
	task.spawn(kaydet, oyuncu)
end)

local function adiFiltrele(oyuncu, ad)
	local ok, sonuc = pcall(function()
		local filtre = TextService:FilterStringAsync(ad, oyuncu.UserId)
		return filtre:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(sonuc) == "string" then
		return sonuc
	end
	return nil
end

StilSecOlay.OnServerEvent:Connect(function(oyuncu, istek)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or type(istek) ~= "table" or cokSik(v, "Stil", 1.5) then
		return
	end
	local logo, renk, ad = istek.Logo, istek.Renk, istek.Ad
	if type(logo) ~= "number" or type(renk) ~= "number" or type(ad) ~= "string" then
		return
	end
	logo = math.floor(logo)
	renk = math.floor(renk)
	if logo < 1 or logo > #Config.Logolar or renk < 1 or renk > #Config.Renkler then
		return
	end
	-- kontrol karakterlerini ve baştaki/sondaki boşlukları temizle
	ad = string.gsub(ad, "%c", "")
	ad = string.match(ad, "^%s*(.-)%s*$") or ""
	local uzunluk = utf8.len(ad)
	if uzunluk == nil or uzunluk > Config.AdEnUzun then
		DuyuruOlay:FireClient(oyuncu, "Dükkan adı en fazla %d harf olabilir.", Config.AdEnUzun)
		return
	end
	if uzunluk == 0 then
		ad = varsayilanAd(oyuncu)
	end
	local temiz = adiFiltrele(oyuncu, ad)
	if not temiz then
		temiz = varsayilanAd(oyuncu)
		DuyuruOlay:FireClient(oyuncu, 'İsim kontrol edilemedi, şimdilik "%s" yazdık.', temiz)
	elseif temiz ~= ad then
		DuyuruOlay:FireClient(oyuncu, "Bu isim Roblox kurallarına uymuyor, bazı harfler gizlendi.")
	end
	v.Stil = { Logo = logo, Renk = renk, Ad = temiz }
	dukkaniKur(oyuncu)
	durumGonder(oyuncu)
	task.spawn(kaydet, oyuncu)
end)

----------------------------------------------------------------------
-- Paketleme makineleri (otomasyon)
----------------------------------------------------------------------
local URETIM_ARALIGI = 0.25
local EN_FAZLA_GORUNTU = 80 -- bir turda ekranlara en fazla kaç kutu gönderilsin

task.spawn(function()
	local son = os.clock()
	while true do
		task.wait(URETIM_ARALIGI)
		local simdi = os.clock()
		local dt = math.min(simdi - son, 2)
		son = simdi
		local liste = {}
		for oyuncu, v in pairs(veriler) do
			-- Aşçı: tezgahta oyuncunun yerine katlar
			local asci = Ekonomi.AsciAraligi(v.Gelistirme)
			if v.Hazir and v.Arsa and asci then
				v.AsciBirikim += dt
				local tur = 0
				while v.AsciBirikim >= asci and tur < 4 do
					v.AsciBirikim -= asci
					tur += 1
					katla(oyuncu, 1, true)
				end
				v.AsciBirikim = math.min(v.AsciBirikim, asci) -- takılma olursa birikmesin
			end
			local adet = math.min(v.Gelistirme.Makine or 0, #Config.Yerlesim.MakineX)
			if v.Hazir and v.Arsa and adet > 0 then
				local sure = Ekonomi.MakineSuresi(v.Gelistirme)
				local sans = Ekonomi.AltinSansi(v.Gelistirme)
				local eskiUnvan = Ekonomi.UnvanIndex(v.ToplamPaket)
				local uretti = false
				local ekstra = ekstraCarpan(v)
				for m = 1, adet do
					-- makineler aynı anda değil, sırayla çalışsın
					local birikim = (v.MakineBirikim[m] or (m - 1) / adet * sure) + dt
					while birikim >= sure do
						birikim -= sure
						local altin = rastgele:NextNumber() < sans
						local deger = Ekonomi.PaketDegeri(altin, v.Gelistirme, v.Sube, ekstra)
						v.Para += deger
						v.ToplamPaket += 1
						gorevIlerle(v, "Para", deger)
						if altin then
							gorevIlerle(v, "Altin", 1)
						end
						uretti = true
						if #liste < EN_FAZLA_GORUNTU then
							table.insert(liste, { v.Arsa.Index, m, altin })
						end
					end
					v.MakineBirikim[m] = birikim
				end
				if uretti then
					skorGuncelle(oyuncu)
					unvanKontrol(oyuncu, eskiUnvan)
					durumGonder(oyuncu)
				end
			end
		end
		if #liste > 0 then
			UretimOlay:FireAllClients(liste)
		end
	end
end)

----------------------------------------------------------------------
-- Meydandaki NPC'ler: görev ustası, huss yarışması hakemi, hediyeci
----------------------------------------------------------------------
local npcKlasoru = Instance.new("Folder")
npcKlasoru.Name = "NPCler"
npcKlasoru.Parent = harita

local function npcYap(anahtar, bilgi, eylem, tetik)
	local konum = bilgi.Yer
	local cf = CFrame.lookAt(konum, Vector3.new(0, konum.Y, 0)) -- meydanın ortasına bakar
	local insan = Gorsel.Insan(cf, {
		Gomlek = bilgi.Gomlek,
		Pantolon = Color3.fromRGB(50, 50, 60),
		Ten = Gorsel.Tenler[2],
		Yuz = bilgi.Yuz,
		Sapka = anahtar == "Gorev" and "sef" or "kep",
		SapkaRenk = Color3.fromRGB(250, 205, 50),
	})
	local m = Instance.new("Model")
	m.Name = "NPC_" .. anahtar
	for _, p in ipairs(insan.Liste) do
		p.CanCollide = true
		p.Parent = m
	end
	m.PrimaryPart = insan.Govde
	m:SetAttribute("Rol", "NPC")
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(9, 0, 2.2, 0)
	bb.StudsOffset = Vector3.new(0, 2.9, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = insan.Bas
	local ad = Instance.new("TextLabel")
	ad.BackgroundTransparency = 1
	ad.Size = UDim2.fromScale(1, 0.5)
	ad.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	ad.TextScaled = true
	ad.TextColor3 = Color3.new(1, 1, 1)
	ad.TextStrokeTransparency = 0.2
	ad.Text = bilgi.Ad
	ad.Parent = bb
	local unvanYazi = ad:Clone()
	unvanYazi.Position = UDim2.fromScale(0, 0.5)
	unvanYazi.TextColor3 = Color3.fromRGB(255, 220, 80)
	unvanYazi.Text = bilgi.Unvan
	unvanYazi.Parent = bb
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = eylem
	pr.ObjectText = bilgi.Ad
	pr.KeyboardKeyCode = Enum.KeyCode.F
	pr.GamepadKeyCode = Enum.KeyCode.ButtonX
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr.Parent = insan.Govde
	pr.Triggered:Connect(function(oyuncu)
		tetik(oyuncu)
	end)
	m.Parent = npcKlasoru
	return m, cf
end

-- Görev ustası: görev penceresini açar
npcYap("Gorev", Config.NPCler.Gorev, "Konuş", function(oyuncu)
	local v = veriler[oyuncu]
	if v and v.Hazir then
		durumGonder(oyuncu)
		NPCOlay:FireClient(oyuncu, "Gorev")
	end
end)

GorevAlOlay.OnServerEvent:Connect(function(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or cokSik(v, "Gorev", 0.5) then
		return
	end
	local _, hedef = Ekonomi.Gorev(v.GorevN)
	if v.GorevIlerleme < hedef then
		return
	end
	local odul = gorevOdulu(v)
	v.Para += odul
	v.GorevN += 1
	v.GorevIlerleme = 0
	DuyuruOlay:FireClient(oyuncu, "📜 Görev tamam! +%s para", Ekonomi.Kisalt(odul))
	skorGuncelle(oyuncu)
	durumGonder(oyuncu)
end)

-- Huss Yarışması: 3-2-1, sonra 15 saniye boyunca KATLA'ya basabildiğin kadar bas
local sunucuRekoru = 0
local function yarismaBaslat(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or not v.Arsa or v.Yarisma then
		return
	end
	local kalan = (v.YarismaSon or -1e9) + Config.Yarisma.Bekleme - os.clock()
	if kalan > 0 then
		DuyuruOlay:FireClient(oyuncu, "Hakem Hülya: Biraz dinlen! %d saniye sonra tekrar gel.", math.ceil(kalan))
		return
	end
	local simdi = os.clock()
	v.Yarisma = { Baslangic = simdi + 3, Bitis = simdi + 3 + Config.Yarisma.Sure, Sayac = 0 }
	YarismaOlay:FireClient(oyuncu, { Durum = "basladi", GeriSayim = 3, Sure = Config.Yarisma.Sure, Rekor = v.YarismaRekor })
end
npcYap("Yarisma", Config.NPCler.Yarisma, "Yarış!", yarismaBaslat)

task.spawn(function()
	while true do
		task.wait(0.1)
		local simdi = os.clock()
		for oyuncu, v in pairs(veriler) do
			local y = v.Yarisma
			if y and simdi >= y.Bitis then
				v.Yarisma = nil
				v.YarismaSon = simdi
				local paket = Ekonomi.PaketDegeri(false, v.Gelistirme, v.Sube, ekstraCarpan(v))
				local odul = math.floor(y.Sayac * paket * Config.Yarisma.TikOdulu)
				v.Para += odul
				local yeniRekor = y.Sayac > v.YarismaRekor
				if yeniRekor then
					v.YarismaRekor = y.Sayac
				end
				YarismaOlay:FireClient(oyuncu, { Durum = "bitti", Sayac = y.Sayac, Odul = odul, Rekor = v.YarismaRekor, YeniRekor = yeniRekor })
				if y.Sayac > sunucuRekoru and y.Sayac > 0 then
					sunucuRekoru = y.Sayac
					DuyuruOlay:FireAllClients("🏆 %s Huss Yarışmasında %d tık! Kasaba rekoru!", oyuncu.DisplayName, y.Sayac)
				end
				skorGuncelle(oyuncu)
				durumGonder(oyuncu)
			end
		end
	end
end)

-- Hediyeci: her 10 dakikada bir bedava hediye
local function hediyeVer(oyuncu)
	local v = veriler[oyuncu]
	if not v or not v.Hazir or cokSik(v, "Hediye", 1) then
		return
	end
	local kalan = v.SonHediye + Config.Hediye.Bekleme - os.time()
	if kalan > 0 then
		DuyuruOlay:FireClient(oyuncu, "Hediyeci Hasan: Sıradaki hediye %d:%02d sonra! 🎁", kalan // 60, kalan % 60)
		return
	end
	v.SonHediye = os.time()
	if rastgele:NextNumber() < 0.3 then
		v.IkiKatBitis = os.clock() + Config.Hediye.IkiKatSuresi
		oyuncu:SetAttribute("IkiKatBitis", workspace:GetServerTimeNow() + Config.Hediye.IkiKatSuresi)
		DuyuruOlay:FireClient(oyuncu, "🎁 Hediye: %d saniye boyunca 2 KAT PARA! 🔥", Config.Hediye.IkiKatSuresi)
	else
		local para = math.max(
			Config.Hediye.EnAzPara,
			math.floor(Ekonomi.MakineGeliri(v.Gelistirme, v.Sube) * Config.Hediye.ParaSaniye),
			Ekonomi.PaketDegeri(false, v.Gelistirme, v.Sube) * 20
		)
		para = math.floor(para * rastgele:NextNumber(1, 2))
		v.Para += para
		DuyuruOlay:FireClient(oyuncu, "🎁 Hediye: +%s para!", Ekonomi.Kisalt(para))
	end
	skorGuncelle(oyuncu)
	durumGonder(oyuncu)
end
local hediyeNpc, hediyeCf = npcYap("Hediye", Config.NPCler.Hediye, "Hediyeni Al", hediyeVer)
do
	-- NPC'nin yanında kocaman bir hediye kutusu
	local kutuCf = hediyeCf * CFrame.new(3.6, 1.8, 0)
	local kutu = Gorsel.Parca({ Name = "HediyeKutusu", Size = Vector3.new(3.4, 3.4, 3.4), CFrame = kutuCf, Color = Color3.fromRGB(220, 50, 70), CanCollide = true })
	kutu.Parent = hediyeNpc
	for _, boy in ipairs({ Vector3.new(3.5, 3.5, 0.6), Vector3.new(0.6, 3.5, 3.5) }) do
		local serit = Gorsel.Parca({ Name = "Kurdele", Size = boy, CFrame = kutuCf, Color = Color3.fromRGB(255, 215, 60) })
		serit.Parent = hediyeNpc
	end
	local fiyonk = Gorsel.Parca({ Name = "Fiyonk", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = kutuCf * CFrame.new(0, 2.1, 0), Color = Color3.fromRGB(255, 215, 60) })
	fiyonk.Parent = hediyeNpc
end

-- Altın Saat: arada bir bütün kasabada paketler 2 kat para eder
task.spawn(function()
	while true do
		task.wait(rastgele:NextNumber(Config.AltinSaat.EnAz, Config.AltinSaat.EnCok))
		altinSaatBitis = os.clock() + Config.AltinSaat.Sure
		ReplicatedStorage:SetAttribute("AltinSaatBitis", workspace:GetServerTimeNow() + Config.AltinSaat.Sure)
		DuyuruOlay:FireAllClients("⏰ ALTIN SAAT! %d saniye boyunca bütün paketler 2 kat para! 🔥", Config.AltinSaat.Sure)
		for oyuncu in pairs(veriler) do
			task.spawn(durumGonder, oyuncu)
		end
		task.wait(Config.AltinSaat.Sure + 0.2)
		for oyuncu in pairs(veriler) do
			task.spawn(durumGonder, oyuncu)
		end
	end
end)

----------------------------------------------------------------------
-- Otomatik kayıt
----------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(60)
		for oyuncu in pairs(veriler) do
			task.spawn(kaydet, oyuncu)
		end
	end
end)

game:BindToClose(function()
	local bekleyen = 0
	for oyuncu, v in pairs(veriler) do
		if v.Hazir and v.KayitAcik then
			bekleyen += 1
			task.spawn(function()
				kaydet(oyuncu)
				bekleyen -= 1
			end)
		end
	end
	local baslangic = os.clock()
	while bekleyen > 0 and os.clock() - baslangic < 25 do
		task.wait(0.1)
	end
end)

print("[Burger İmparatoru] Sunucu hazır! Arsa sayısı: " .. #arsalar)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Dukkan</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Oyuncunun dükkanını arsasına kurar
-- Geliştirme aldıkça dükkan büyür: tezgah ve bant -> makineler -> duvarlar -> çatı ve neon tabela
-- -> masalar -> çiçek ve ışıklar -> çatıda dev burger.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Ortak = ReplicatedStorage:WaitForChild("Ortak")
local Config = require(Ortak:WaitForChild("Config"))
local Gorsel = require(Ortak:WaitForChild("Gorsel"))
local Ekonomi = require(Ortak:WaitForChild("Ekonomi"))

local Dukkan = {}

local Y = Config.Yerlesim
local TEPE = Y.TezgahYuksekligi
local METAL = Color3.fromRGB(150, 155, 165)
local KOYU_METAL = Color3.fromRGB(70, 72, 80)
local BANT = Color3.fromRGB(45, 45, 50)
local AHSAP = Color3.fromRGB(150, 98, 58)
local BEYAZ = Color3.fromRGB(245, 245, 240)

-- Arsanın üst yüzünün ortası (-Z = yola bakan ön)
function Dukkan.Cerceve(arsa)
	local taban = arsa:FindFirstChild("Taban")
	return taban.CFrame * CFrame.new(0, taban.Size.Y / 2, 0)
end

local function yazi(ebeveyn, metin, renk, oz)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	l.TextScaled = true
	l.Text = metin
	l.TextColor3 = renk or Color3.new(1, 1, 1)
	for k, v in pairs(oz or {}) do
		l[k] = v
	end
	l.Parent = ebeveyn
	return l
end

function Dukkan.Kur(arsa, veri)
	local eski = arsa:FindFirstChild("Dukkan")
	if eski then
		eski:Destroy()
	end
	local klasor = Instance.new("Folder")
	klasor.Name = "Dukkan"
	local F = Dukkan.Cerceve(arsa)

	local function blok(ad, boyut, merkez, renk, malzeme, oz)
		local p = Gorsel.Parca({
			Name = ad,
			Size = boyut,
			CFrame = F * merkez,
			Color = renk,
			Material = malzeme or Enum.Material.SmoothPlastic,
			CanCollide = true,
		})
		for k, v in pairs(oz or {}) do
			p[k] = v
		end
		p.Parent = klasor
		return p
	end
	local function dikDisk(ad, kalinlik, cap, merkez, renk, malzeme)
		local p = Gorsel.Disk(F * merkez, kalinlik, cap, renk, malzeme)
		p.Name = ad
		p.CanCollide = true
		p.Parent = klasor
		return p
	end
	local function tabelaYazisi(p, yuz, ust, alt, arkaRenk, parlak)
		local sg = Instance.new("SurfaceGui")
		sg.Face = yuz
		sg.LightInfluence = parlak and 0 or 0.5
		sg.Brightness = parlak and 2 or 1
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 30
		sg.Parent = p
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = arkaRenk
		f.Parent = sg
		yazi(f, ust, Color3.new(1, 1, 1), { Size = UDim2.fromScale(0.94, 0.62), Position = UDim2.fromScale(0.03, 0.04) })
		if alt then
			yazi(f, alt, Color3.fromRGB(255, 240, 200), { Size = UDim2.fromScale(0.9, 0.28), Position = UDim2.fromScale(0.05, 0.68) })
		end
		local cizgi = Instance.new("UIStroke")
		cizgi.Color = Color3.new(1, 1, 1)
		cizgi.Thickness = 6
		cizgi.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		cizgi.Parent = f
		return sg
	end

	if not veri then
		-- Boş arsa: küçük bir tabela
		arsa:SetAttribute("Sahip", 0)
		arsa:SetAttribute("Makine", 0)
		arsa:SetAttribute("Un", 1)
		arsa:SetAttribute("Oturma", false)
		local p = Y.TabelaYeri
		for _, x in ipairs({ -3.5, 3.5 }) do
			blok("Direk", Vector3.new(0.5, 6, 0.5), CFrame.new(p.X + x, 3, p.Z), AHSAP, Enum.Material.Wood)
		end
		local pano = blok("Pano", Vector3.new(9, 3.5, 0.4), CFrame.new(p.X, 5.5, p.Z), Color3.fromRGB(90, 90, 95), Enum.Material.Wood)
		tabelaYazisi(pano, Enum.NormalId.Front, "🍔 BOŞ ARSA", "Bir oyuncu bekliyor", Color3.fromRGB(90, 90, 95))
		tabelaYazisi(pano, Enum.NormalId.Back, "🍔 BOŞ ARSA", "Bir oyuncu bekliyor", Color3.fromRGB(90, 90, 95))
		klasor.Parent = arsa
		return
	end

	local stil = veri.Stil
	local renk = stil.Renk
	local acik = renk:Lerp(Color3.new(1, 1, 1), 0.6)
	local g = veri.Gelistirme
	local function var(anahtar)
		return (g[anahtar] or 0) > 0
	end
	local makineSayisi = math.clamp(g.Makine or 0, 0, #Y.MakineX)

	arsa:SetAttribute("Sahip", veri.UserId)
	arsa:SetAttribute("Renk", renk)
	arsa:SetAttribute("Logo", stil.Logo)
	arsa:SetAttribute("Ad", stil.Ad)
	arsa:SetAttribute("Makine", makineSayisi)
	arsa:SetAttribute("Un", Ekonomi.UnCarpani(g))
	arsa:SetAttribute("Oturma", var("Oturma"))

	local bm, bb = Y.BinaMerkez, Y.BinaBoyu
	local onZ = bm.Z - bb.Z / 2 -- binanın ön duvarı
	local arkaZ = bm.Z + bb.Z / 2
	local solX, sagX = bm.X - bb.X / 2, bm.X + bb.X / 2

	-- Zemin (dükkan renginde, kenarı beyaz)
	blok("Zemin", Vector3.new(bb.X, 0.3, bb.Z), CFrame.new(bm.X, 0.15, bm.Z), acik, Enum.Material.CeramicTiles)
	blok("ZeminKenar", Vector3.new(bb.X + 1, 0.2, bb.Z + 1), CFrame.new(bm.X, 0.1, bm.Z), BEYAZ, Enum.Material.SmoothPlastic)
	-- Önde kaldırım taşı (oyuncunun durduğu yer)
	blok("OnAvlu", Vector3.new(bb.X, 0.25, 15), CFrame.new(0, 0.125, onZ - 7.5), Color3.fromRGB(215, 210, 200), Enum.Material.Pavement)

	-- Ana tezgah (KATLA kutusu burada)
	local at = Y.AnaTezgah
	blok("AnaTezgahGovde", Vector3.new(10, TEPE - 0.3, 5), CFrame.new(at.X, (TEPE - 0.3) / 2, at.Z), AHSAP, Enum.Material.WoodPlanks)
	blok("AnaTezgahSerit", Vector3.new(10.05, 0.7, 0.2), CFrame.new(at.X, 1.6, at.Z - 2.55), renk)
	blok("AnaTezgahUst", Vector3.new(10.6, 0.3, 5.6), CFrame.new(at.X, TEPE - 0.15, at.Z), BEYAZ, Enum.Material.Marble)
	-- Oyuncunun durduğu renkli halka
	local oy = Y.OyuncuYeri
	local yer = dikDisk("OyuncuYeri", 0.1, 5, CFrame.new(oy.X, 0.3, oy.Z), renk, Enum.Material.Neon)
	yer.CanCollide = false
	yer.Transparency = 0.4

	-- Teslim bandı: ana tezgahtan satış penceresine
	local s = Y.SatisNoktasi
	local bantBas, bantSon = at.X + 5, s.X - 3
	local bantOrta, bantBoy = (bantBas + bantSon) / 2, bantSon - bantBas
	blok("TeslimBandiGovde", Vector3.new(bantBoy, TEPE - 0.3, 3.4), CFrame.new(bantOrta, (TEPE - 0.3) / 2, at.Z), METAL, Enum.Material.Metal)
	blok("TeslimBandi", Vector3.new(bantBoy, 0.3, 3), CFrame.new(bantOrta, TEPE - 0.15, at.Z), BANT, Enum.Material.Fabric)

	-- Satış penceresi tezgahı + tente
	blok("SatisGovde", Vector3.new(6, TEPE - 0.3, 4), CFrame.new(s.X, (TEPE - 0.3) / 2, s.Z), AHSAP, Enum.Material.WoodPlanks)
	blok("SatisUst", Vector3.new(6.6, 0.3, 4.6), CFrame.new(s.X, TEPE - 0.15, s.Z), BEYAZ, Enum.Material.Marble)
	for _, x in ipairs({ -2.9, 2.9 }) do
		blok("TenteDirek", Vector3.new(0.3, 5, 0.3), CFrame.new(s.X + x, TEPE + 2.5, s.Z - 2.1), BEYAZ, Enum.Material.Metal)
	end
	local tente = blok("Tente", Vector3.new(7, 0.3, 5), CFrame.new(s.X, TEPE + 5.2, s.Z) * CFrame.Angles(math.rad(-12), 0, 0), renk)
	tabelaYazisi(tente, Enum.NormalId.Front, "SATIŞ", nil, renk)

	-- Ön tabela: logo + dükkan adı (iki yüzü de yazılı)
	local tp = Y.TabelaYeri
	for _, x in ipairs({ -8, 8 }) do
		blok("TabelaDirek", Vector3.new(0.7, 11.5, 0.7), CFrame.new(tp.X + x, 5.75, tp.Z), KOYU_METAL, Enum.Material.Metal)
	end
	local pano = blok("Tabela", Vector3.new(18, 6, 0.6), CFrame.new(tp.X, 9, tp.Z), renk)
	blok("TabelaCerceve", Vector3.new(18.8, 6.8, 0.4), CFrame.new(tp.X, 9, tp.Z), BEYAZ, Enum.Material.SmoothPlastic)
	local ust = stil.Logo .. " " .. stil.Ad
	local alt = "Sahibi: " .. veri.SahipAdi
	tabelaYazisi(pano, Enum.NormalId.Front, ust, alt, renk)
	tabelaYazisi(pano, Enum.NormalId.Back, ust, alt, renk)

	-- Paketleme makineleri
	for i = 1, makineSayisi do
		local x = Y.MakineX[i]
		local z = Y.MakineZ
		local m = Instance.new("Model")
		m.Name = "Makine" .. i
		local function mb(ad, boyut, merkez, rnk, mal)
			local p = blok(ad, boyut, merkez, rnk, mal)
			p.Parent = m
			return p
		end
		mb("Govde", Vector3.new(5, TEPE - 0.3, 4.4), CFrame.new(x, (TEPE - 0.3) / 2, z), METAL, Enum.Material.Metal)
		mb("Serit", Vector3.new(5.05, 0.6, 4.45), CFrame.new(x, 1.4, z), renk)
		mb("Platform", Vector3.new(5.4, 0.3, 4.8), CFrame.new(x, TEPE - 0.15, z), KOYU_METAL, Enum.Material.DiamondPlate)
		for _, dx in ipairs({ -2.5, 2.5 }) do
			mb("PresDirek", Vector3.new(0.5, 5.4, 0.5), CFrame.new(x + dx, TEPE + 2.7, z + 1.8), KOYU_METAL, Enum.Material.Metal)
		end
		mb("PresUst", Vector3.new(5.5, 0.7, 0.7), CFrame.new(x, TEPE + 5.4, z + 1.8), KOYU_METAL, Enum.Material.Metal)
		local kol = mb("Kol", Vector3.new(3.4, 0.7, 3.4), CFrame.new(x, TEPE + 4.4, z - 0.2), renk, Enum.Material.Metal)
		kol.CanCollide = false
		local isik = mb("Isik", Vector3.new(0.8, 0.8, 0.8), CFrame.new(x, TEPE + 6.1, z + 1.8), Color3.fromRGB(90, 255, 120), Enum.Material.Neon)
		isik.Shape = Enum.PartType.Ball
		-- makineden ana banda kısa bant
		local bas, son = z - 2.4, Y.BantZ + 1.5
		mb("KisaBant", Vector3.new(3, 0.3, bas - son), CFrame.new(x, TEPE - 0.15, (bas + son) / 2), BANT, Enum.Material.Fabric)
		mb("KisaBantGovde", Vector3.new(3.2, TEPE - 0.3, bas - son), CFrame.new(x, (TEPE - 0.3) / 2, (bas + son) / 2), METAL, Enum.Material.Metal)
		m.Parent = klasor
	end

	-- Ana bant (ilk makineyle gelir): makinelerin önünden satış penceresine
	if makineSayisi > 0 then
		local bx, bz = Y.BantX, Y.BantZ
		local x0 = Y.MakineX[1] - 3
		local yatayBoy = bx + 1.5 - x0
		blok("AnaBantGovde", Vector3.new(yatayBoy, TEPE - 0.3, 3.2), CFrame.new(x0 + yatayBoy / 2, (TEPE - 0.3) / 2, bz), METAL, Enum.Material.Metal)
		blok("AnaBant", Vector3.new(yatayBoy, 0.3, 3), CFrame.new(x0 + yatayBoy / 2, TEPE - 0.15, bz), BANT, Enum.Material.Fabric)
		local z1 = s.Z + 2.3
		local dikeyBoy = bz - 1.5 - z1
		blok("DonusBantGovde", Vector3.new(3.2, TEPE - 0.3, dikeyBoy), CFrame.new(bx, (TEPE - 0.3) / 2, z1 + dikeyBoy / 2), METAL, Enum.Material.Metal)
		blok("DonusBant", Vector3.new(3, 0.3, dikeyBoy), CFrame.new(bx, TEPE - 0.15, z1 + dikeyBoy / 2), BANT, Enum.Material.Fabric)
	end

	-- Duvarlar ve camlar
	if var("Duvar") then
		local H = bb.Y
		local CAM_UST = H - 4 -- camların üst kenarı
		local duvarRenk = renk:Lerp(Color3.new(1, 1, 1), 0.35)
		local cam = Color3.fromRGB(170, 215, 240)
		local function duvar(x0, x1, z, y0, y1)
			if x1 - x0 < 0.05 or y1 - y0 < 0.05 then
				return
			end
			blok("Duvar", Vector3.new(x1 - x0, y1 - y0, 1), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, z), duvarRenk, Enum.Material.Brick)
		end
		local function camPanel(x0, x1, z, y0, y1)
			blok("Cam", Vector3.new(x1 - x0, y1 - y0, 0.3), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, z), cam, Enum.Material.Glass, {
				Transparency = 0.55,
				Reflectance = 0.15,
			})
			-- beyaz cam çerçeveleri (dışarıdan bakınca vitrin gibi)
			local adet = math.max(1, math.floor((x1 - x0) / 6 + 0.5))
			for i = 1, adet - 1 do
				local x = x0 + (x1 - x0) * i / adet
				blok("CamCerceve", Vector3.new(0.35, y1 - y0, 0.5), CFrame.new(x, (y0 + y1) / 2, z - 0.1), BEYAZ, Enum.Material.SmoothPlastic)
			end
			blok("CamCerceve", Vector3.new(x1 - x0, 0.35, 0.5), CFrame.new((x0 + x1) / 2, y1, z - 0.1), BEYAZ, Enum.Material.SmoothPlastic)
			blok("CamCerceve", Vector3.new(x1 - x0, 0.35, 0.5), CFrame.new((x0 + x1) / 2, y0, z - 0.1), BEYAZ, Enum.Material.SmoothPlastic)
		end
		-- ön duvar: [sol cam] [kapı] [orta] [satış penceresi] [sağ cam]
		local fz = onZ + 0.5
		local kapi0, kapi1 = -3, 3
		local pen0, pen1 = Y.BantX - 2, Y.BantX + 2
		-- alt bant (cam altı) ve üst bant (cam üstü) ile camlı bölümler
		local function camliBolum(x0, x1)
			duvar(x0, x1, fz, 0, 3)
			camPanel(x0, x1, fz, 3, CAM_UST)
			duvar(x0, x1, fz, CAM_UST, H)
		end
		duvar(solX, solX + 2, fz, 0, H)
		camliBolum(solX + 2, kapi0 - 1)
		duvar(kapi0 - 1, kapi0, fz, 0, H)
		duvar(kapi0, kapi1, fz, 9, H) -- kapının üstü
		duvar(kapi1, kapi1 + 1, fz, 0, H)
		camliBolum(kapi1 + 1, pen0)
		duvar(pen0, pen1, fz, 0, TEPE - 0.3) -- pencerenin altı
		duvar(pen0, pen1, fz, 7.5, H) -- pencerenin üstü
		camliBolum(pen1, sagX - 2)
		duvar(sagX - 2, sagX, fz, 0, H)
		-- arka duvar
		blok("Duvar", Vector3.new(bb.X, H, 1), CFrame.new(bm.X, H / 2, arkaZ - 0.5), duvarRenk, Enum.Material.Brick)
		-- yan duvarlar (ortası camlı)
		for _, x in ipairs({ solX + 0.5, sagX - 0.5 }) do
			local z0, z1 = onZ + 1, arkaZ - 1
			local c0, c1 = onZ + 7, arkaZ - 7
			blok("Duvar", Vector3.new(1, H, c0 - z0), CFrame.new(x, H / 2, (z0 + c0) / 2), duvarRenk, Enum.Material.Brick)
			blok("Duvar", Vector3.new(1, H, z1 - c1), CFrame.new(x, H / 2, (c1 + z1) / 2), duvarRenk, Enum.Material.Brick)
			blok("Duvar", Vector3.new(1, 3, c1 - c0), CFrame.new(x, 1.5, (c0 + c1) / 2), duvarRenk, Enum.Material.Brick)
			blok("Duvar", Vector3.new(1, H - CAM_UST, c1 - c0), CFrame.new(x, (CAM_UST + H) / 2, (c0 + c1) / 2), duvarRenk, Enum.Material.Brick)
			blok("Cam", Vector3.new(0.3, CAM_UST - 3, c1 - c0), CFrame.new(x, (3 + CAM_UST) / 2, (c0 + c1) / 2), cam, Enum.Material.Glass, { Transparency = 0.55, Reflectance = 0.15 })
		end
		-- beyaz üst şerit
		blok("UstSerit", Vector3.new(bb.X + 0.6, 0.8, 1.4), CFrame.new(bm.X, H - 0.4, fz), BEYAZ)
		-- içeride, arka duvarda menü panosu (logo ve menü: her dilde aynı)
		local menu = blok("MenuPano", Vector3.new(26, 6, 0.4), CFrame.new(bm.X, H - 4.5, arkaZ - 1.2), Color3.fromRGB(45, 38, 36), Enum.Material.SmoothPlastic)
		tabelaYazisi(menu, Enum.NormalId.Front, stil.Logo .. "  🍔  🍟  🥤  " .. stil.Logo, nil, Color3.fromRGB(45, 38, 36), true)
		blok("MenuCerceve", Vector3.new(27, 7, 0.3), CFrame.new(bm.X, H - 4.5, arkaZ - 1.05), renk, Enum.Material.SmoothPlastic)
	end

	-- Çatı ve neon tabela
	if var("Cati") then
		local H = bb.Y
		blok("Cati", Vector3.new(bb.X + 2, 1, bb.Z + 2), CFrame.new(bm.X, H + 0.5, bm.Z), Color3.fromRGB(90, 90, 98), Enum.Material.Concrete)
		blok("CatiKenar", Vector3.new(bb.X + 2.4, 1.4, 0.6), CFrame.new(bm.X, H + 1.2, onZ - 1), renk)
		-- çatının yan ve arka kenarları (bina daha toplu görünsün)
		blok("CatiKenar", Vector3.new(bb.X + 2.4, 1.4, 0.6), CFrame.new(bm.X, H + 1.2, arkaZ + 1), renk)
		blok("CatiKenar", Vector3.new(0.6, 1.4, bb.Z + 2.6), CFrame.new(solX - 1, H + 1.2, bm.Z), renk)
		blok("CatiKenar", Vector3.new(0.6, 1.4, bb.Z + 2.6), CFrame.new(sagX + 1, H + 1.2, bm.Z), renk)
		-- çatıda klima kutuları
		for _, x in ipairs({ -bb.X / 2 + 7, bb.X / 2 - 7 }) do
			blok("Klima", Vector3.new(5, 2.6, 4), CFrame.new(bm.X + x, H + 2.3, arkaZ - 6), Color3.fromRGB(200, 202, 208), Enum.Material.Metal)
			dikDisk("KlimaPervane", 0.3, 3, CFrame.new(bm.X + x, H + 3.7, arkaZ - 6), Color3.fromRGB(70, 72, 80), Enum.Material.DiamondPlate)
		end
		-- tavan ışıkları
		for _, x in ipairs({ -bb.X / 4, bb.X / 4 }) do
			local lamba = blok("TavanIsigi", Vector3.new(8, 0.3, 2), CFrame.new(bm.X + x, H - 0.2, bm.Z), Color3.fromRGB(255, 245, 220), Enum.Material.Neon)
			lamba.CanCollide = false
			local tl = Instance.new("SurfaceLight")
			tl.Face = Enum.NormalId.Bottom
			tl.Range = 18
			tl.Angle = 120
			tl.Brightness = 1.2
			tl.Color = Color3.fromRGB(255, 240, 210)
			tl.Parent = lamba
		end
		local neon = blok("NeonTabela", Vector3.new(36, 7, 0.8), CFrame.new(0, H + 5, onZ - 0.6), renk:Lerp(Color3.new(0, 0, 0), 0.25))
		tabelaYazisi(neon, Enum.NormalId.Front, stil.Logo .. " " .. stil.Ad, nil, renk:Lerp(Color3.new(0, 0, 0), 0.25), true)
		local serit = blok("NeonSerit", Vector3.new(36.4, 0.4, 0.4), CFrame.new(0, H + 1.4, onZ - 1.1), renk, Enum.Material.Neon)
		serit.CanCollide = false
		local isik = Instance.new("SurfaceLight")
		isik.Face = Enum.NormalId.Front
		isik.Range = 14
		isik.Brightness = 2
		isik.Color = renk
		isik.Parent = neon
	end

	-- Oturma alanı
	if var("Oturma") then
		for i, p in ipairs(Y.Masalar) do
			local m = CFrame.new(p.X, 0, p.Z)
			dikDisk("MasaAyak", 2.6, 0.5, m * CFrame.new(0, 1.3, 0), BEYAZ, Enum.Material.Metal)
			dikDisk("Masa", 0.25, 4.4, m * CFrame.new(0, 2.7, 0), BEYAZ, Enum.Material.SmoothPlastic)
			for k = 0, 3 do
				local a = k * math.pi / 2 + math.rad(45)
				blok("Sandalye", Vector3.new(1.6, 1.6, 1.6), m * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.8, 3.4), i % 2 == 0 and renk or acik)
			end
			dikDisk("SemsiyeDirek", 7, 0.25, m * CFrame.new(0, 4.2, 0), BEYAZ, Enum.Material.Metal)
			dikDisk("Semsiye", 0.4, 7.5, m * CFrame.new(0, 7.6, 0), renk, Enum.Material.Fabric)
			dikDisk("SemsiyeTepe", 0.8, 3, m * CFrame.new(0, 8.1, 0), BEYAZ, Enum.Material.Fabric)
		end
	end

	-- Çiçek ve ışıklar
	if var("Dekor") then
		local cicekler = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 210, 60), Color3.fromRGB(180, 110, 255), Color3.fromRGB(255, 150, 60) }
		for _, aralik in ipairs({ { solX + 2.5, -5 }, { 5, Y.BantX - 3 } }) do
			local x0, x1 = aralik[1], aralik[2]
			blok("Saksi", Vector3.new(x1 - x0, 1.2, 1.4), CFrame.new((x0 + x1) / 2, 0.6, onZ - 0.9), Color3.fromRGB(150, 95, 60), Enum.Material.WoodPlanks)
			for x = x0 + 0.8, x1 - 0.8, 1.6 do
				local c = blok("Cicek", Vector3.new(1, 1, 1), CFrame.new(x, 1.6, onZ - 0.9), cicekler[math.floor(x) % #cicekler + 1])
				c.Shape = Enum.PartType.Ball
				c.CanCollide = false
			end
		end
		-- kapıya kırmızı halı
		blok("Hali", Vector3.new(5, 0.1, 9), CFrame.new(0, 0.3, onZ - 4.5), Color3.fromRGB(190, 30, 40), Enum.Material.Fabric, { CanCollide = false })
		-- ışık zinciri (çatının önünde)
		local renkler = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 220, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(120, 255, 120) }
		local k = 0
		for x = solX + 1, sagX - 1, 2.5 do
			k += 1
			local y = bb.Y - 0.9 - math.abs(math.sin(k * 0.6)) * 0.6
			local ampul = blok("Ampul", Vector3.new(0.6, 0.6, 0.6), CFrame.new(x, y, onZ - 1.2), renkler[k % #renkler + 1], Enum.Material.Neon)
			ampul.Shape = Enum.PartType.Ball
			ampul.CanCollide = false
		end
	end

	-- Çalışanlar
	local kiyafet = {
		Asci = { Gomlek = Color3.fromRGB(245, 245, 245), Pantolon = Color3.fromRGB(60, 60, 70), Sapka = "sef", Yuz = "😋" },
		Kasiyer = { Gomlek = renk, Pantolon = Color3.fromRGB(45, 45, 55), Sapka = "kep", SapkaRenk = renk, Onluk = true, Yuz = "😊" },
		Teknisyen = { Gomlek = Color3.fromRGB(70, 95, 130), Pantolon = Color3.fromRGB(45, 55, 75), Sapka = "kep", SapkaRenk = Color3.fromRGB(255, 200, 40), Yuz = "🤓" },
		Temizlikci = { Gomlek = Color3.fromRGB(110, 185, 120), Pantolon = Color3.fromRGB(50, 60, 55), Yuz = "😄" },
	}
	for anahtar, yer in pairs(Y.Calisanlar) do
		if var(anahtar) then
			local konum = Vector3.new(yer.Yer.X, 0.3, yer.Yer.Z)
			local cf = F * CFrame.lookAt(konum, konum + yer.Bakis)
			local oz = kiyafet[anahtar]
			oz.Ten = Gorsel.Tenler[(#anahtar + (veri.UserId % 5)) % #Gorsel.Tenler + 1]
			local insan = Gorsel.Insan(cf, oz)
			local m = Instance.new("Model")
			m.Name = "Calisan_" .. anahtar
			for _, p in ipairs(insan.Liste) do
				p.CanCollide = false
				p.Parent = m
			end
			if anahtar == "Temizlikci" then
				-- süpürge
				local sap = Gorsel.Parca({ Name = "Supurge", Size = Vector3.new(0.25, 4.2, 0.25), CFrame = cf * CFrame.new(1.9, 2.1, -0.6) * CFrame.Angles(math.rad(-15), 0, math.rad(8)), Color = Color3.fromRGB(150, 100, 55), Material = Enum.Material.Wood })
				sap.Parent = m
				local fir = Gorsel.Parca({ Name = "SupurgeUcu", Size = Vector3.new(1.4, 0.6, 0.5), CFrame = cf * CFrame.new(2.2, 0.3, -1.1), Color = Color3.fromRGB(230, 200, 90), Material = Enum.Material.Fabric })
				fir.Parent = m
			end
			m:SetAttribute("Rol", anahtar)
			m.PrimaryPart = insan.Govde
			m.Parent = klasor
		end
	end

	-- Çatıda dev burger
	if var("DevTabela") and var("Cati") then
		local tabanY = bb.Y + 1
		dikDisk("DevBurgerKaide", 1.2, 17, CFrame.new(0, tabanY + 0.6, bm.Z + 2), renk, Enum.Material.SmoothPlastic)
		local parcalar = Gorsel.Burger(F * CFrame.new(0, tabanY + 1.2, bm.Z + 2), 3.2, false, false)
		for _, p in ipairs(parcalar) do
			p.CanCollide = true
			p.Parent = klasor
		end
	end

	klasor.Parent = arsa
end

-- Oyuncunun ışınlanacağı yer: tezgaha bakarak
function Dukkan.OyuncuCFrame(arsa)
	local F = Dukkan.Cerceve(arsa)
	local p = Y.OyuncuYeri
	local a = Y.AnaTezgah
	local bas = F * Vector3.new(p.X, 3, p.Z)
	local hedef = F * Vector3.new(a.X, 3, a.Z)
	return CFrame.lookAt(bas, hedef)
end

return Dukkan
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">HaritaUretici</string>
          <string name="Source"><![CDATA[-- BURGER İMPARATORU - Burger Kasabası haritası
-- Ortada meydan ve dev burger heykeli, etrafında yol, yolun dışında 8 dükkan arsası,
-- köşelerde parklar, en dışta ağaçlar, tepeler ve şehir binaları.
-- Hiçbir şey "require" etmez: Config ve Gorsel dışarıdan verilir. Böylece hem oyunda
-- (harita yoksa) hem de derleme sırasında (Lune ile .rbxm dosyasına) çalışır.

local HaritaUretici = {}

local YOL_IC = 60 -- meydanın kenarı
local YOL_DIS = 80 -- yolun dış kenarı
local KALDIRIM = 88 -- kaldırımın dış kenarı (arsalar buradan başlar)
local ARSA_MERKEZ = 130 -- arsanın merkezi (meydanın ortasına uzaklık) = KALDIRIM + arsa derinliği / 2
local ARSA_KAYMA = 56 -- bir kenardaki iki arsa bu kadar sağa/sola kayık (arsa eni / 2 + 6)
local PARK = 140 -- köşe parklarının merkezi
local PARK_BOY = 60
local CEKIRDEK = 176 -- kasabanın parça zemini bu kadar; dışı oyunda gerçek çimene (Terrain) döner
local HARITA = 480 -- yarım genişlik

function HaritaUretici.Uret(Config, Gorsel)
	local rastgele = Random.new(2026)
	local parca = Gorsel.Parca
	local disk = Gorsel.Disk

	local harita = Instance.new("Model")
	harita.Name = "Harita"

	local function klasor(ad, ebeveyn)
		local f = Instance.new("Folder")
		f.Name = ad
		f.Parent = ebeveyn or harita
		return f
	end

	local function blok(ebeveyn, ad, boyut, cf, renk, malzeme, oz)
		local p = parca({
			Name = ad,
			Size = boyut,
			CFrame = cf,
			Color = renk,
			Material = malzeme or Enum.Material.SmoothPlastic,
			CanCollide = true,
		})
		for k, v in pairs(oz or {}) do
			p[k] = v
		end
		p.Parent = ebeveyn
		return p
	end

	local function top(ebeveyn, ad, cap, cf, renk, malzeme)
		local p = parca({
			Name = ad,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(cap, cap, cap),
			CFrame = cf,
			Color = renk,
			Material = malzeme or Enum.Material.Grass,
			CanCollide = true,
		})
		p.Parent = ebeveyn
		return p
	end

	------------------------------------------------------------------
	-- Zemin
	------------------------------------------------------------------
	local zemin = klasor("Zemin")
	local cimenRenk = Color3.fromRGB(96, 168, 72)
	blok(zemin, "Cimen", Vector3.new(CEKIRDEK * 2, 4, CEKIRDEK * 2), CFrame.new(0, -2, 0), cimenRenk, Enum.Material.Grass)
	-- Kasabanın dışı: oyun başlayınca sunucu bunları rüzgârda sallanan gerçek çimene çevirir
	local cayirlar = klasor("Cayirlar")
	local disEn = HARITA - CEKIRDEK
	local disOrta = (HARITA + CEKIRDEK) / 2
	blok(cayirlar, "Cayir", Vector3.new(HARITA * 2, 4, disEn), CFrame.new(0, -2, -disOrta), cimenRenk, Enum.Material.Grass)
	blok(cayirlar, "Cayir", Vector3.new(HARITA * 2, 4, disEn), CFrame.new(0, -2, disOrta), cimenRenk, Enum.Material.Grass)
	blok(cayirlar, "Cayir", Vector3.new(disEn, 4, CEKIRDEK * 2), CFrame.new(-disOrta, -2, 0), cimenRenk, Enum.Material.Grass)
	blok(cayirlar, "Cayir", Vector3.new(disEn, 4, CEKIRDEK * 2), CFrame.new(disOrta, -2, 0), cimenRenk, Enum.Material.Grass)
	-- Haritadan düşmesinler
	for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		local boy = d[1] ~= 0 and Vector3.new(2, 80, HARITA * 2) or Vector3.new(HARITA * 2, 80, 2)
		blok(zemin, "GorunmezDuvar", boy, CFrame.new(d[1] * (HARITA - 1), 40, d[2] * (HARITA - 1)), Color3.new(1, 1, 1), nil, { Transparency = 1 })
	end

	------------------------------------------------------------------
	-- Meydan
	------------------------------------------------------------------
	local meydan = klasor("Meydan")
	-- eski burgercilerdeki gibi kırmızı-beyaz damalı meydan
	local karo = 8
	local adet = (YOL_IC * 2) / karo
	for ix = 0, adet - 1 do
		for iz = 0, adet - 1 do
			local kirmizi = (ix + iz) % 2 == 0
			blok(meydan, "Karo", Vector3.new(karo, 0.4, karo), CFrame.new(-YOL_IC + karo / 2 + ix * karo, 0.2, -YOL_IC + karo / 2 + iz * karo),
				kirmizi and Color3.fromRGB(205, 52, 48) or Color3.fromRGB(248, 244, 236), Enum.Material.SmoothPlastic)
		end
	end
	-- sarı çerçeve
	local kenarRenk = Color3.fromRGB(250, 205, 60)
	local L = YOL_IC * 2 + 1
	blok(meydan, "MeydanKenari", Vector3.new(L, 0.5, 1), CFrame.new(0, 0.25, -YOL_IC), kenarRenk, Enum.Material.SmoothPlastic)
	blok(meydan, "MeydanKenari", Vector3.new(L, 0.5, 1), CFrame.new(0, 0.25, YOL_IC), kenarRenk, Enum.Material.SmoothPlastic)
	blok(meydan, "MeydanKenari", Vector3.new(1, 0.5, L), CFrame.new(-YOL_IC, 0.25, 0), kenarRenk, Enum.Material.SmoothPlastic)
	blok(meydan, "MeydanKenari", Vector3.new(1, 0.5, L), CFrame.new(YOL_IC, 0.25, 0), kenarRenk, Enum.Material.SmoothPlastic)
	local halka = disk(CFrame.new(0, 0.45, 0), 0.1, 44, Color3.fromRGB(180, 82, 70), Enum.Material.Brick)
	halka.CanCollide = true
	halka.Parent = meydan

	-- Dev burger heykeli
	local heykel = Instance.new("Model")
	heykel.Name = "DevBurgerHeykeli"
	heykel.Parent = meydan
	local kaide = disk(CFrame.new(0, 2, 0), 3.6, 20, Color3.fromRGB(245, 240, 232), Enum.Material.Marble)
	kaide.CanCollide = true
	kaide.Parent = heykel
	local serit = disk(CFrame.new(0, 3.45, 0), 0.6, 20.4, Color3.fromRGB(255, 200, 40), Enum.Material.Foil)
	serit.Parent = heykel
	local burgerParcalari, burgerBoy = Gorsel.Burger(CFrame.new(0, 3.8, 0), 3.4, false, false)
	for _, p in ipairs(burgerParcalari) do
		p.CanCollide = true
		p.Parent = heykel
	end
	local tepe = 3.8 + burgerBoy
	local altinRenk = Color3.fromRGB(255, 200, 40)
	local tac = disk(CFrame.new(0, tepe + 0.3, 0), 2, 7.5, altinRenk, Enum.Material.Foil)
	tac.Parent = heykel
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local p = Vector3.new(math.cos(a) * 3.2, tepe + 2.4, math.sin(a) * 3.2)
		blok(heykel, "TacDikeni", Vector3.new(1.2, 2.6, 1.2), CFrame.new(p) * CFrame.Angles(0, -a + math.rad(45), 0), altinRenk, Enum.Material.Foil)
		top(heykel, "Mucevher", 1, CFrame.new(p + Vector3.new(0, 1.7, 0)), i % 2 == 0 and Color3.fromRGB(255, 40, 70) or Color3.fromRGB(40, 140, 255), Enum.Material.Neon)
	end
	local baslikTutucu = blok(heykel, "BaslikNoktasi", Vector3.new(1, 1, 1), CFrame.new(0, tepe + 12, 0), Color3.new(1, 1, 1), nil, {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(54, 0, 9, 0)
	bb.MaxDistance = 600
	bb.LightInfluence = 0
	bb.Parent = baslikTutucu
	local baslik = Instance.new("TextLabel")
	baslik.BackgroundTransparency = 1
	baslik.Size = UDim2.fromScale(1, 1)
	baslik.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	baslik.TextScaled = true
	baslik.Text = "🍔 BURGER İMPARATORU 👑"
	baslik.TextColor3 = Color3.fromRGB(255, 225, 90)
	baslik.Parent = bb
	local bc = Instance.new("UIStroke")
	bc.Color = Color3.fromRGB(90, 30, 10)
	bc.Thickness = 4
	bc.Parent = baslik

	-- Dev patates kızartması (meydanın köşesinde)
	local function devPatates(merkez)
		local m = Instance.new("Model")
		m.Name = "DevPatates"
		local cf = CFrame.new(merkez)
		blok(m, "Kutu", Vector3.new(7, 7, 4.5), cf * CFrame.new(0, 3.5, 0), Color3.fromRGB(215, 40, 40), Enum.Material.SmoothPlastic)
		blok(m, "KutuUst", Vector3.new(7.6, 1, 5), cf * CFrame.new(0, 7.2, 0), Color3.fromRGB(235, 55, 50), Enum.Material.SmoothPlastic)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.CanvasSize = Vector2.new(200, 200)
		sg.Parent = m:FindFirstChild("Kutu")
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.TextScaled = true
		t.Text = "🍟"
		t.Parent = sg
		for i = 1, 14 do
			local x = rastgele:NextNumber(-2.8, 2.8)
			local z = rastgele:NextNumber(-1.6, 1.6)
			local boy = rastgele:NextNumber(4, 7)
			blok(m, "Patates", Vector3.new(0.7, boy, 0.7), cf * CFrame.new(x, 7 + boy / 2 - 1.5, z) * CFrame.Angles(rastgele:NextNumber(-0.15, 0.15), 0, rastgele:NextNumber(-0.2, 0.2)),
				Color3.fromRGB(250, 205, 70), Enum.Material.SmoothPlastic)
		end
		return m
	end
	-- Dev kola bardağı
	local function devKola(merkez)
		local m = Instance.new("Model")
		m.Name = "DevKola"
		local cf = CFrame.new(merkez)
		local govde = disk(cf * CFrame.new(0, 5, 0), 10, 6.5, Color3.fromRGB(215, 40, 40), Enum.Material.SmoothPlastic)
		govde.CanCollide = true
		govde.Parent = m
		disk(cf * CFrame.new(0, 5, 0), 3, 6.7, Color3.fromRGB(250, 250, 250), Enum.Material.SmoothPlastic).Parent = m
		disk(cf * CFrame.new(0, 10.3, 0), 0.6, 7, Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic).Parent = m
		local pipet = disk(cf * CFrame.new(0.8, 13, 0) * CFrame.Angles(0, 0, math.rad(-12)), 6, 0.6, Color3.fromRGB(255, 220, 60), Enum.Material.SmoothPlastic)
		pipet.Parent = m
		return m
	end
	devPatates(Vector3.new(38, 0.4, 38)).Parent = meydan
	devKola(Vector3.new(-38, 0.4, 38)).Parent = meydan

	-- Fıskiyeler
	for _, k in ipairs({ { 1, -1 }, { -1, -1 } }) do
		local m = Vector3.new(k[1] * 38, 0, k[2] * 38)
		local havuz = disk(CFrame.new(m + Vector3.new(0, 0.9, 0)), 1.4, 13, Color3.fromRGB(190, 190, 195), Enum.Material.Concrete)
		havuz.CanCollide = true
		havuz.Parent = meydan
		local su = disk(CFrame.new(m + Vector3.new(0, 1.62, 0)), 0.1, 11.6, Color3.fromRGB(70, 160, 230), Enum.Material.Glass)
		su.Transparency = 0.25
		su.Reflectance = 0.2
		su.Parent = meydan
		local sutun = disk(CFrame.new(m + Vector3.new(0, 3, 0)), 4, 1.4, Color3.fromRGB(200, 200, 205), Enum.Material.Marble)
		sutun.Parent = meydan
		local fiskiye = Instance.new("ParticleEmitter")
		fiskiye.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		fiskiye.Rate = 40
		fiskiye.Lifetime = NumberRange.new(0.8, 1.2)
		fiskiye.Speed = NumberRange.new(12, 16)
		fiskiye.SpreadAngle = Vector2.new(12, 12)
		fiskiye.Acceleration = Vector3.new(0, -30, 0)
		fiskiye.Size = NumberSequence.new(0.5, 0.2)
		fiskiye.Color = ColorSequence.new(Color3.fromRGB(180, 225, 255))
		fiskiye.Transparency = NumberSequence.new(0.2, 1)
		fiskiye.EmissionDirection = Enum.NormalId.Right -- silindir yattığı için "sağ" yukarı bakar
		fiskiye.Parent = sutun
	end

	-- Banklar ve saksılar
	local function bank(cf)
		local m = Instance.new("Model")
		m.Name = "Bank"
		blok(m, "Oturak", Vector3.new(6, 0.4, 2), cf * CFrame.new(0, 1.6, 0), Color3.fromRGB(150, 95, 55), Enum.Material.Wood)
		blok(m, "Sirt", Vector3.new(6, 1.6, 0.3), cf * CFrame.new(0, 2.6, 0.85), Color3.fromRGB(150, 95, 55), Enum.Material.Wood)
		for _, x in ipairs({ -2.5, 2.5 }) do
			blok(m, "Ayak", Vector3.new(0.4, 1.4, 1.8), cf * CFrame.new(x, 0.7, 0), Color3.fromRGB(50, 50, 55), Enum.Material.Metal)
		end
		return m
	end
	local function saksi(ebeveyn, p)
		local s = disk(CFrame.new(p + Vector3.new(0, 1, 0)), 2, 5, Color3.fromRGB(200, 120, 80), Enum.Material.Brick)
		s.CanCollide = true
		s.Parent = ebeveyn
		local renkler = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 210, 60), Color3.fromRGB(180, 110, 255), Color3.fromRGB(255, 140, 50) }
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			top(ebeveyn, "Cicek", 1.2, CFrame.new(p + Vector3.new(math.cos(a) * 1.3, 2.4, math.sin(a) * 1.3)), renkler[(i - 1) % #renkler + 1], Enum.Material.SmoothPlastic)
		end
		top(ebeveyn, "Yaprak", 3, CFrame.new(p + Vector3.new(0, 2.2, 0)), Color3.fromRGB(70, 150, 60))
	end
	for _, k in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		local yon = Vector3.new(k[1], 0, k[2])
		local yan = Vector3.new(-k[2], 0, k[1])
		for _, s in ipairs({ -1, 1 }) do
			local p = yon * 16 + yan * s * 7
			bank(CFrame.lookAt(p, p + yon)).Parent = meydan
			saksi(meydan, yon * 16 + yan * s * 14)
		end
	end

	------------------------------------------------------------------
	-- Yol, kaldırım, yaya geçidi, lambalar
	------------------------------------------------------------------
	local yol = klasor("Yol")
	local asfalt = Color3.fromRGB(58, 60, 66)
	local yolEn = YOL_DIS - YOL_IC
	local orta = (YOL_IC + YOL_DIS) / 2
	-- dört kenar: kuzey/güney tam boy, doğu/batı aradaki kısım
	blok(yol, "Asfalt", Vector3.new(YOL_DIS * 2, 0.3, yolEn), CFrame.new(0, 0.15, -orta), asfalt, Enum.Material.Asphalt)
	blok(yol, "Asfalt", Vector3.new(YOL_DIS * 2, 0.3, yolEn), CFrame.new(0, 0.15, orta), asfalt, Enum.Material.Asphalt)
	blok(yol, "Asfalt", Vector3.new(yolEn, 0.3, YOL_IC * 2), CFrame.new(-orta, 0.15, 0), asfalt, Enum.Material.Asphalt)
	blok(yol, "Asfalt", Vector3.new(yolEn, 0.3, YOL_IC * 2), CFrame.new(orta, 0.15, 0), asfalt, Enum.Material.Asphalt)
	-- kesik orta çizgiler
	local beyaz = Color3.fromRGB(240, 240, 235)
	for z = -orta + 4, orta - 4, 9 do
		for _, x in ipairs({ -orta, orta }) do
			blok(yol, "Cizgi", Vector3.new(0.5, 0.05, 4.5), CFrame.new(x, 0.32, z), beyaz, nil, { CanCollide = false })
		end
	end
	for x = -orta + 4, orta - 4, 9 do
		for _, z in ipairs({ -orta, orta }) do
			blok(yol, "Cizgi", Vector3.new(4.5, 0.05, 0.5), CFrame.new(x, 0.32, z), beyaz, nil, { CanCollide = false })
		end
	end
	-- dış kaldırım
	local kaldirimRenk = Color3.fromRGB(198, 198, 202)
	local kEn = KALDIRIM - YOL_DIS
	local kOrta = (KALDIRIM + YOL_DIS) / 2
	blok(yol, "Kaldirim", Vector3.new(KALDIRIM * 2, 0.5, kEn), CFrame.new(0, 0.25, -kOrta), kaldirimRenk, Enum.Material.Concrete)
	blok(yol, "Kaldirim", Vector3.new(KALDIRIM * 2, 0.5, kEn), CFrame.new(0, 0.25, kOrta), kaldirimRenk, Enum.Material.Concrete)
	blok(yol, "Kaldirim", Vector3.new(kEn, 0.5, YOL_DIS * 2), CFrame.new(-kOrta, 0.25, 0), kaldirimRenk, Enum.Material.Concrete)
	blok(yol, "Kaldirim", Vector3.new(kEn, 0.5, YOL_DIS * 2), CFrame.new(kOrta, 0.25, 0), kaldirimRenk, Enum.Material.Concrete)
	-- yaya geçitleri (meydandan her arsaya)
	for _, k in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		local yon = Vector3.new(k[1], 0, k[2])
		local yan = Vector3.new(-k[2], 0, k[1])
		for _, s in ipairs({ -ARSA_KAYMA, ARSA_KAYMA }) do
			for i = -3, 3 do
				local p = yon * orta + yan * (s + i * 1.6) + Vector3.new(0, 0.33, 0)
				blok(yol, "YayaGecidi", Vector3.new(1, 0.05, yolEn - 2), CFrame.lookAt(p, p + yon), beyaz, nil, { CanCollide = false })
			end
		end
	end
	-- sokak lambaları
	local function lamba(p, bakis)
		local m = Instance.new("Model")
		m.Name = "Lamba"
		local cf = CFrame.lookAt(p, p + bakis)
		local direk = disk(cf * CFrame.new(0, 6, 0), 12, 0.6, Color3.fromRGB(40, 42, 48), Enum.Material.Metal)
		direk.CanCollide = true
		direk.Parent = m
		blok(m, "Kol", Vector3.new(0.4, 0.4, 3), cf * CFrame.new(0, 11.8, -1.3), Color3.fromRGB(40, 42, 48), Enum.Material.Metal)
		local bas = blok(m, "Ampul", Vector3.new(1.4, 0.6, 1.4), cf * CFrame.new(0, 11.4, -2.6), Color3.fromRGB(255, 236, 180), Enum.Material.Neon, { CanCollide = false })
		local isik = Instance.new("PointLight")
		isik.Range = 20
		isik.Brightness = 1.2
		isik.Color = Color3.fromRGB(255, 225, 170)
		isik.Parent = bas
		return m
	end
	for _, k in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		local yon = Vector3.new(k[1], 0, k[2])
		local yan = Vector3.new(-k[2], 0, k[1])
		for t = -75, 75, 25 do
			local p = yon * (YOL_DIS + 1.2) + yan * t + Vector3.new(0, 0.5, 0)
			lamba(p, -yon).Parent = yol
		end
		-- meydanın içinde de lambalar (heykele giden yolda)
		for _, t in ipairs({ -12, 12 }) do
			local p = yon * 34 + yan * t + Vector3.new(0, 0.4, 0)
			lamba(p, yan * (t > 0 and -1 or 1)).Parent = yol
		end
	end

	------------------------------------------------------------------
	-- Ağaçlar
	------------------------------------------------------------------
	local agaclar = klasor("Agaclar")
	local yesiller = { Color3.fromRGB(70, 150, 60), Color3.fromRGB(90, 170, 70), Color3.fromRGB(60, 135, 75), Color3.fromRGB(110, 180, 70) }
	local function agac(p, boy)
		boy = boy or rastgele:NextNumber(0.8, 1.3)
		local m = Instance.new("Model")
		m.Name = "Agac"
		local govde = disk(CFrame.new(p + Vector3.new(0, 4 * boy, 0)), 8 * boy, 1.4 * boy, Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
		govde.CanCollide = true
		govde.Parent = m
		local renk = yesiller[rastgele:NextInteger(1, #yesiller)]
		top(m, "Yaprak", 8 * boy, CFrame.new(p + Vector3.new(0, 9 * boy, 0)), renk)
		top(m, "Yaprak", 6 * boy, CFrame.new(p + Vector3.new(2.2 * boy, 8 * boy, 1 * boy)), renk:Lerp(Color3.new(1, 1, 1), 0.08))
		top(m, "Yaprak", 6 * boy, CFrame.new(p + Vector3.new(-1.8 * boy, 8.4 * boy, -1.4 * boy)), renk:Lerp(Color3.new(0, 0, 0), 0.08))
		m.Parent = agaclar
		return m
	end
	-- meydanın köşelerinde ağaçlar
	for _, k in ipairs({ { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }) do
		agac(Vector3.new(k[1] * 54, 0.4, k[2] * 54), 1.1)
		agac(Vector3.new(k[1] * 54, 0.4, k[2] * 26), 0.95)
		agac(Vector3.new(k[1] * 26, 0.4, k[2] * 54), 0.95)
	end
	-- köşe parkları (arsaların arasındaki köşeler)
	local parklar = klasor("Parklar")
	for _, k in ipairs({ { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }) do
		local merkez = Vector3.new(k[1] * PARK, 0, k[2] * PARK)
		local cimen = blok(parklar, "ParkCimeni", Vector3.new(PARK_BOY, 0.3, PARK_BOY), CFrame.new(merkez + Vector3.new(0, 0.15, 0)), Color3.fromRGB(110, 185, 80), Enum.Material.Grass)
		cimen.CanCollide = true
		local yolCf = CFrame.lookAt(merkez, Vector3.new(0, 0, 0))
		blok(parklar, "ParkYolu", Vector3.new(4, 0.32, PARK_BOY * 1.35), yolCf * CFrame.new(0, 0.2, 0), Color3.fromRGB(225, 205, 160), Enum.Material.Sand)
		if k[1] == 1 and k[2] == -1 then
			-- göl
			local gol = disk(CFrame.new(merkez + Vector3.new(8, 0.35, -8)), 0.2, 34, Color3.fromRGB(60, 150, 220), Enum.Material.Glass)
			gol.Name = "Gol"
			gol.Transparency = 0.15
			gol.Reflectance = 0.25
			gol.Parent = parklar
			local kiyi = disk(CFrame.new(merkez + Vector3.new(8, 0.3, -8)), 0.2, 38, Color3.fromRGB(230, 210, 160), Enum.Material.Sand)
			kiyi.Parent = parklar
		end
		for _ = 1, 9 do
			local p = merkez + Vector3.new(rastgele:NextNumber(-25, 25), 0.3, rastgele:NextNumber(-25, 25))
			if (p - merkez).Magnitude > 8 then
				agac(p)
			end
		end
		bank(CFrame.lookAt(merkez + Vector3.new(-6, 0.3, 0), merkez + Vector3.new(-12, 0.3, 0))).Parent = parklar
		saksi(parklar, merkez + Vector3.new(6, 0.3, 6))
	end
	-- dış halka: arsaların arkasında sık ağaçlar
	for i = 1, 90 do
		local a = i / 90 * math.pi * 2 + rastgele:NextNumber(-0.03, 0.03)
		local r = rastgele:NextNumber(190, 215)
		local x, z = math.cos(a) * r, math.sin(a) * r
		-- kare haritada köşelere doğru daha uzağa
		local olcek = 1 / math.max(math.abs(math.cos(a)), math.abs(math.sin(a)))
		olcek = math.min(olcek, 1.25)
		agac(Vector3.new(x * olcek, 0, z * olcek))
	end

	------------------------------------------------------------------
	-- Uzaktaki şehir binaları ve tepeler
	------------------------------------------------------------------
	local sehir = klasor("Sehir")
	local pasteller = {
		Color3.fromRGB(240, 190, 170), Color3.fromRGB(170, 205, 235), Color3.fromRGB(245, 225, 160),
		Color3.fromRGB(190, 225, 180), Color3.fromRGB(220, 190, 235), Color3.fromRGB(235, 235, 225),
	}
	local cam = Color3.fromRGB(150, 200, 235)
	for i = 1, 30 do
		local a = i / 30 * math.pi * 2 + 0.07
		local r = rastgele:NextNumber(275, 325)
		local p = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local en, boy, derin = rastgele:NextNumber(20, 34), rastgele:NextNumber(26, 72), rastgele:NextNumber(18, 26)
		local cf = CFrame.lookAt(p, Vector3.new(0, 0, 0))
		local m = Instance.new("Model")
		m.Name = "Bina"
		blok(m, "Govde", Vector3.new(en, boy, derin), cf * CFrame.new(0, boy / 2, 0), pasteller[rastgele:NextInteger(1, #pasteller)], Enum.Material.Concrete)
		blok(m, "CatiKenari", Vector3.new(en + 1, 1, derin + 1), cf * CFrame.new(0, boy + 0.5, 0), Color3.fromRGB(120, 120, 130), Enum.Material.Concrete)
		local kat = 0
		for y = 6, boy - 4, 7 do
			kat += 1
			blok(m, "Pencere", Vector3.new(en - 4, 2.6, 0.2), cf * CFrame.new(0, y, -derin / 2 - 0.1), cam, Enum.Material.Glass, { Reflectance = 0.3 })
		end
		m.Parent = sehir
	end
	local tepeler = klasor("Tepeler")
	for i = 1, 32 do
		local a = i / 32 * math.pi * 2
		local cap = rastgele:NextNumber(80, 150)
		local r = rastgele:NextNumber(390, 440)
		local p = Vector3.new(math.cos(a) * r, -cap * 0.28, math.sin(a) * r)
		top(tepeler, "Tepe", cap, CFrame.new(p), Color3.fromRGB(85, 155, 65):Lerp(Color3.fromRGB(120, 175, 80), rastgele:NextNumber()))
	end

	------------------------------------------------------------------
	-- Burger kasabası süsleri
	------------------------------------------------------------------
	local sus = klasor("Susler")
	local KIRMIZI = Color3.fromRGB(215, 45, 45)
	local SARI = Color3.fromRGB(250, 205, 50)
	local BEYAZ = Color3.fromRGB(248, 246, 240)

	local function yazili(p, yuz, metin, renk, arka)
		local sg = Instance.new("SurfaceGui")
		sg.Face = yuz
		sg.LightInfluence = 0.3
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 25
		sg.Parent = p
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = arka
		f.Parent = sg
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(0.96, 0.86)
		t.Position = UDim2.fromScale(0.02, 0.07)
		t.TextScaled = true
		t.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
		t.Text = metin
		t.TextColor3 = renk
		t.Parent = f
	end

	-- Meydanın dört girişinde kemer
	for _, k in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		local yon = Vector3.new(k[1], 0, k[2])
		local yan = Vector3.new(-k[2], 0, k[1])
		local merkez = yon * (YOL_IC - 2)
		local cf = CFrame.lookAt(merkez, merkez + yon)
		for _, s in ipairs({ -1, 1 }) do
			for seg = 0, 5 do
				blok(sus, "KemerDirek", Vector3.new(1.6, 2, 1.6), cf * CFrame.new(s * 9, 1 + seg * 2, 0), seg % 2 == 0 and KIRMIZI or BEYAZ, Enum.Material.SmoothPlastic)
			end
			top(sus, "KemerTopu", 2.2, cf * CFrame.new(s * 9, 13.1, 0), SARI, Enum.Material.SmoothPlastic)
		end
		local tabela = blok(sus, "KemerTabela", Vector3.new(20, 3.2, 0.8), cf * CFrame.new(0, 10.6, 0), KIRMIZI, Enum.Material.SmoothPlastic)
		yazili(tabela, Enum.NormalId.Front, "🍔 BURGER KASABASI 🍔", SARI, KIRMIZI)
		yazili(tabela, Enum.NormalId.Back, "🍔 BURGER KASABASI 🍔", SARI, KIRMIZI)
	end

	-- Meydanın kenarında bayrak süsü: köşe direkleri ile kemerler arasında
	local bayrakRenk = { KIRMIZI, SARI, Color3.fromRGB(70, 170, 90), Color3.fromRGB(60, 130, 230), Color3.fromRGB(245, 130, 40) }
	local kk = YOL_IC - 2
	local koseler = { Vector3.new(-kk, 0, -kk), Vector3.new(kk, 0, -kk), Vector3.new(kk, 0, kk), Vector3.new(-kk, 0, kk) }
	for _, kp in ipairs(koseler) do
		local direk = disk(CFrame.new(kp + Vector3.new(0, 5.5, 0)), 11, 0.6, BEYAZ, Enum.Material.Metal)
		direk.CanCollide = true
		direk.Parent = sus
		top(sus, "DirekTopu", 1.2, CFrame.new(kp + Vector3.new(0, 11.3, 0)), SARI, Enum.Material.SmoothPlastic)
	end
	local bayrakNo = 0
	local function bayrakDizisi(a, b)
		local fark = b - a
		local boy = fark.Magnitude
		local cf = CFrame.lookAt(a, b)
		blok(sus, "Ip", Vector3.new(0.1, 0.1, boy), cf * CFrame.new(0, 0, -boy / 2), Color3.fromRGB(60, 60, 60), nil, { CanCollide = false })
		local n = math.floor(boy / 2.4)
		for i = 1, n - 1 do
			bayrakNo += 1
			local t = i / n
			local sarkma = math.sin(t * math.pi) * 1.2
			local p = a + fark * t - Vector3.new(0, sarkma + 0.75, 0)
			local w = Instance.new("WedgePart")
			w.Name = "Bayrak"
			w.Anchored = true
			w.CanCollide = false
			w.CanTouch = false
			w.Size = Vector3.new(0.1, 1.5, 1.4)
			w.CFrame = CFrame.lookAt(p, p + fark.Unit) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(180), 0, 0)
			w.Color = bayrakRenk[bayrakNo % #bayrakRenk + 1]
			w.Material = Enum.Material.Fabric
			w.Parent = sus
		end
	end
	for i, kp in ipairs(koseler) do
		local sonraki = koseler[i % 4 + 1]
		local orta = (kp + sonraki) / 2
		local yanYon = (sonraki - kp).Unit
		local y = Vector3.new(0, 10.5, 0)
		bayrakDizisi(kp + y, orta - yanYon * 9 + Vector3.new(0, 12, 0))
		bayrakDizisi(orta + yanYon * 9 + Vector3.new(0, 12, 0), sonraki + y)
	end

	-- Parklarda dev ketçap ve hardal şişeleri
	local function sise(merkez, renk, kapak, yazi)
		local m = Instance.new("Model")
		m.Name = "DevSise"
		local cf = CFrame.new(merkez)
		local govde = disk(cf * CFrame.new(0, 5, 0), 10, 5, renk, Enum.Material.SmoothPlastic)
		govde.CanCollide = true
		govde.Parent = m
		disk(cf * CFrame.new(0, 10.8, 0), 1.6, 3.6, renk, Enum.Material.SmoothPlastic).Parent = m
		disk(cf * CFrame.new(0, 12.4, 0), 1.6, 2.4, kapak, Enum.Material.SmoothPlastic).Parent = m
		disk(cf * CFrame.new(0, 13.8, 0), 1.2, 1, kapak, Enum.Material.SmoothPlastic).Parent = m
		local etiket = blok(m, "Etiket", Vector3.new(3.4, 3, 0.2), cf * CFrame.new(0, 5, -2.45), BEYAZ, Enum.Material.SmoothPlastic, { CanCollide = false })
		yazili(etiket, Enum.NormalId.Front, yazi, renk, BEYAZ)
		return m
	end
	sise(Vector3.new(-PARK - 12, 0.3, PARK - 12), Color3.fromRGB(205, 35, 35), BEYAZ, "KETÇAP").Parent = sus
	sise(Vector3.new(-PARK - 6, 0.3, PARK - 6), Color3.fromRGB(245, 200, 30), Color3.fromRGB(205, 35, 35), "HARDAL").Parent = sus
	sise(Vector3.new(PARK + 8, 0.3, PARK + 12), Color3.fromRGB(205, 35, 35), BEYAZ, "KETÇAP").Parent = sus

	-- Yemek kamyonları
	local function kamyon(cf, renk, yazi)
		local m = Instance.new("Model")
		m.Name = "YemekKamyonu"
		blok(m, "Kasa", Vector3.new(7, 6, 13), cf * CFrame.new(0, 4.2, 0), renk, Enum.Material.SmoothPlastic)
		blok(m, "Kabin", Vector3.new(7, 4.4, 4), cf * CFrame.new(0, 3.4, -8.5), renk:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.SmoothPlastic)
		blok(m, "OnCam", Vector3.new(6.2, 2, 0.2), cf * CFrame.new(0, 4.4, -10.55), Color3.fromRGB(150, 200, 235), Enum.Material.Glass, { Transparency = 0.3 })
		blok(m, "SatisCami", Vector3.new(0.2, 2.6, 7), cf * CFrame.new(3.55, 4.8, 0.5), Color3.fromRGB(40, 40, 45), Enum.Material.SmoothPlastic)
		blok(m, "Tente", Vector3.new(2.6, 0.2, 8), cf * CFrame.new(4.6, 6.6, 0.5) * CFrame.Angles(0, 0, math.rad(-18)), BEYAZ, Enum.Material.Fabric)
		local tabela = blok(m, "Tabela", Vector3.new(0.4, 2.4, 9), cf * CFrame.new(0, 8.4, 0.5), BEYAZ, Enum.Material.SmoothPlastic)
		yazili(tabela, Enum.NormalId.Right, yazi, renk, BEYAZ)
		yazili(tabela, Enum.NormalId.Left, yazi, renk, BEYAZ)
		for _, t in ipairs({ { -3.6, -8 }, { 3.6, -8 }, { -3.6, 4 }, { 3.6, 4 } }) do
			local teker = Gorsel.Parca({ Name = "Teker", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 2.4, 2.4), CFrame = cf * CFrame.new(t[1], 1.2, t[2]), Color = Color3.fromRGB(35, 35, 40), CanCollide = true })
			teker.Parent = m
		end
		return m
	end
	kamyon(CFrame.lookAt(Vector3.new(-PARK + 14, 0.3, -PARK - 12), Vector3.new(-PARK + 14, 0.3, -PARK - 30)), Color3.fromRGB(240, 120, 170), "🍦 DONDURMA").Parent = sus
	kamyon(CFrame.lookAt(Vector3.new(PARK + 14, 0.3, PARK - 18), Vector3.new(PARK + 30, 0.3, PARK - 18)), Color3.fromRGB(70, 160, 230), "🌭 SOSİSLİ").Parent = sus

	-- Gökyüzünde burger balon
	local balon = Instance.new("Model")
	balon.Name = "BurgerBalon"
	local balonCf = CFrame.new(-PARK, 62, -PARK + 5) * CFrame.Angles(math.rad(6), 0, math.rad(-4))
	local bParcalar = Gorsel.Burger(balonCf, 3, false, true)
	for _, p in ipairs(bParcalar) do
		p.Parent = balon
	end
	blok(balon, "Sepet", Vector3.new(5, 3.2, 5), balonCf * CFrame.new(0, -9, 0), Color3.fromRGB(150, 100, 55), Enum.Material.WoodPlanks, { CanCollide = false })
	for _, c in ipairs({ { -2.3, -2.3 }, { 2.3, -2.3 }, { -2.3, 2.3 }, { 2.3, 2.3 } }) do
		local alt = (balonCf * CFrame.new(c[1], -7.4, c[2])).Position
		local ust = (balonCf * CFrame.new(c[1] * 2, 0.2, c[2] * 2)).Position
		local boy = (ust - alt).Magnitude
		blok(balon, "Halat", Vector3.new(0.15, 0.15, boy), CFrame.lookAt(alt, ust) * CFrame.new(0, 0, -boy / 2), Color3.fromRGB(90, 70, 50), nil, { CanCollide = false })
	end
	balon.Parent = sus

	-- Kaldırımlarda çöp kutuları
	for _, k in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
		local yon = Vector3.new(k[1], 0, k[2])
		local yan = Vector3.new(-k[2], 0, k[1])
		for _, t in ipairs({ -15, 15 }) do
			local p = yon * (YOL_DIS + 3) + yan * t
			local kutu = disk(CFrame.new(p + Vector3.new(0, 1.9, 0)), 2.8, 1.8, Color3.fromRGB(60, 140, 80), Enum.Material.Metal)
			kutu.CanCollide = true
			kutu.Parent = sus
			disk(CFrame.new(p + Vector3.new(0, 3.4, 0)), 0.3, 2, Color3.fromRGB(45, 100, 60), Enum.Material.Metal).Parent = sus
		end
	end

	------------------------------------------------------------------
	-- Arsalar
	------------------------------------------------------------------
	local arsalar = klasor("Arsalar")
	local boy = Config.Yerlesim.ArsaBoyu
	local sira = 0
	for _, k in ipairs({ { 0, -1 }, { 1, 0 }, { 0, 1 }, { -1, 0 } }) do
		local yon = Vector3.new(k[1], 0, k[2])
		local yan = Vector3.new(-k[2], 0, k[1])
		for _, s in ipairs({ -ARSA_KAYMA, ARSA_KAYMA }) do
			sira += 1
			local merkez = yon * ARSA_MERKEZ + yan * s
			-- arsanın önü (-Z) meydana bakar
			local cf = CFrame.lookAt(merkez, merkez - yon)
			local m = Instance.new("Model")
			m.Name = "Arsa" .. sira
			local taban = blok(m, "Taban", boy, cf * CFrame.new(0, 0, 0), Color3.fromRGB(125, 190, 95), Enum.Material.Grass)
			taban.Locked = true
			-- yanlarda ve arkada çit (çalı)
			local cali = Color3.fromRGB(60, 130, 55)
			blok(m, "Cit", Vector3.new(2, 3, boy.Z), cf * CFrame.new(-boy.X / 2 + 1, 2, 0), cali, Enum.Material.Grass)
			blok(m, "Cit", Vector3.new(2, 3, boy.Z), cf * CFrame.new(boy.X / 2 - 1, 2, 0), cali, Enum.Material.Grass)
			blok(m, "Cit", Vector3.new(boy.X, 3, 2), cf * CFrame.new(0, 2, boy.Z / 2 - 1), cali, Enum.Material.Grass)
			m:SetAttribute("Sira", sira)
			m:SetAttribute("Sahip", 0)
			m.PrimaryPart = taban
			m.Parent = arsalar
		end
	end

	------------------------------------------------------------------
	-- Başlangıç noktası (meydanda)
	------------------------------------------------------------------
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Baslangic"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = CFrame.new(0, 0.6, 36)
	spawn.Color = Color3.fromRGB(255, 200, 50)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.5
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = harita

	return harita
end

return HaritaUretici
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">160</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Ekran</string>
        </Properties>
        <Item class="LocalScript" referent="20">
          <Properties>
            <string name="Name">BurgerEkran</string>
            <string name="Source"><![CDATA[-- BURGER İMPARATORU - Oyuncunun ekranı
-- KATLA butonu, huss huss huss sesi, HUSS! yazıları, para/paket göstergeleri, dükkan menüsü,
-- dükkanını kur (logo, renk, ad) ekranı ve yeni şube.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local Debris = game:GetService("Debris")

local ben = Players.LocalPlayer
local Ortak = ReplicatedStorage:WaitForChild("Ortak")
local Config = require(Ortak:WaitForChild("Config"))
local Ekonomi = require(Ortak:WaitForChild("Ekonomi"))
local Gorsel = require(Ortak:WaitForChild("Gorsel"))
local Dil = require(Ortak:WaitForChild("Dil"))
local T = Dil.T

-- Dil: Config.Dil "tr"/"en" ise o, değilse oyuncunun Roblox dili (Türkçe -> Türkçe, diğerleri -> İngilizce)
do
	local kod = Config.Dil
	if kod ~= "tr" and kod ~= "en" then
		local ok, yerel = pcall(function()
			return game:GetService("LocalizationService").RobloxLocaleId
		end)
		if not ok or type(yerel) ~= "string" or yerel == "" then
			ok, yerel = pcall(function()
				return ben.LocaleId
			end)
		end
		kod = (ok and type(yerel) == "string" and yerel ~= "") and yerel or "en"
	end
	Dil.Ayarla(kod)
end
local PaketGorsel = require(script.Parent:WaitForChild("PaketGorsel"))
local Musteriler = require(script.Parent:WaitForChild("Musteriler"))
local KasabaHalki = require(script.Parent:WaitForChild("KasabaHalki"))
local Uzaklar = ReplicatedStorage:WaitForChild("Uzaklar")
local KatlaOlay = Uzaklar:WaitForChild("Katla")
local SatinAlOlay = Uzaklar:WaitForChild("SatinAl")
local SubeAcOlay = Uzaklar:WaitForChild("SubeAc")
local StilSecOlay = Uzaklar:WaitForChild("StilSec")
local DurumIsteOlay = Uzaklar:WaitForChild("DurumIste")
local EvimeGitOlay = Uzaklar:WaitForChild("EvimeGit")
local DurumOlay = Uzaklar:WaitForChild("Durum")
local KatlandiOlay = Uzaklar:WaitForChild("Katlandi")
local UretimOlay = Uzaklar:WaitForChild("Uretim")
local UnvanOlay = Uzaklar:WaitForChild("YeniUnvan")
local DuyuruOlay = Uzaklar:WaitForChild("Duyuru")
local GorevAlOlay = Uzaklar:WaitForChild("GorevAl")
local NPCOlay = Uzaklar:WaitForChild("NPC")
local YarismaOlay = Uzaklar:WaitForChild("Yarisma")

local FONT = Font.fromEnum(Enum.Font.FredokaOne)
local rastgele = Random.new()
local K = Ekonomi.Kisalt

local durum = nil -- sunucudan gelen son durum
local sesAcik = true
local kombo = 0
local sonKatlama = 0
local KATLAMA_ARALIGI = math.max(0.09, Config.KatlamaBeklemesi + 0.01)

----------------------------------------------------------------------
-- Ses: huss huss huss
----------------------------------------------------------------------
local sesVar = Config.HussSesId ~= nil and Config.HussSesId ~= ""
local sesHavuzu = {}
local sesSirasi = 0
if sesVar then
	for i = 1, 4 do
		local s = Instance.new("Sound")
		s.Name = "Huss" .. i
		s.SoundId = Config.HussSesId
		s.Volume = Config.HussSesSeviyesi
		s.Parent = SoundService
		sesHavuzu[i] = s
	end
elseif RunService:IsStudio() then
	warn("[Burger İmparatoru] Huss sesi yok: Config.HussSesId boş. README'deki 'Sesi ekle' adımlarına bak.")
end

-- Sesin hangi kısmı çalınsın: parca = 1, 2 ya da 3 ise o tek huss, nil ise sesin tamamı (3 huss)
local function bolgeAyarla(s, parca)
	local b = parca and Config.HussParcalari[parca]
	if b then
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(b[1], b[2])
		s.TimePosition = b[1]
	else
		s.PlaybackRegionsEnabled = false
		s.TimePosition = 0
	end
end

-- Katlama numarasından (1, 2, 3) çalınacak huss
local function hussNumarasi(asama)
	return math.clamp(math.floor(asama or 1), 1, #Config.HussParcalari)
end

local function hussCal(hiz, seviye, parca)
	if not sesAcik or not sesVar then
		return
	end
	sesSirasi = sesSirasi % #sesHavuzu + 1
	local s = sesHavuzu[sesSirasi]
	s:Stop()
	s.PlaybackSpeed = hiz or 1
	s.Volume = seviye or Config.HussSesSeviyesi
	bolgeAyarla(s, parca)
	s:Play()
end

-- Başka bir dükkandan gelen 3 boyutlu ses (yakındaysan duyarsın)
local sonUzakSes = {}
local function uzakHuss(parca, anahtar, aralik, hussNo)
	if not sesAcik or not sesVar or not parca then
		return
	end
	local simdi = os.clock()
	if sonUzakSes[anahtar] and simdi - sonUzakSes[anahtar] < aralik then
		return
	end
	sonUzakSes[anahtar] = simdi
	local s = Instance.new("Sound")
	s.SoundId = Config.HussSesId
	s.Volume = Config.BaskasininSesSeviyesi
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 90
	s.PlaybackSpeed = rastgele:NextNumber(0.95, 1.1)
	bolgeAyarla(s, hussNo)
	s.Parent = parca
	s:Play()
	Debris:AddItem(s, 2)
end

local function arsaParcasi(sira, ad)
	local harita = workspace:FindFirstChild("Harita")
	local arsalar = harita and harita:FindFirstChild("Arsalar")
	local arsa = arsalar and arsalar:FindFirstChild("Arsa" .. tostring(sira))
	local dukkan = arsa and arsa:FindFirstChild("Dukkan")
	return dukkan and dukkan:FindFirstChild(ad, true)
end

----------------------------------------------------------------------
-- Arayüz yardımcıları
----------------------------------------------------------------------
local function yap(sinif, ozellikler, cocuklar)
	local o = Instance.new(sinif)
	local ebeveyn = nil
	for k, v in pairs(ozellikler or {}) do
		if k == "Parent" then
			ebeveyn = v
		else
			o[k] = v
		end
	end
	for _, c in ipairs(cocuklar or {}) do
		c.Parent = o
	end
	if ebeveyn then
		o.Parent = ebeveyn
	end
	return o
end

local function kose(r)
	return yap("UICorner", { CornerRadius = r })
end

local function cizgi(renk, kalinlik)
	return yap("UIStroke", { Color = renk, Thickness = kalinlik, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function yaziCizgisi(renk, kalinlik)
	return yap("UIStroke", { Color = renk, Thickness = kalinlik, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

local function yazi(oz)
	local o = {
		BackgroundTransparency = 1,
		FontFace = FONT,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	}
	for k, v in pairs(oz) do
		o[k] = v
	end
	o.Text = T(o.Text)
	return yap("TextLabel", o)
end

local function buton(oz, cocuklar)
	local o = {
		FontFace = FONT,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = true,
	}
	for k, v in pairs(oz) do
		o[k] = v
	end
	o.Text = T(o.Text)
	return yap("TextButton", o, cocuklar)
end

local function gecis(nesne, sure, hedef, stil, yon)
	local t = TweenService:Create(nesne, TweenInfo.new(sure, stil or Enum.EasingStyle.Quad, yon or Enum.EasingDirection.Out), hedef)
	t:Play()
	return t
end

