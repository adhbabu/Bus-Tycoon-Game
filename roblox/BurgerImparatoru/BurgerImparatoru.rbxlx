}, { kose(UDim.new(0, 10)), yap("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })

-- Önizleme: tabela
yazi({ Text = "Tabelan:", Position = UDim2.fromOffset(346, 52), Size = UDim2.fromOffset(190, 20), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = stilPanel })
local onizleme = yap("Frame", {
	Position = UDim2.fromOffset(346, 78),
	Size = UDim2.fromOffset(196, 150),
	BackgroundColor3 = Config.Renkler[1].Renk,
	ZIndex = 21,
	Parent = stilPanel,
}, { kose(UDim.new(0, 14)), cizgi(Color3.new(1, 1, 1), 3) })
local onizlemeLogo = yazi({ Text = Config.Logolar[1], Position = UDim2.fromScale(0.25, 0.06), Size = UDim2.fromScale(0.5, 0.5), ZIndex = 22, Parent = onizleme })
local onizlemeAd = yazi({ Text = "", Position = UDim2.fromScale(0.05, 0.62), Size = UDim2.fromScale(0.9, 0.3), ZIndex = 22, Parent = onizleme })
yaziCizgisi(KOYU, 2).Parent = onizlemeAd

local stilKaydet = buton({
	Position = UDim2.fromOffset(346, 314),
	Size = UDim2.fromOffset(196, 54),
	BackgroundColor3 = YESIL,
	Text = "✅ DÜKKANI AÇ!",
	ZIndex = 22,
	Parent = stilPanel,
}, { kose(UDim.new(0, 14)), cizgi(KOYU, 3), yap("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
local stilNot = yazi({
	Text = "Dükkan adını herkes görür, kibar bir isim seç 🙂",
	Position = UDim2.fromOffset(16, 380),
	Size = UDim2.new(1, -32, 0, 18),
	TextColor3 = Color3.fromRGB(220, 200, 180),
	ZIndex = 21,
	Parent = stilPanel,
})

local function varsayilanAd()
	return string.sub(ben.DisplayName, 1, Config.AdEnUzun - 7) .. " Burger"
end

local function stilGoster()
	for i, b in ipairs(logoButonlari) do
		b.Cizgi.Thickness = (i == secim.Logo) and 3 or 0
		b.Buton.BackgroundColor3 = (i == secim.Logo) and Color3.fromRGB(240, 130, 40) or SATIR
	end
	for i, b in ipairs(renkButonlari) do
		b.Cizgi.Thickness = (i == secim.Renk) and 4 or 0
	end
	onizleme.BackgroundColor3 = Config.Renkler[secim.Renk].Renk
	onizlemeLogo.Text = Config.Logolar[secim.Logo]
	local ad = adKutusu.Text ~= "" and adKutusu.Text or varsayilanAd()
	onizlemeAd.Text = ad
end

for i, b in ipairs(logoButonlari) do
	b.Buton.Activated:Connect(function()
		secim.Logo = i
		stilGoster()
	end)
end
for i, b in ipairs(renkButonlari) do
	b.Buton.Activated:Connect(function()
		secim.Renk = i
		stilGoster()
	end)
end
adKutusu:GetPropertyChangedSignal("Text"):Connect(function()
	-- en fazla AdEnUzun harf
	local t = adKutusu.Text
	local n = utf8.len(t)
	if n and n > Config.AdEnUzun then
		adKutusu.Text = string.sub(t, 1, utf8.offset(t, Config.AdEnUzun + 1) - 1)
		return
	end
	stilGoster()
end)

local function stilAcKapa(ac)
	stilPanel.Visible = ac
	if ac then
		dukkanAcKapa(false)
		if durum and durum.Stil then
			secim.Logo = durum.Stil.Logo
			secim.Renk = durum.Stil.Renk
			adKutusu.Text = durum.StilVar and durum.Stil.Ad or ""
		end
		stilKapat.Visible = durum ~= nil and durum.StilVar
		stilGoster()
	end
end

stilKaydet.Activated:Connect(function()
	local ad = adKutusu.Text
	if ad == "" then
		ad = varsayilanAd()
	end
	StilSecOlay:FireServer({ Logo = secim.Logo, Renk = secim.Renk, Ad = ad })
	stilAcKapa(false)
	duyuru(Config.Logolar[secim.Logo] .. " " .. ad, Config.Renkler[secim.Renk].Renk, 2.2, "Dükkanın açıldı! KATLA'ya bas.")
end)
stilKapat.Activated:Connect(function()
	stilAcKapa(false)
end)

----------------------------------------------------------------------
-- Ekranı güncelle
----------------------------------------------------------------------
local function arayuzGuncelle()
	if not durum then
		return
	end
	paraYazi.Text = K(durum.Para)
	paketYazi.Text = K(durum.ToplamPaket)
	local gelir = Ekonomi.MakineGeliri(durum.Gelistirme, durum.Sube)
	gelirYazi.Text = gelir > 0 and ("+" .. K(gelir)) or "-"
	gelirAlt.Text = gelir > 0 and string.format("%d makine / sn", Ekonomi.Seviye(durum.Gelistirme, "Makine")) or "Makine yok"
	paketAlt.Text = durum.Sube > 0 and string.format("Paket • 🏙️ x%.1f", Ekonomi.SubeCarpani(durum.Sube)) or "Paket"
	for i, n in ipairs(noktalar) do
		n.BackgroundColor3 = (i <= durum.Asama) and SARI or PANEL
	end

	local idx = Ekonomi.UnvanIndex(durum.ToplamPaket)
	local u = Config.Unvanlar[idx]
	local sonraki = Config.Unvanlar[idx + 1]
	if sonraki then
		unvanDolgu.Size = UDim2.fromScale(math.clamp((durum.ToplamPaket - u.Esik) / (sonraki.Esik - u.Esik), 0, 1), 1)
		unvanYazi.Text = string.format("👑 %s  •  %s / %s paket → %s", u.Ad, K(durum.ToplamPaket), K(sonraki.Esik), sonraki.Ad)
	else
		unvanDolgu.Size = UDim2.fromScale(1, 1)
		unvanYazi.Text = "👑 " .. u.Ad .. "  •  EN TEPEDESİN!"
	end
	unvanDolgu.BackgroundColor3 = u.Renk
	katlaYazi.Text = durum.ArsaIndex > 0 and "KATLA!" or "BEKLE"

	if durum.KayitAcik then
		kayitYazi.Visible = false
	else
		kayitYazi.Visible = true
		kayitYazi.Text = RunService:IsStudio() and "💾 Studio testinde kayıt kapalı (oyunu yayınlayınca açılır)"
			or "💾 Kayıt yüklenemedi, bu seferki ilerlemen kaydedilmeyecek"
	end
	dukkanGuncelle()
end

----------------------------------------------------------------------
-- Eylemler
----------------------------------------------------------------------
local function katla()
	if not durum then
		return
	end
	if durum.ArsaIndex == 0 then
		duyuru("Bütün arsalar dolu!", Color3.fromRGB(255, 150, 120), 1.5, "Biri çıkınca dükkanın açılacak.")
		return
	end
	local simdi = os.clock()
	if simdi - sonKatlama < KATLAMA_ARALIGI then
		return
	end
	if simdi - sonKatlama < 0.9 then
		kombo += 1
	else
		kombo = 1
	end
	sonKatlama = simdi

	-- ekranı hemen güncelle (sunucunun cevabı gelince düzelir)
	durum.Asama += Ekonomi.TikBasinaKatlama(durum.Gelistirme)
	if durum.Asama >= Config.KatlamaSayisi then
		durum.Asama = 0
		durum.ToplamPaket += 1
	end
	KatlaOlay:FireServer()

	local hiz = 1 + math.min(kombo, 40) * 0.008
	hussCal(hiz)
	hussSerisi(hiz, 1 + math.min(kombo, 30) * 0.01)
	zipla(katlaOlcek, 0.86)
	if kombo >= 3 then
		komboYazi.Visible = true
		komboYazi.Text = "KOMBO x" .. kombo
		zipla(komboOlcek, 1.25)
	end
	arayuzGuncelle()
end

katlaButonu.Activated:Connect(katla)
dukkanButonu.Activated:Connect(function()
	zipla(dukkanOlcek, 0.85)
	dukkanAcKapa()
end)
kapatButonu.Activated:Connect(function()
	dukkanAcKapa(false)
end)
sesButonu.Activated:Connect(function()
	sesAcik = not sesAcik
	sesButonu.Text = sesAcik and "🔊" or "🔇"
	if not sesAcik then
		for _, s in ipairs(sesHavuzu) do
			s:Stop()
		end
	end
end)
stilButonu.Activated:Connect(function()
	stilAcKapa(not stilPanel.Visible)
end)
evButonu.Activated:Connect(function()
	EvimeGitOlay:FireServer()
end)

ContextActionService:BindAction("BurgerKatla", function(_, girdi)
	if girdi == Enum.UserInputState.Begin then
		katla()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonR2)

ContextActionService:BindAction("BurgerDukkan", function(_, girdi)
	if girdi == Enum.UserInputState.Begin then
		dukkanAcKapa()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonY)

RunService.RenderStepped:Connect(function()
	if komboYazi.Visible and os.clock() - sonKatlama > 0.9 then
		komboYazi.Visible = false
		kombo = 0
	end
end)

----------------------------------------------------------------------
-- Sunucudan gelenler
----------------------------------------------------------------------
local ilkDurum = true
DurumOlay.OnClientEvent:Connect(function(yeni)
	local eski = durum
	durum = yeni
	if eski then
		for _, g in ipairs(Config.Gelistirmeler) do
			local once = Ekonomi.Seviye(eski.Gelistirme, g.Anahtar)
			local simdi = Ekonomi.Seviye(yeni.Gelistirme, g.Anahtar)
			if simdi > once then
				duyuru(g.Ikon .. " " .. g.Ad .. (g.MaxSeviye > 1 and (" Sv " .. simdi) or "") .. "!", Color3.fromRGB(140, 255, 140), 1.4, Ekonomi.EtkiYazisi(g.Anahtar, simdi))
				local s = satirlar[g.Anahtar]
				if s then
					s.Satir.BackgroundColor3 = Color3.fromRGB(80, 170, 90)
					gecis(s.Satir, 0.5, { BackgroundColor3 = SATIR })
				end
			end
		end
		if yeni.Sube > eski.Sube then
			duyuru("🏙️ " .. (yeni.Sube + 1) .. ". ŞUBE AÇILDI!", SARI, 2.6, string.format("Bütün paralar artık x%.1f", Ekonomi.SubeCarpani(yeni.Sube)))
			hussSerisi(1, 1.4)
		end
	end
	if ilkDurum then
		ilkDurum = false
		if yeni.ArsaIndex > 0 then
			PaketGorsel.Esitle(yeni.ArsaIndex, yeni.Asama, yeni.Altin)
		end
		if not yeni.StilVar then
			stilAcKapa(true)
		elseif yeni.ArsaIndex > 0 then
			duyuru("🍔 BURGER İMPARATORU 👑", Color3.fromRGB(255, 215, 80), 2.4, "KATLA'ya bas: 3 katlamada burger paketlenir!")
		end
	end
	arayuzGuncelle()
end)

KatlandiOlay.OnClientEvent:Connect(function(kim, sira, asama, paketlendi, kazanc, altin, siradakiAltin)
	PaketGorsel.Katla(sira, asama, paketlendi, altin, siradakiAltin)
	if kim == ben then
		if paketlendi then
			ucanYazi("📦 +" .. K(kazanc), Color3.fromRGB(140, 255, 120), 0.85, rastgele:NextInteger(-40, 40), -175)
			if altin then
				duyuru("✨ ALTIN BURGER! ✨", SARI, 1.6, "+" .. K(kazanc) .. " 💰")
			end
		end
	else
		uzakHuss(arsaParcasi(sira, "AnaTezgahUst"), "k" .. tostring(sira), 0.3)
	end
end)

local sonMakineSesi = 0
UretimOlay.OnClientEvent:Connect(function(liste)
	if type(liste) ~= "table" then
		return
	end
	local benimki = durum and durum.ArsaIndex or 0
	for _, u in ipairs(liste) do
		local sira, makine, altin = u[1], u[2], u[3]
		PaketGorsel.Uretim(sira, makine, altin)
		if sira == benimki then
			local simdi = os.clock()
			if simdi - sonMakineSesi > 0.7 then
				sonMakineSesi = simdi
				hussCal(rastgele:NextNumber(1.05, 1.2), Config.MakineSesSeviyesi)
			end
		else
			uzakHuss(arsaParcasi(sira, "Makine" .. tostring(makine)), "m" .. tostring(sira), 1)
		end
	end
end)

UnvanOlay.OnClientEvent:Connect(function(kim, index)
	local u = Config.Unvanlar[index]
	if not u then
		return
	end
	if kim == ben then
		duyuru("👑 YENİ UNVAN: " .. u.Ad .. "!", u.Renk, 2.4, "Burger İmparatorluğuna bir adım daha!")
		hussSerisi(1.1, 1.4)
	end
	if kim then
		sohbetMesaji("👑 " .. kim.DisplayName .. " artık " .. u.Ad .. "!")
	end
end)

DuyuruOlay.OnClientEvent:Connect(function(metin)
	if type(metin) ~= "string" then
		return
	end
	duyuru(metin, Color3.fromRGB(255, 230, 150), 2.4)
	sohbetMesaji(metin)
end)

----------------------------------------------------------------------
-- Başlat
----------------------------------------------------------------------
task.spawn(function()
	PaketGorsel.Baslat(Config, Gorsel)
	if durum and durum.ArsaIndex > 0 then
		PaketGorsel.Esitle(durum.ArsaIndex, durum.Asama, durum.Altin)
	end
end)

-- Ekran hazır: sunucudan güncel durumu iste
DurumIsteOlay:FireServer()

olcekGuncelle()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	olcekGuncelle()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(olcekGuncelle)
	end
end)
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(olcekGuncelle)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">PaketGorsel</string>
            <string name="Source"><![CDATA[-- BURGER İMPARATORU - Kutu görselleri (sadece bu oyuncunun ekranında)
-- Tezgahtaki kutunun katlanması, paketin banttan satış penceresine gitmesi,
-- makinelerin presi ve bantta akan kutular. Sunucu sadece "şu oldu" der, çizimi burası yapar.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local PaketGorsel = {}

local Config, Gorsel
local Y
local klasor
local arsalar = {} -- sıra -> durum
local EN_FAZLA_BANTTA = 22 -- bir dükkanın bantlarında aynı anda en fazla kaç kutu görünsün
local GORUS_UZAKLIGI = 260 -- bundan uzaktaki dükkanların makine kutularını çizme

local KATLAMA = TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local DUSME = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function cerceve(st)
	local taban = st.Model:FindFirstChild("Taban")
	if not taban then
		return nil
	end
	return taban.CFrame * CFrame.new(0, taban.Size.Y / 2, 0)
end

local function stilOku(st, altin)
	return {
		Renk = st.Model:GetAttribute("Renk") or Color3.fromRGB(220, 55, 50),
		Logo = st.Model:GetAttribute("Logo") or "🍔",
		Altin = altin,
	}
end

local function sahipli(st)
	local s = st.Model:GetAttribute("Sahip")
	return type(s) == "number" and s ~= 0
end

local function kutuTabani(st)
	local F = cerceve(st)
	if not F then
		return nil
	end
	local a = Y.AnaTezgah
	return F * CFrame.new(a.X, Y.TezgahYuksekligi, a.Z)
end

local function temizle(st)
	if st.Kutu then
		for _, p in pairs(st.Kutu) do
			p:Destroy()
		end
	end
	if st.Burger then
		for _, p in ipairs(st.Burger) do
			p:Destroy()
		end
	end
	st.Kutu = nil
	st.Burger = nil
end

-- Tezgaha yeni açık kutu (ve içinde burger) koyar
local function yeniKutu(st, altin, asama, gecikme)
	temizle(st)
	if not sahipli(st) then
		return
	end
	local taban = kutuTabani(st)
	if not taban then
		return
	end
	asama = asama or 0
	st.Asama = asama
	st.Altin = altin and true or false
	local kutu = Gorsel.KutuYap(taban, stilOku(st, st.Altin))
	local poz = Gorsel.KutuPozu(taban, asama)
	local burger = Gorsel.Burger(taban * CFrame.new(0, Gorsel.KartonKalinligi, 0), 1, st.Altin, false)
	local hepsi = {}
	for ad, p in pairs(kutu) do
		p.CFrame = poz[ad]
		table.insert(hepsi, p)
	end
	for _, p in ipairs(burger) do
		table.insert(hepsi, p)
	end
	local bilgi = gecikme and TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, gecikme) or DUSME
	for _, p in ipairs(hepsi) do
		local hedef = p.CFrame
		p.CFrame = hedef + Vector3.new(0, 5, 0)
		p.Parent = klasor
		TweenService:Create(p, bilgi, { CFrame = hedef }):Play()
	end
	st.Kutu = kutu
	st.Burger = burger
end

-- Parçaları bir yoldan geçirir (her noktaya sırayla), sonra yok eder.
-- basTaban: kutunun şu anki alt yüzü; noktalar: kutunun alt yüzünün gideceği yerler
local function yoldanGotur(parcalar, basTaban, noktalar, hiz, bitince)
	if #parcalar == 0 then
		return
	end
	local goreli = {}
	for _, p in ipairs(parcalar) do
		goreli[p] = basTaban:ToObjectSpace(p.CFrame)
	end
	task.spawn(function()
		local simdiki = basTaban
		for _, hedefCf in ipairs(noktalar) do
			local mesafe = (hedefCf.Position - simdiki.Position).Magnitude
			local sure = math.max(0.05, mesafe / hiz)
			local bilgi = TweenInfo.new(sure, Enum.EasingStyle.Linear)
			for _, p in ipairs(parcalar) do
				if p.Parent then
					TweenService:Create(p, bilgi, { CFrame = hedefCf * goreli[p] }):Play()
				end
			end
			task.wait(sure)
			simdiki = hedefCf
		end
		-- satış penceresinde küçülüp kaybolsun
		for _, p in ipairs(parcalar) do
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(0.15), { Size = p.Size * 0.2, Transparency = 1 }):Play()
			end
		end
		task.wait(0.16)
		for _, p in ipairs(parcalar) do
			p:Destroy()
		end
		if bitince then
			bitince()
		end
	end)
end

local function satisNoktasi(F)
	local s = Y.SatisNoktasi
	return F * CFrame.new(s.X, Y.TezgahYuksekligi, s.Z)
end

----------------------------------------------------------------------
-- Dışarıya açık fonksiyonlar
----------------------------------------------------------------------

-- KATLA: kutuyu yeni aşamaya katlar; paketlendiyse paketi banda koyup yeni kutu getirir
function PaketGorsel.Katla(sira, asama, paketlendi, altin, siradakiAltin)
	local st = arsalar[sira]
	if not st or not sahipli(st) then
		return
	end
	if not st.Kutu or st.Altin ~= (altin and true or false) then
		yeniKutu(st, altin, math.max(0, asama - 1))
	end
	local taban = kutuTabani(st)
	if not taban or not st.Kutu then
		return
	end
	local poz = Gorsel.KutuPozu(taban, asama)
	for ad, p in pairs(st.Kutu) do
		TweenService:Create(p, KATLAMA, { CFrame = poz[ad] }):Play()
	end
	st.Asama = asama
	if not paketlendi then
		return
	end

	-- Kapak kapandı: açık kutuyu kapalı pakete çevir, bantta satış penceresine gönder
	local eskiKutu, eskiBurger = st.Kutu, st.Burger
	st.Kutu, st.Burger = nil, nil
	local stil = stilOku(st, altin)
	task.delay(0.2, function()
		for _, p in pairs(eskiKutu) do
			p:Destroy()
		end
		for _, p in ipairs(eskiBurger) do
			p:Destroy()
		end
		local F = cerceve(st)
		if not F or not sahipli(st) then
			return
		end
		local paket = Gorsel.KapaliKutu(taban, stil, 1)
		for _, p in ipairs(paket) do
			p.Parent = klasor
		end
		yoldanGotur(paket, taban, { satisNoktasi(F) }, 18)
	end)
	yeniKutu(st, siradakiAltin, 0, 0.3)
end

-- Kutu doğru stilde/aşamada mı? Değilse düzelt (ör. sunucudan gelen durumla eşitle)
function PaketGorsel.Esitle(sira, asama, altin)
	local st = arsalar[sira]
	if not st or not sahipli(st) then
		return
	end
	if not st.Kutu or st.Altin ~= (altin and true or false) or st.Asama ~= asama then
		yeniKutu(st, altin, asama)
	end
end

-- Makine bir paket yaptı
function PaketGorsel.Uretim(sira, makine, altin)
	local st = arsalar[sira]
	if not st or not sahipli(st) then
		return
	end
	if (st.Model:GetAttribute("Makine") or 0) < makine then
		return
	end
	local F = cerceve(st)
	if not F then
		return
	end
	local kamera = Workspace.CurrentCamera
	if kamera and (kamera.CFrame.Position - F.Position).Magnitude > GORUS_UZAKLIGI then
		return
	end

	-- pres aşağı inip kalksın
	local dukkan = st.Model:FindFirstChild("Dukkan")
	local m = dukkan and dukkan:FindFirstChild("Makine" .. makine)
	local kol = m and m:FindFirstChild("Kol")
	if kol and not st.PresCalisiyor[makine] then
		st.PresCalisiyor[makine] = true
		local ust = kol.CFrame
		local alt = ust - Vector3.new(0, 1.3, 0)
		local inis = TweenService:Create(kol, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = alt })
		inis:Play()
		inis.Completed:Connect(function()
			if not kol.Parent then
				st.PresCalisiyor[makine] = false -- bu arada dükkan yeniden kuruldu
				return
			end
			local kalkis = TweenService:Create(kol, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = ust })
			kalkis:Play()
			kalkis.Completed:Connect(function()
				st.PresCalisiyor[makine] = false
			end)
		end)
	end

	if st.Bantta >= EN_FAZLA_BANTTA then
		return
	end
	st.Bantta += 1
	local x = Y.MakineX[makine]
	local tepe = Y.TezgahYuksekligi
	local bas = F * CFrame.new(x, tepe, Y.MakineZ - 0.4)
	local paket = Gorsel.KapaliKutu(bas, stilOku(st, altin), 0.5)
	for _, p in ipairs(paket) do
		p.Parent = klasor
	end
	local noktalar = {
		F * CFrame.new(x, tepe, Y.BantZ),
		F * CFrame.new(Y.BantX, tepe, Y.BantZ),
		satisNoktasi(F),
	}
	yoldanGotur(paket, bas, noktalar, 11, function()
		st.Bantta -= 1
	end)
end

function PaketGorsel.Baslat(config, gorsel)
	Config = config
	Gorsel = gorsel
	Y = Config.Yerlesim
	klasor = Instance.new("Folder")
	klasor.Name = "BurgerGorselleri"
	klasor.Parent = Workspace

	local harita = Workspace:WaitForChild("Harita")
	local arsaKlasoru = harita:WaitForChild("Arsalar")
	for i = 1, Config.ArsaSayisi do
		local model = arsaKlasoru:WaitForChild("Arsa" .. i, 10)
		if model then
			local st = { Sira = i, Model = model, Asama = 0, Altin = false, Bantta = 0, PresCalisiyor = {} }
			arsalar[i] = st
			local function yenile()
				if sahipli(st) then
					yeniKutu(st, st.Altin, st.Asama)
				else
					temizle(st)
				end
			end
			model:GetAttributeChangedSignal("Sahip"):Connect(function()
				st.Asama = 0
				st.Altin = false
				yenile()
			end)
			model:GetAttributeChangedSignal("Renk"):Connect(yenile)
			model:GetAttributeChangedSignal("Logo"):Connect(yenile)
			yenile()
		end
	end
end

return PaketGorsel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
