-- Etkinlik göstergeleri (unvan çubuğunun altında)
local etkinlikSirasi = yap("Frame", {
	Position = UDim2.fromOffset(16, 92),
	Size = UDim2.fromOffset(448, 24),
	BackgroundTransparency = 1,
	Parent = ust,
}, { yap("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }) })
local function etkinlikHapi(renk)
	local l = yazi({
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 0.05,
		BackgroundColor3 = renk,
		TextScaled = false,
		TextSize = 15,
		Visible = false,
		Parent = etkinlikSirasi,
	}, nil)
	kose(UDim.new(0, 10)).Parent = l
	yap("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }).Parent = l
	yaziCizgisi(KOYU, 1.5).Parent = l
	return l
end
local ikiKatHap = etkinlikHapi(Color3.fromRGB(230, 90, 40))
local altinSaatHap = etkinlikHapi(Color3.fromRGB(220, 170, 20))
local hediyeHap = etkinlikHapi(Color3.fromRGB(200, 50, 80))
local hediyeHazirZamani = 0

local function sureYazi(sn)
	sn = math.max(0, math.floor(sn))
	return string.format("%d:%02d", sn // 60, sn % 60)
end

task.spawn(function()
	while true do
		task.wait(0.2)
		local simdi = workspace:GetServerTimeNow()
		local ikiKat = (ben:GetAttribute("IkiKatBitis") or 0) - simdi
		ikiKatHap.Visible = ikiKat > 0
		if ikiKat > 0 then
			ikiKatHap.Text = T("🔥 2 KAT PARA %s", sureYazi(ikiKat))
		end
		local altinSaat = (ReplicatedStorage:GetAttribute("AltinSaatBitis") or 0) - simdi
		altinSaatHap.Visible = altinSaat > 0
		if altinSaat > 0 then
			altinSaatHap.Text = T("⏰ ALTIN SAAT x2 %s", sureYazi(altinSaat))
		end
		if durum then
			local kalan = hediyeHazirZamani - os.clock()
			hediyeHap.Visible = true
			hediyeHap.Text = kalan > 0 and T("🎁 Hediye %s", sureYazi(kalan)) or T("🎁 Hediye hazır! Meydana gel")
		end
		-- yarışma
		if yarisma then
			local t = os.clock()
			yarismaKutusu.Visible = true
			if t < yarisma.Baslangic then
				yarismaUst.Text = "⏱️ " .. math.ceil(yarisma.Baslangic - t) .. "..."
				yarismaAlt.Text = T("Hazır ol! KATLA'ya hızlı hızlı bas!")
			elseif t < yarisma.Bitis then
				yarismaUst.Text = T("⏱️ %.1f  •  %d TIK", yarisma.Bitis - t, yarisma.Sayac)
				yarismaAlt.Text = "HUSS! HUSS! HUSS!"
			else
				yarismaUst.Text = T("⏱️ BİTTİ  •  %d TIK", yarisma.Sayac)
				yarismaAlt.Text = T("Hakem sayıyor...")
			end
		elseif yarismaKutusu.Visible and not yarismaKutusu:GetAttribute("Sonuc") then
			yarismaKutusu.Visible = false
		end
	end
end)

----------------------------------------------------------------------
-- Ekranı güncelle
----------------------------------------------------------------------
local function arayuzGuncelle()
	if not durum then
		return
	end
	gorevGuncelle()
	paraYazi.Text = K(durum.Para)
	paketYazi.Text = K(durum.ToplamPaket)
	local gelir = Ekonomi.MakineGeliri(durum.Gelistirme, durum.Sube)
	gelirYazi.Text = gelir > 0 and ("+" .. K(gelir)) or "-"
	gelirAlt.Text = gelir > 0 and T("%d makine / sn", Ekonomi.Seviye(durum.Gelistirme, "Makine")) or T("Makine yok")
	paketAlt.Text = durum.Sube > 0 and T("Paket • 🏙️ x%.1f", Ekonomi.SubeCarpani(durum.Sube)) or T("Paket")
	for i, n in ipairs(noktalar) do
		n.BackgroundColor3 = (i <= durum.Asama) and SARI or PANEL
	end

	local idx = Ekonomi.UnvanIndex(durum.ToplamPaket)
	local u = Config.Unvanlar[idx]
	local sonraki = Config.Unvanlar[idx + 1]
	if sonraki then
		unvanDolgu.Size = UDim2.fromScale(math.clamp((durum.ToplamPaket - u.Esik) / (sonraki.Esik - u.Esik), 0, 1), 1)
		unvanYazi.Text = T("👑 %s  •  %s / %s paket → %s", u.Ad, K(durum.ToplamPaket), K(sonraki.Esik), sonraki.Ad)
	else
		unvanDolgu.Size = UDim2.fromScale(1, 1)
		unvanYazi.Text = T("👑 %s  •  EN TEPEDESİN!", u.Ad)
	end
	unvanDolgu.BackgroundColor3 = u.Renk
	katlaYazi.Text = durum.ArsaIndex > 0 and T("KATLA!") or T("BEKLE")

	if durum.KayitAcik then
		kayitYazi.Visible = false
	else
		kayitYazi.Visible = true
		kayitYazi.Text = RunService:IsStudio() and T("💾 Studio testinde kayıt kapalı (oyunu yayınlayınca açılır)")
			or T("💾 Kayıt yüklenemedi, bu seferki ilerlemen kaydedilmeyecek")
	end
	dukkanGuncelle()
end

----------------------------------------------------------------------
-- Eylemler
----------------------------------------------------------------------
local function katla()
	if not durum then
		return
	end
	if durum.ArsaIndex == 0 then
		duyuru(T("Bütün arsalar dolu!"), Color3.fromRGB(255, 150, 120), 1.5, T("Biri çıkınca dükkanın açılacak."))
		return
	end
	local simdi = os.clock()
	if simdi - sonKatlama < KATLAMA_ARALIGI then
		return
	end
	if simdi - sonKatlama < 0.9 then
		kombo += 1
	else
		kombo = 1
	end
	sonKatlama = simdi

	-- ekranı hemen güncelle (sunucunun cevabı gelince düzelir)
	durum.Asama += Ekonomi.TikBasinaKatlama(durum.Gelistirme)
	local hussNo = hussNumarasi(math.min(durum.Asama, Config.KatlamaSayisi)) -- bu basışın huss'ı
	if durum.Asama >= Config.KatlamaSayisi then
		durum.Asama = 0
		durum.ToplamPaket += 1
	end
	KatlaOlay:FireServer()
	if yarisma and simdi >= yarisma.Baslangic and simdi < yarisma.Bitis then
		yarisma.Sayac += 1
	end

	local hiz = 1 + math.min(kombo, 40) * 0.008
	hussCal(hiz, nil, hussNo) -- her basışta tek huss: burger başına 3 huss
	hussYazisi(1 + math.min(kombo, 30) * 0.01)
	zipla(katlaOlcek, 0.86)
	if kombo >= 3 then
		komboYazi.Visible = true
		komboYazi.Text = T("KOMBO x%d", kombo)
		zipla(komboOlcek, 1.25)
	end
	arayuzGuncelle()
end

katlaButonu.Activated:Connect(katla)
dukkanButonu.Activated:Connect(function()
	zipla(dukkanOlcek, 0.85)
	dukkanAcKapa()
end)
kapatButonu.Activated:Connect(function()
	dukkanAcKapa(false)
end)
sesButonu.Activated:Connect(function()
	sesAcik = not sesAcik
	sesButonu.Text = sesAcik and "🔊" or "🔇"
	if not sesAcik then
		for _, s in ipairs(sesHavuzu) do
			s:Stop()
		end
	end
end)
stilButonu.Activated:Connect(function()
	stilAcKapa(not stilPanel.Visible)
end)
evButonu.Activated:Connect(function()
	EvimeGitOlay:FireServer()
end)

ContextActionService:BindAction("BurgerKatla", function(_, girdi)
	if girdi == Enum.UserInputState.Begin then
		katla()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonR2)

ContextActionService:BindAction("BurgerDukkan", function(_, girdi)
	if girdi == Enum.UserInputState.Begin then
		dukkanAcKapa()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonY)

RunService.RenderStepped:Connect(function()
	if komboYazi.Visible and os.clock() - sonKatlama > 0.9 then
		komboYazi.Visible = false
		kombo = 0
	end
end)

----------------------------------------------------------------------
-- Sunucudan gelenler
----------------------------------------------------------------------
local ilkDurum = true
DurumOlay.OnClientEvent:Connect(function(yeni)
	local eski = durum
	durum = yeni
	hediyeHazirZamani = os.clock() + (yeni.HediyeKalan or 0)
	if eski then
		for _, g in ipairs(Config.Gelistirmeler) do
			local once = Ekonomi.Seviye(eski.Gelistirme, g.Anahtar)
			local simdi = Ekonomi.Seviye(yeni.Gelistirme, g.Anahtar)
			if simdi > once then
				duyuru(g.Ikon .. " " .. T(g.Ad) .. (g.MaxSeviye > 1 and (" " .. T("Sv") .. " " .. simdi) or "") .. "!", Color3.fromRGB(140, 255, 140), 1.4, Ekonomi.EtkiYazisi(g.Anahtar, simdi))
				local s = satirlar[g.Anahtar]
				if s then
					s.Satir.BackgroundColor3 = Color3.fromRGB(80, 170, 90)
					gecis(s.Satir, 0.5, { BackgroundColor3 = SATIR })
				end
			end
		end
		if yeni.Sube > eski.Sube then
			duyuru(T("🏙️ %d. ŞUBE AÇILDI!", yeni.Sube + 1), SARI, 2.6, T("Bütün paralar artık x%.1f", Ekonomi.SubeCarpani(yeni.Sube)))
			hussSerisi(1, 1.4)
		end
	end
	if ilkDurum then
		ilkDurum = false
		if yeni.ArsaIndex > 0 then
			PaketGorsel.Esitle(yeni.ArsaIndex, yeni.Asama, yeni.Altin)
		end
		if not yeni.StilVar then
			stilAcKapa(true)
		elseif yeni.ArsaIndex > 0 then
			duyuru(T("🍔 BURGER İMPARATORU 👑"), Color3.fromRGB(255, 215, 80), 2.4, T("KATLA'ya bas: 3 katlamada burger paketlenir!"))
		end
	end
	arayuzGuncelle()
end)

KatlandiOlay.OnClientEvent:Connect(function(kim, sira, asama, paketlendi, kazanc, altin, siradakiAltin, otomatik)
	PaketGorsel.Katla(sira, asama, paketlendi, altin, siradakiAltin)
	if otomatik then
		Musteriler.AsciKatladi(sira)
	end
	if kim == ben then
		if otomatik then
			-- aşçı katladı: kısık huss ve küçük yazı
			hussCal(rastgele:NextNumber(0.95, 1.05), Config.HussSesSeviyesi * 0.5, hussNumarasi(paketlendi and Config.KatlamaSayisi or asama))
			ucanYazi("👨‍🍳 HUSS!", SARI, 0.6, rastgele:NextInteger(-170, 170), rastgele:NextInteger(-205, -160))
		end
		if paketlendi then
			ucanYazi("📦 +" .. K(kazanc), Color3.fromRGB(140, 255, 120), 0.85, rastgele:NextInteger(-40, 40), -175)
			if altin then
				duyuru(T("✨ ALTIN BURGER! ✨"), SARI, 1.6, "+" .. K(kazanc) .. " 💰")
			end
		end
	else
		uzakHuss(arsaParcasi(sira, "AnaTezgahUst"), "k" .. tostring(sira), 0.15, hussNumarasi(paketlendi and Config.KatlamaSayisi or asama))
	end
end)

local sonMakineSesi = 0
UretimOlay.OnClientEvent:Connect(function(liste)
	if type(liste) ~= "table" then
		return
	end
	local benimki = durum and durum.ArsaIndex or 0
	for _, u in ipairs(liste) do
		local sira, makine, altin = u[1], u[2], u[3]
		PaketGorsel.Uretim(sira, makine, altin)
		if sira == benimki then
			local simdi = os.clock()
			if simdi - sonMakineSesi > 0.7 then
				sonMakineSesi = simdi
				hussCal(rastgele:NextNumber(1.05, 1.2), Config.MakineSesSeviyesi)
			end
		else
			uzakHuss(arsaParcasi(sira, "Makine" .. tostring(makine)), "m" .. tostring(sira), 1)
		end
	end
end)

UnvanOlay.OnClientEvent:Connect(function(kim, index)
	local u = Config.Unvanlar[index]
	if not u then
		return
	end
	if kim == ben then
		duyuru(T("👑 YENİ UNVAN: %s!", u.Ad), u.Renk, 2.4, T("Burger İmparatorluğuna bir adım daha!"))
		hussSerisi(1.1, 1.4)
	end
	if kim then
		sohbetMesaji(T("👑 %s artık %s!", kim.DisplayName, u.Ad))
	end
end)

NPCOlay.OnClientEvent:Connect(function(ne)
	if ne == "Gorev" then
		gorevGuncelle()
		gorevPenceresi.Visible = true
	end
end)

YarismaOlay.OnClientEvent:Connect(function(bilgi)
	if type(bilgi) ~= "table" then
		return
	end
	if bilgi.Durum == "basladi" then
		local simdi = os.clock()
		yarisma = { Baslangic = simdi + (bilgi.GeriSayim or 3), Bitis = simdi + (bilgi.GeriSayim or 3) + (bilgi.Sure or 15), Sayac = 0 }
		yarismaKutusu:SetAttribute("Sonuc", false)
		duyuru(T("⏱️ HUSS YARIŞMASI!"), SARI, 2, T("Rekorun: %d tık", bilgi.Rekor or 0))
	elseif bilgi.Durum == "bitti" then
		yarisma = nil
		yarismaKutusu.Visible = true
		yarismaKutusu:SetAttribute("Sonuc", true)
		yarismaUst.Text = T("🏁 %d TIK  •  +%s 💰", bilgi.Sayac or 0, K(bilgi.Odul or 0))
		yarismaAlt.Text = bilgi.YeniRekor and T("🏆 YENİ REKOR!") or T("Rekorun: %d tık", bilgi.Rekor or 0)
		hussSerisi(1.1, 1.3)
		task.delay(3.5, function()
			if not yarisma then
				yarismaKutusu:SetAttribute("Sonuc", false)
				yarismaKutusu.Visible = false
			end
		end)
	end
end)

DuyuruOlay.OnClientEvent:Connect(function(metin, ...)
	if type(metin) ~= "string" then
		return
	end
	local ok, cevrilmis = pcall(T, metin, ...)
	metin = ok and cevrilmis or metin
	duyuru(metin, Color3.fromRGB(255, 230, 150), 2.4)
	sohbetMesaji(metin)
end)

----------------------------------------------------------------------
-- Başlat
----------------------------------------------------------------------
task.spawn(function()
	Dil.DunyayiCevir(workspace) -- haritadaki tabelalar, NPC adları, dükkan yazıları
end)
task.spawn(function()
	Musteriler.Baslat(Config, Gorsel)
end)
task.spawn(function()
	KasabaHalki.Baslat(Config, Gorsel)
end)
PaketGorsel.SatisaGeldi = Musteriler.PaketGeldi
task.spawn(function()
	PaketGorsel.Baslat(Config, Gorsel)
	if durum and durum.ArsaIndex > 0 then
		PaketGorsel.Esitle(durum.ArsaIndex, durum.Asama, durum.Altin)
	end
end)

-- Ekran hazır: sunucudan güncel durumu iste
DurumIsteOlay:FireServer()

olcekGuncelle()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	olcekGuncelle()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(olcekGuncelle)
	end
end)
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(olcekGuncelle)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">KasabaHalki</string>
            <string name="Source"><![CDATA[-- BURGER İMPARATORU - Kasaba halkı (sadece bu oyuncunun ekranında)
-- Meydanda ve kaldırımlarda gezen, durup konuşan insanlar; heykelin önünde huss dansı yapanlar;
-- meydandaki NPC'lerin el sallaması.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Dil = require(game:GetService("ReplicatedStorage"):WaitForChild("Ortak"):WaitForChild("Dil"))

local KasabaHalki = {}

local Config, Gorsel
local klasor
local rastgele = Random.new()
local gezenler = {}
local dansedenler = {}
local npcKayit = setmetatable({}, { __mode = "k" })
local zaman = 0
local GORUS = 420

local GOMLEKLER = {
	Color3.fromRGB(230, 70, 70), Color3.fromRGB(70, 130, 230), Color3.fromRGB(250, 200, 60),
	Color3.fromRGB(90, 190, 110), Color3.fromRGB(170, 100, 220), Color3.fromRGB(245, 140, 60),
	Color3.fromRGB(240, 240, 240), Color3.fromRGB(240, 120, 170), Color3.fromRGB(60, 190, 190),
}
local PANTOLONLAR = { Color3.fromRGB(40, 60, 110), Color3.fromRGB(50, 50, 55), Color3.fromRGB(110, 85, 60), Color3.fromRGB(30, 90, 70) }
local YUZLER = { "🙂", "😀", "😋", "🤩", "😎", "🥳", "😊", "🤗", "😄", "😜" }

local function sec(liste)
	return liste[rastgele:NextInteger(1, #liste)]
end

-- Kare bir döngü üzerinde, d mesafesindeki nokta ve yön
local function karedeNokta(R, d, y)
	local L = 8 * R
	d = d % L
	local kenar = math.floor(d / (2 * R))
	local t = d - kenar * 2 * R
	if kenar == 0 then
		return Vector3.new(-R + t, y, -R), Vector3.new(1, 0, 0)
	elseif kenar == 1 then
		return Vector3.new(R, y, -R + t), Vector3.new(0, 0, 1)
	elseif kenar == 2 then
		return Vector3.new(R - t, y, R), Vector3.new(-1, 0, 0)
	else
		return Vector3.new(-R, y, R - t), Vector3.new(0, 0, -1)
	end
end

local function balonYap(bas)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(8, 0, 1.7, 0)
	bb.StudsOffset = Vector3.new(0, 2.3, 0)
	bb.MaxDistance = 70
	bb.LightInfluence = 0
	bb.Enabled = false
	bb.Parent = bas
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.Parent = bb
	local k = Instance.new("UICorner")
	k.CornerRadius = UDim.new(0.4, 0)
	k.Parent = f
	local t = Instance.new("TextLabel")
	t.Name = "Yazi"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(0.92, 0.8)
	t.Position = UDim2.fromScale(0.04, 0.1)
	t.TextScaled = true
	t.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	t.TextColor3 = Color3.fromRGB(45, 30, 20)
	t.Parent = f
	return bb, t
end

local function insanYap(cf)
	local insan = Gorsel.Insan(cf, {
		Gomlek = sec(GOMLEKLER),
		Pantolon = sec(PANTOLONLAR),
		Ten = sec(Gorsel.Tenler),
		Yuz = sec(YUZLER),
		Sapka = rastgele:NextNumber() < 0.35 and "kep" or nil,
		SapkaRenk = sec(GOMLEKLER),
	})
	for _, p in ipairs(insan.Liste) do
		p.CanQuery = false
		p.Parent = klasor
	end
	return insan
end

local function konus(kisi, metin, sure)
	kisi.BalonYazi.Text = metin
	kisi.Balon.Enabled = true
	kisi.BalonSure = sure or 3
end

local function guncelle(dt)
	zaman += dt
	local kamera = Workspace.CurrentCamera
	local kameraYeri = kamera and kamera.CFrame.Position or Vector3.zero
	if kameraYeri.Magnitude > GORUS then
		return -- meydandan uzaktayken kimseyi oynatma
	end

	for _, g in ipairs(gezenler) do
		-- konuşma balonu
		if g.BalonSure then
			g.BalonSure -= dt
			if g.BalonSure <= 0 then
				g.BalonSure = nil
				g.Balon.Enabled = false
			end
		end
		g.Konus -= dt
		if g.Konus <= 0 then
			g.Konus = rastgele:NextNumber(7, 16)
			g.Durak = rastgele:NextNumber(1.5, 3)
			konus(g, Dil.T(sec(Config.KasabaSozleri)), 3)
		end
		local yurudu = false
		if g.Durak and g.Durak > 0 then
			g.Durak -= dt
		else
			g.D += g.Yon * g.Hiz * dt
			g.Faz += dt * 10
			yurudu = true
		end
		local p, ileri = karedeNokta(g.R, g.D, g.Y)
		ileri *= g.Yon
		local cf = CFrame.lookAt(p, p + ileri)
		Gorsel.InsanTasi(g.Insan, cf, yurudu and math.sin(g.Faz) * 0.6 or 0, false)
	end

	-- huss dansı: kollar yukarı aşağı, hafif zıplama
	for i, d in ipairs(dansedenler) do
		local vurus = zaman * 4.2 + i * 0.7
		local yukari = math.abs(math.sin(vurus))
		local cf = d.Cf * CFrame.new(0, yukari * 0.45, 0) * CFrame.Angles(0, math.sin(zaman * 1.3 + i) * 0.25, 0)
		Gorsel.InsanTasi(d.Insan, cf, 0, false, math.rad(150) * yukari + 0.2)
		if d.BalonSure then
			d.BalonSure -= dt
			if d.BalonSure <= 0 then
				d.BalonSure = nil
				d.Balon.Enabled = false
			end
		end
		d.Konus -= dt
		if d.Konus <= 0 then
			d.Konus = rastgele:NextNumber(5, 11)
			konus(d, "HUSS! HUSS! HUSS!", 2)
		end
	end

	-- meydandaki NPC'ler arada el sallar
	local harita = Workspace:FindFirstChild("Harita")
	local npcler = harita and harita:FindFirstChild("NPCler")
	if npcler then
		for i, m in ipairs(npcler:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Rol") == "NPC" then
				local k = npcKayit[m]
				if not k then
					local govde = m:FindFirstChild("Govde")
					if govde then
						k = { Taban = govde.CFrame * CFrame.new(0, -3, 0), Sag = m:FindFirstChild("SagKol") }
						npcKayit[m] = k
					end
				end
				if k and k.Sag then
					local dongu = (zaman + i * 1.7) % 5
					local aci = 0
					if dongu < 1.2 then
						aci = math.rad(165) + math.sin(zaman * 14) * 0.35
					end
					local omuz = k.Taban * CFrame.new(0, 3.8, 0)
					k.Sag.CFrame = omuz * CFrame.new(1.5, 0, 0) * CFrame.Angles(aci, 0, 0) * CFrame.new(0, -0.8, 0)
				end
			end
		end
	end
end

function KasabaHalki.Baslat(config, gorsel)
	Config = config
	Gorsel = gorsel
	klasor = Instance.new("Folder")
	klasor.Name = "KasabaHalki"
	klasor.Parent = Workspace

	-- gezenler: yarısı meydanda, yarısı kaldırımda
	for i = 1, Config.KasabaHalkiSayisi do
		local meydanda = i % 2 == 0
		local R = meydanda and rastgele:NextNumber(45, 49) or rastgele:NextNumber(85, 87)
		local g = {
			R = R,
			Y = meydanda and 0.4 or 0.5,
			D = rastgele:NextNumber(0, 8 * R),
			Yon = rastgele:NextNumber() < 0.5 and -1 or 1,
			Hiz = rastgele:NextNumber(4, 7),
			Faz = rastgele:NextNumber(0, 6),
			Konus = rastgele:NextNumber(1, 12),
		}
		local p = karedeNokta(g.R, g.D, g.Y)
		g.Insan = insanYap(CFrame.new(p))
		g.Balon, g.BalonYazi = balonYap(g.Insan.Bas)
		table.insert(gezenler, g)
	end

	-- dans edenler: heykelin önünde halka
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local p = Vector3.new(math.cos(a) * 13, 0.4, math.sin(a) * 13)
		local cf = CFrame.lookAt(p, p + Vector3.new(math.cos(a), 0, math.sin(a)))
		local d = { Cf = cf, Insan = insanYap(cf), Konus = rastgele:NextNumber(0, 6) }
		d.Balon, d.BalonYazi = balonYap(d.Insan.Bas)
		table.insert(dansedenler, d)
	end

	RunService.RenderStepped:Connect(guncelle)
end

return KasabaHalki
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Musteriler</string>
            <string name="Source"><![CDATA[-- BURGER İMPARATORU - Müşteriler ve çalışanların hareketleri (sadece bu oyuncunun ekranında)
-- Müşteriler kaldırımdan gelir, satış penceresinde sıraya girer, paketini alıp kucağında taşır,
-- masa varsa bazen oturup yer, sonra gider. Dükkanın ünü ve makineleri arttıkça daha sık gelirler.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Musteriler = {}

local Config, Gorsel, Y
local klasor
local arsalar = {}
local rastgele = Random.new()
local GORUS = 230 -- bundan uzaktaki dükkanlara müşteri gönderme

local GOMLEKLER = {
	Color3.fromRGB(230, 70, 70), Color3.fromRGB(70, 130, 230), Color3.fromRGB(250, 200, 60),
	Color3.fromRGB(90, 190, 110), Color3.fromRGB(170, 100, 220), Color3.fromRGB(245, 140, 60),
	Color3.fromRGB(240, 240, 240), Color3.fromRGB(60, 60, 70), Color3.fromRGB(240, 120, 170),
}
local PANTOLONLAR = {
	Color3.fromRGB(40, 60, 110), Color3.fromRGB(50, 50, 55), Color3.fromRGB(110, 85, 60),
	Color3.fromRGB(80, 80, 90), Color3.fromRGB(30, 90, 70),
}
local YUZLER = { "🙂", "😀", "😋", "🤩", "😎", "🥳", "😊", "🤗", "😄" }

local function cerceve(st)
	local taban = st.Model:FindFirstChild("Taban")
	if not taban then
		return nil
	end
	return taban.CFrame * CFrame.new(0, taban.Size.Y / 2, 0)
end

local function sahipli(st)
	local s = st.Model:GetAttribute("Sahip")
	return type(s) == "number" and s ~= 0
end

local function sec(liste)
	return liste[rastgele:NextInteger(1, #liste)]
end

local function musteriyiSil(m)
	for _, p in ipairs(m.Insan.Liste) do
		p:Destroy()
	end
	if m.Paket then
		for _, p in ipairs(m.Paket) do
			p:Destroy()
		end
	end
	m.Silindi = true
end

local function listedenCikar(liste, x)
	for i, v in ipairs(liste) do
		if v == x then
			table.remove(liste, i)
			return
		end
	end
end

local function kuyrukYeri(st, F, n)
	local s = Y.SatisNoktasi
	return F * Vector3.new(s.X, 0, s.Z - 4 - (n - 1) * Y.KuyrukAralik)
end

local function koltuklar(F)
	local liste = {}
	for _, masa in ipairs(Y.Masalar) do
		for k = 0, 3 do
			local a = k * math.pi / 2 + math.rad(45)
			local yer = F * (CFrame.new(masa.X, 0, masa.Z) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.6, 3.4))
			local masaMerkez = F * Vector3.new(masa.X, 0.6, masa.Z)
			table.insert(liste, CFrame.lookAt(yer.Position, Vector3.new(masaMerkez.X, yer.Position.Y, masaMerkez.Z)))
		end
	end
	return liste
end

local function musteriYap(st, F)
	local giris = Y.MusteriGiris
	local sx = rastgele:NextNumber(-Y.ArsaBoyu.X * 0.4, Y.ArsaBoyu.X * 0.46)
	local m = {
		Arsa = st,
		Konum = F * Vector3.new(sx, 0, giris),
		Faz = rastgele:NextNumber(0, 6),
		Durum = "geliyor",
		Yol = { F * Vector3.new(Y.SatisNoktasi.X + rastgele:NextNumber(-4, 4), 0, Y.SatisNoktasi.Z - 11.5) },
	}
	m.Insan = Gorsel.Insan(CFrame.new(m.Konum), {
		Gomlek = sec(GOMLEKLER),
		Pantolon = sec(PANTOLONLAR),
		Ten = sec(Gorsel.Tenler),
		Yuz = sec(YUZLER),
		Sapka = rastgele:NextNumber() < 0.35 and "kep" or nil,
		SapkaRenk = sec(GOMLEKLER),
	})
	for _, p in ipairs(m.Insan.Liste) do
		p.CanQuery = false
		p.Parent = klasor
	end
	table.insert(st.Liste, m)
	table.insert(st.Kuyruk, m)
end

-- Müşteri paketini alır
local function servisEt(st, m, stil)
	if m.Durum ~= "sirada" and m.Durum ~= "geliyor" then
		return
	end
	listedenCikar(st.Kuyruk, m)
	m.Durum = "aliyor"
	m.Bekle = 0.5
	m.Paket = Gorsel.KapaliKutu(CFrame.new(m.Konum), stil or {
		Renk = st.Model:GetAttribute("Renk") or Color3.fromRGB(220, 55, 50),
		Logo = st.Model:GetAttribute("Logo") or "🍔",
		Altin = false,
	}, 0.3)
	for _, p in ipairs(m.Paket) do
		p.CanQuery = false
		p.Parent = klasor
	end
	st.KasiyerSelam = 0.6
end

-- Bantta gelen bir paket satış penceresine ulaştı: sıradaki ilk müşteri alsın
function Musteriler.PaketGeldi(sira, stil)
	local st = arsalar[sira]
	if not st then
		return
	end
	local ilk = st.Kuyruk[1]
	if ilk and ilk.Durum == "sirada" then
		servisEt(st, ilk, stil)
	end
end

-- Aşçı tezgahta katladı: kolları hareket etsin
function Musteriler.AsciKatladi(sira)
	local st = arsalar[sira]
	if st then
		st.AsciHareket = 0.35
	end
end

local function cikisYolu(F, m)
	local s = Y.SatisNoktasi
	local yon = rastgele:NextNumber() < 0.5 and -1 or 1
	return {
		F * Vector3.new(s.X + 6, 0, s.Z - 11.5),
		F * Vector3.new(s.X + 8, 0, Y.MusteriGiris),
		F * Vector3.new(yon * (Y.ArsaBoyu.X / 2 + 13), 0, Y.MusteriGiris),
	}
end

local function yuru(m, hedef, dt)
	local fark = hedef - m.Konum
	fark = Vector3.new(fark.X, 0, fark.Z)
	local mesafe = fark.Magnitude
	local adim = Config.Musteri.Hiz * dt
	if mesafe <= adim or mesafe < 0.05 then
		m.Konum = Vector3.new(hedef.X, m.Konum.Y, hedef.Z)
		return true
	end
	local yon = fark.Unit
	m.Konum += yon * adim
	m.Yon = yon
	m.Faz += dt * 11
	return false
end

local function guncelle(dt)
	local kamera = Workspace.CurrentCamera
	local kameraYeri = kamera and kamera.CFrame.Position or Vector3.zero
	for _, st in pairs(arsalar) do
		local F = cerceve(st)
		if F then
			local yakin = (F.Position - kameraYeri).Magnitude < GORUS
			local acik = sahipli(st)

			-- yeni müşteri
			if acik and yakin then
				st.Sayac -= dt
				if st.Sayac <= 0 then
					local un = st.Model:GetAttribute("Un") or 1
					local makine = st.Model:GetAttribute("Makine") or 0
					local aralik = math.max(Config.Musteri.EnKisaAralik, Config.Musteri.TemelAralik / (un * (1 + makine * 0.35)))
					st.Sayac = aralik * rastgele:NextNumber(0.7, 1.3)
					if #st.Liste < Config.Musteri.EnFazla then
						musteriYap(st, F)
					end
				end
			elseif not acik and #st.Liste > 0 then
				for _, m in ipairs(st.Liste) do
					musteriyiSil(m)
				end
				st.Liste = {}
				st.Kuyruk = {}
				st.Koltuk = {}
			end

			-- müşterileri yürüt
			for i = #st.Liste, 1, -1 do
				local m = st.Liste[i]
				local yurudu = false
				if m.Durum == "geliyor" or m.Durum == "sirada" then
					local sira = table.find(st.Kuyruk, m) or 1
					local hedef
					if #m.Yol > 0 then
						hedef = m.Yol[1]
					else
						hedef = kuyrukYeri(st, F, sira)
					end
					local vardi = yuru(m, hedef, dt)
					yurudu = not vardi
					if vardi then
						if #m.Yol > 0 then
							table.remove(m.Yol, 1)
						else
							if m.Durum == "geliyor" then
								m.Durum = "sirada"
								m.Bekle = rastgele:NextNumber(1.5, 3.5)
							end
							m.Yon = (F * Vector3.new(0, 0, 1) - F.Position).Unit -- pencereye bak
							if sira == 1 then
								m.Bekle -= dt
								if m.Bekle <= 0 then
									servisEt(st, m, nil)
								end
							end
						end
					end
				elseif m.Durum == "aliyor" then
					m.Bekle -= dt
					if m.Bekle <= 0 then
						-- masa varsa bazen oturup yesin
						if st.Model:GetAttribute("Oturma") and rastgele:NextNumber() < 0.4 then
							local liste = koltuklar(F)
							for k, cf in ipairs(liste) do
								if not st.Koltuk[k] then
									st.Koltuk[k] = m
									m.Koltuk = k
									m.KoltukCf = cf
									m.Yol = { cf.Position - Vector3.new(0, cf.Position.Y - m.Konum.Y, 0) }
									m.Durum = "masaya"
									break
								end
							end
						end
						if m.Durum == "aliyor" then
							m.Durum = "gidiyor"
							m.Yol = cikisYolu(F, m)
						end
					end
				elseif m.Durum == "masaya" then
					if yuru(m, m.Yol[1], dt) then
						m.Durum = "oturuyor"
						m.Bekle = rastgele:NextNumber(4, 8)
					else
						yurudu = true
					end
				elseif m.Durum == "oturuyor" then
					m.Bekle -= dt
					if m.Bekle <= 0 then
						st.Koltuk[m.Koltuk] = nil
						m.Durum = "gidiyor"
						m.Yol = cikisYolu(F, m)
					end
				elseif m.Durum == "gidiyor" then
					if #m.Yol == 0 or yuru(m, m.Yol[1], dt) then
						if #m.Yol > 0 then
							table.remove(m.Yol, 1)
						end
						if #m.Yol == 0 then
							musteriyiSil(m)
							table.remove(st.Liste, i)
						end
					else
						yurudu = true
					end
				end

				if not m.Silindi then
					local yon = m.Yon or Vector3.new(0, 0, -1)
					local oturuyor = m.Durum == "oturuyor"
					local cf
					if oturuyor then
						cf = m.KoltukCf
					else
						cf = CFrame.lookAt(m.Konum, m.Konum + yon)
					end
					local salinim = yurudu and math.sin(m.Faz) * 0.6 or 0
					local tasiyor = m.Paket ~= nil and not oturuyor
					Gorsel.InsanTasi(m.Insan, cf, salinim, oturuyor, tasiyor and 1.25 or nil)
					if m.Paket then
						local kutuCf
						if oturuyor then
							-- paket masada
							local masaYonu = cf.LookVector
							kutuCf = CFrame.new(cf.Position + masaYonu * 1.6 + Vector3.new(0, 2.23, 0)) * (cf - cf.Position)
						else
							kutuCf = cf * CFrame.new(0, 2.55, -1.15)
						end
						local bas = m.Paket[1]
						local goreli = m.PaketGoreli
						if not goreli then
							goreli = {}
							for _, p in ipairs(m.Paket) do
								goreli[p] = bas.CFrame:ToObjectSpace(p.CFrame)
							end
							m.PaketGoreli = goreli
							m.PaketTabanFarki = bas.CFrame.Position.Y - m.Konum.Y
						end
						local tepsiCf = kutuCf * CFrame.new(0, m.PaketTabanFarki, 0)
						for _, p in ipairs(m.Paket) do
							p.CFrame = tepsiCf * goreli[p]
						end
					end
				end
			end

			-- çalışanlar: hafif kıpırdanma; aşçı katlarken, kasiyer müşteri alırken el sallar
			if yakin then
				st.ZamanCalisan = (st.ZamanCalisan or 0) + dt
				if st.AsciHareket then
					st.AsciHareket -= dt
					if st.AsciHareket <= 0 then
						st.AsciHareket = nil
					end
				end
				if st.KasiyerSelam then
					st.KasiyerSelam -= dt
					if st.KasiyerSelam <= 0 then
						st.KasiyerSelam = nil
					end
				end
				local dukkan = st.Model:FindFirstChild("Dukkan")
				if dukkan then
					for _, c in ipairs(dukkan:GetChildren()) do
						local rol = c:IsA("Model") and c:GetAttribute("Rol")
						if rol then
							local kayit = st.Calisanlar[c]
							if not kayit then
								local govde = c:FindFirstChild("Govde")
								if govde then
									kayit = {
										Taban = govde.CFrame * CFrame.new(0, -3, 0),
										SolKol = c:FindFirstChild("SolKol"),
										SagKol = c:FindFirstChild("SagKol"),
									}
									st.Calisanlar[c] = kayit
								end
							end
							if kayit and kayit.SolKol and kayit.SagKol then
								local t = st.ZamanCalisan
								local sol, sag
								if rol == "Asci" and st.AsciHareket then
									sol, sag = 1.2 + math.sin(t * 30) * 0.3, 1.2 - math.sin(t * 30) * 0.3
								elseif rol == "Kasiyer" and st.KasiyerSelam then
									sol, sag = 0.1, math.rad(170) + math.sin(t * 20) * 0.3
								elseif rol == "Temizlikci" then
									sol, sag = 0.9 + math.sin(t * 4) * 0.4, 0.9 + math.sin(t * 4) * 0.4
								else
									local k = math.sin(t * 2 + #rol) * 0.08
									sol, sag = k, -k
								end
								local omuz = kayit.Taban * CFrame.new(0, 3.8, 0)
								kayit.SolKol.CFrame = omuz * CFrame.new(-1.5, 0, 0) * CFrame.Angles(sol, 0, 0) * CFrame.new(0, -0.8, 0)
								kayit.SagKol.CFrame = omuz * CFrame.new(1.5, 0, 0) * CFrame.Angles(sag, 0, 0) * CFrame.new(0, -0.8, 0)
							end
						end
					end
				end
			end
		end
	end
end

function Musteriler.Baslat(config, gorsel)
	Config = config
	Gorsel = gorsel
	Y = Config.Yerlesim
	klasor = Instance.new("Folder")
	klasor.Name = "Musteriler"
	klasor.Parent = Workspace
	local harita = Workspace:WaitForChild("Harita")
	local arsaKlasoru = harita:WaitForChild("Arsalar")
	for i = 1, Config.ArsaSayisi do
		local model = arsaKlasoru:WaitForChild("Arsa" .. i, 10)
		if model then
			arsalar[i] = {
				Model = model,
				Liste = {},
				Kuyruk = {},
				Koltuk = {},
				Sayac = rastgele:NextNumber(0.5, 3),
				Calisanlar = setmetatable({}, { __mode = "k" }),
			}
		end
	end
	RunService.RenderStepped:Connect(guncelle)
end

return Musteriler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PaketGorsel</string>
            <string name="Source"><![CDATA[-- BURGER İMPARATORU - Kutu görselleri (sadece bu oyuncunun ekranında)
-- Tezgahtaki kutunun katlanması, paketin banttan satış penceresine gitmesi,
-- makinelerin presi ve bantta akan kutular. Sunucu sadece "şu oldu" der, çizimi burası yapar.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local PaketGorsel = {}

local Config, Gorsel
local Y
local klasor
local arsalar = {} -- sıra -> durum
local EN_FAZLA_BANTTA = 22 -- bir dükkanın bantlarında aynı anda en fazla kaç kutu görünsün
local GORUS_UZAKLIGI = 260 -- bundan uzaktaki dükkanların makine kutularını çizme

local KATLAMA = TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local DUSME = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function cerceve(st)
	local taban = st.Model:FindFirstChild("Taban")
	if not taban then
		return nil
	end
	return taban.CFrame * CFrame.new(0, taban.Size.Y / 2, 0)
end

local function stilOku(st, altin)
	return {
		Renk = st.Model:GetAttribute("Renk") or Color3.fromRGB(220, 55, 50),
		Logo = st.Model:GetAttribute("Logo") or "🍔",
		Altin = altin,
	}
end

local function sahipli(st)
	local s = st.Model:GetAttribute("Sahip")
	return type(s) == "number" and s ~= 0
end

local function kutuTabani(st)
	local F = cerceve(st)
	if not F then
		return nil
	end
	local a = Y.AnaTezgah
	return F * CFrame.new(a.X, Y.TezgahYuksekligi, a.Z)
end

local function temizle(st)
	if st.Kutu then
		for _, p in pairs(st.Kutu) do
			p:Destroy()
		end
	end
	if st.Burger then
		for _, p in ipairs(st.Burger) do
			p:Destroy()
		end
	end
	st.Kutu = nil
	st.Burger = nil
end

-- Tezgaha yeni açık kutu (ve içinde burger) koyar
local function yeniKutu(st, altin, asama, gecikme)
	temizle(st)
	if not sahipli(st) then
		return
	end
	local taban = kutuTabani(st)
	if not taban then
		return
	end
	asama = asama or 0
	st.Asama = asama
	st.Altin = altin and true or false
	local o = Config.BurgerOlcegi
	local kutu = Gorsel.KutuYap(taban, stilOku(st, st.Altin), o)
	local poz = Gorsel.KutuPozu(taban, asama, o)
	local burger = Gorsel.Burger(taban * CFrame.new(0, Gorsel.KartonKalinligi * o, 0), o, st.Altin, false)
	local hepsi = {}
	for ad, p in pairs(kutu) do
		p.CFrame = poz[ad]
		table.insert(hepsi, p)
	end
	for _, p in ipairs(burger) do
		table.insert(hepsi, p)
	end
	local bilgi = gecikme and TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, gecikme) or DUSME
	for _, p in ipairs(hepsi) do
		local hedef = p.CFrame
		p.CFrame = hedef + Vector3.new(0, 5, 0)
		p.Parent = klasor
		TweenService:Create(p, bilgi, { CFrame = hedef }):Play()
	end
	st.Kutu = kutu
	st.Burger = burger
end

-- Parçaları bir yoldan geçirir (her noktaya sırayla), sonra yok eder.
-- basTaban: kutunun şu anki alt yüzü; noktalar: kutunun alt yüzünün gideceği yerler
local function yoldanGotur(parcalar, basTaban, noktalar, hiz, bitince)
	if #parcalar == 0 then
		return
	end
	local goreli = {}
	for _, p in ipairs(parcalar) do
		goreli[p] = basTaban:ToObjectSpace(p.CFrame)
	end
	task.spawn(function()
		local simdiki = basTaban
		for _, hedefCf in ipairs(noktalar) do
			local mesafe = (hedefCf.Position - simdiki.Position).Magnitude
			local sure = math.max(0.05, mesafe / hiz)
			local bilgi = TweenInfo.new(sure, Enum.EasingStyle.Linear)
			for _, p in ipairs(parcalar) do
				if p.Parent then
					TweenService:Create(p, bilgi, { CFrame = hedefCf * goreli[p] }):Play()
				end
			end
			task.wait(sure)
			simdiki = hedefCf
		end
		-- satış penceresinde küçülüp kaybolsun
		for _, p in ipairs(parcalar) do
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(0.15), { Size = p.Size * 0.2, Transparency = 1 }):Play()
			end
		end
		task.wait(0.16)
		for _, p in ipairs(parcalar) do
			p:Destroy()
		end
		if bitince then
			bitince()
		end
	end)
end

local function satisNoktasi(F)
	local s = Y.SatisNoktasi
	return F * CFrame.new(s.X, Y.TezgahYuksekligi, s.Z)
end

----------------------------------------------------------------------
-- Dışarıya açık fonksiyonlar
----------------------------------------------------------------------

-- KATLA: kutuyu yeni aşamaya katlar; paketlendiyse paketi banda koyup yeni kutu getirir
function PaketGorsel.Katla(sira, asama, paketlendi, altin, siradakiAltin)
	local st = arsalar[sira]
	if not st or not sahipli(st) then
		return
	end
	if not st.Kutu or st.Altin ~= (altin and true or false) then
		yeniKutu(st, altin, math.max(0, asama - 1))
	end
	local taban = kutuTabani(st)
	if not taban or not st.Kutu then
		return
	end
	local poz = Gorsel.KutuPozu(taban, asama, Config.BurgerOlcegi)
	for ad, p in pairs(st.Kutu) do
		TweenService:Create(p, KATLAMA, { CFrame = poz[ad] }):Play()
	end
	st.Asama = asama
	if not paketlendi then
		return
	end

	-- Kapak kapandı: açık kutuyu kapalı pakete çevir, bantta satış penceresine gönder
	local eskiKutu, eskiBurger = st.Kutu, st.Burger
	st.Kutu, st.Burger = nil, nil
	local stil = stilOku(st, altin)
	task.delay(0.2, function()
		for _, p in pairs(eskiKutu) do
			p:Destroy()
		end
		for _, p in ipairs(eskiBurger) do
			p:Destroy()
		end
		local F = cerceve(st)
		if not F or not sahipli(st) then
			return
		end
		local paket = Gorsel.KapaliKutu(taban, stil, Config.BurgerOlcegi)
		for _, p in ipairs(paket) do
			p.Parent = klasor
		end
		yoldanGotur(paket, taban, { satisNoktasi(F) }, 18, function()
			if PaketGorsel.SatisaGeldi then
				PaketGorsel.SatisaGeldi(sira, stil)
			end
		end)
	end)
	yeniKutu(st, siradakiAltin, 0, 0.3)
end

-- Kutu doğru stilde/aşamada mı? Değilse düzelt (ör. sunucudan gelen durumla eşitle)
function PaketGorsel.Esitle(sira, asama, altin)
	local st = arsalar[sira]
	if not st or not sahipli(st) then
		return
	end
	if not st.Kutu or st.Altin ~= (altin and true or false) or st.Asama ~= asama then
		yeniKutu(st, altin, asama)
	end
end

-- Makine bir paket yaptı
function PaketGorsel.Uretim(sira, makine, altin)
	local st = arsalar[sira]
	if not st or not sahipli(st) then
		return
	end
	if (st.Model:GetAttribute("Makine") or 0) < makine then
		return
	end
	local F = cerceve(st)
	if not F then
		return
	end
	local kamera = Workspace.CurrentCamera
	if kamera and (kamera.CFrame.Position - F.Position).Magnitude > GORUS_UZAKLIGI then
		return
	end

	-- pres aşağı inip kalksın
	local dukkan = st.Model:FindFirstChild("Dukkan")
	local m = dukkan and dukkan:FindFirstChild("Makine" .. makine)
	local kol = m and m:FindFirstChild("Kol")
	if kol and not st.PresCalisiyor[makine] then
		st.PresCalisiyor[makine] = true
		local ust = kol.CFrame
		local alt = ust - Vector3.new(0, 1.3, 0)
		local inis = TweenService:Create(kol, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = alt })
		inis:Play()
		inis.Completed:Connect(function()
			if not kol.Parent then
				st.PresCalisiyor[makine] = false -- bu arada dükkan yeniden kuruldu
				return
			end
			local kalkis = TweenService:Create(kol, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = ust })
			kalkis:Play()
			kalkis.Completed:Connect(function()
				st.PresCalisiyor[makine] = false
			end)
		end)
	end

	if st.Bantta >= EN_FAZLA_BANTTA then
		return
	end
	st.Bantta += 1
	local x = Y.MakineX[makine]
	local tepe = Y.TezgahYuksekligi
	local bas = F * CFrame.new(x, tepe, Y.MakineZ - 0.4)
	local paket = Gorsel.KapaliKutu(bas, stilOku(st, altin), Config.BantKutuOlcegi)
	for _, p in ipairs(paket) do
		p.Parent = klasor
	end
	local noktalar = {
		F * CFrame.new(x, tepe, Y.BantZ),
		F * CFrame.new(Y.BantX, tepe, Y.BantZ),
		satisNoktasi(F),
	}
	local stil = stilOku(st, altin)
	yoldanGotur(paket, bas, noktalar, 11, function()
		st.Bantta -= 1
		if PaketGorsel.SatisaGeldi then
			PaketGorsel.SatisaGeldi(sira, stil)
		end
	end)
end

function PaketGorsel.Baslat(config, gorsel)
	Config = config
	Gorsel = gorsel
	Y = Config.Yerlesim
	klasor = Instance.new("Folder")
	klasor.Name = "BurgerGorselleri"
	klasor.Parent = Workspace

	local harita = Workspace:WaitForChild("Harita")
	local arsaKlasoru = harita:WaitForChild("Arsalar")
	for i = 1, Config.ArsaSayisi do
		local model = arsaKlasoru:WaitForChild("Arsa" .. i, 10)
		if model then
			local st = { Sira = i, Model = model, Asama = 0, Altin = false, Bantta = 0, PresCalisiyor = {} }
			arsalar[i] = st
			local function yenile()
				if sahipli(st) then
					yeniKutu(st, st.Altin, st.Asama)
				else
					temizle(st)
				end
			end
			model:GetAttributeChangedSignal("Sahip"):Connect(function()
				st.Asama = 0
				st.Altin = false
				yenile()
			end)
			model:GetAttributeChangedSignal("Renk"):Connect(yenile)
			model:GetAttributeChangedSignal("Logo"):Connect(yenile)
			yenile()
		end
	end
end

return PaketGorsel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
